{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scolia-pro-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "relay.jp-services.org",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SCOLIA_ROOMS", "class_name": "ScoliaRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScoliaRoom"] }],
  "observability": { "enabled": true }
}

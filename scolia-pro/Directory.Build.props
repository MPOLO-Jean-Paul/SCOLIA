<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1716;CA1711;CA1304;CA1305;CA1307;CA1309;CA1310;CA1311;CA1862;CA1860;CA1031;CA2007;CA1819;CA1056;CA1054;CA1002;CA1822;CA1852;CA1805;CA1861;CA1308;CA1032;CA1064;CA1724;CA1050;CA2227;CA1515;CA1062;CA1812;CA1859;CA1873;CA1725</NoWarn>
    <Deterministic>true</Deterministic>
    <Company>SCOLIA</Company>
    <Product>SCOLIA Pro</Product>
    <Version>1.1.0</Version>
    <Copyright>SCOLIA</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>

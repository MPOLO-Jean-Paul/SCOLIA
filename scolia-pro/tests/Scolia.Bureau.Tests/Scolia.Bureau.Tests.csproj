<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests de la logique du client natif : montants, dates, requêtes, validation des formulaires.
       Aucune fenêtre n'est ouverte : ces tests tournent sur n'importe quel système. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1001;CA2000;CA1063;CA1816;CA2234</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Scolia.Bureau\Scolia.Bureau.csproj" />
  </ItemGroup>
</Project>

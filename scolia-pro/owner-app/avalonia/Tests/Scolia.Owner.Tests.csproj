<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests de SCOLIA Console : client de l'API propriétaire, coffre chiffré, libellés, et rendu hors écran
       de chaque page, et du vrai Worker sur SQLite local (aucun appel de production). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1001;CA2000;CA1063;CA1816;CA2234;CA1707;CA1515;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Scolia.Owner.Core.csproj" />
  </ItemGroup>
</Project>

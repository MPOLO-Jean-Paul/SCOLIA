<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.2.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia"/>
    <PackageReference Include="Avalonia.Themes.Fluent"/>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Scolia.Owner.Tests" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/scolia.png" />
    <AvaloniaResource Include="../../../src/Scolia.Bureau/Assets/Fonts/Inter-*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../../src/Scolia.Bureau/Assets/Fonts/OFL-Inter.txt" Link="Assets/Fonts/OFL-Inter.txt" />
    <AvaloniaResource Include="../../../src/Scolia.Bureau/Assets/FluentSystem/NOTICE.txt" Link="Assets/FluentSystem/NOTICE.txt" />
    <AvaloniaResource Include="../../../src/Scolia.Bureau/Assets/FluentSystem/manifest.json" Link="Assets/FluentSystem/manifest.json" />
    <AvaloniaXaml Include="../../../src/Scolia.Bureau/Themes/FluentArtwork.axaml" Link="Themes/FluentArtwork.axaml" />
  </ItemGroup>
</Project>

<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <FontFamily x:Key="OwnerFont">avares://Scolia.Owner.Core/Assets/Fonts#Inter</FontFamily>
  </Styles.Resources>
  <Style Selector=":is(TemplatedControl)">
    <Setter Property="FontFamily" Value="{StaticResource OwnerFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector=":is(TextBlock)">
    <Setter Property="FontFamily" Value="{StaticResource OwnerFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.ownerbody"><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="21" /></Style>
  <Style Selector="TextBlock.ownerdetail"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" /></Style>
  <Style Selector=":is(UserControl).compact TextBlock.ownerbody"><Setter Property="FontSize" Value="15" /><Setter Property="LineHeight" Value="22" /></Style>
  <Style Selector=":is(UserControl).compact TextBlock.ownerdetail"><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="19" /></Style>
  <Style Selector="Button.ownercmd">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl).compact Button.ownercmd"><Setter Property="MinHeight" Value="48" /><Setter Property="CornerRadius" Value="10" /></Style>
  <Style Selector="Button.ownercmd TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="CornerRadius" Value="8" /><Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector=":is(UserControl).compact TextBox, :is(UserControl).compact ComboBox">
    <Setter Property="CornerRadius" Value="10" /><Setter Property="MinHeight" Value="48" /><Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement"><Setter Property="CornerRadius" Value="8" /></Style>
  <Style Selector=":is(UserControl).compact TextBox /template/ Border#PART_BorderElement"><Setter Property="CornerRadius" Value="10" /></Style>
  <Style Selector="ScrollViewer"><Setter Property="IsScrollInertiaEnabled" Value="True" /></Style>
  <Style Selector="Border.ownercard"><Setter Property="CornerRadius" Value="12" /></Style>
  <Style Selector=":is(UserControl).compact Border.ownercard"><Setter Property="CornerRadius" Value="16" /></Style>
  <Style Selector="Button.ownerrow, Button.ownermetriccard"><Setter Property="CornerRadius" Value="12" /></Style>
  <Style Selector=":is(UserControl).compact Button.ownerrow, :is(UserControl).compact Button.ownermetriccard"><Setter Property="CornerRadius" Value="16" /></Style>
  <Style Selector="TextBlock.ownermetric"><Setter Property="FontSize" Value="24" /></Style>
  <Style Selector=":is(UserControl).compact TextBlock.ownermetric"><Setter Property="FontSize" Value="22" /></Style>
  <Style Selector=":is(UserControl).compact TextBlock.ownerduplicate"><Setter Property="IsVisible" Value="False" /></Style>
</Styles>

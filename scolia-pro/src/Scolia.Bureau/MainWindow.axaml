<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Scolia.Bureau.Views"
        x:Class="Scolia.Bureau.MainWindow"
        Title="SCOLIA Pro"
        Width="1280" Height="820" MinWidth="760" MinHeight="520">
  <!-- L'interface est la même sur l'ordinateur et sur le téléphone : la fenêtre ne fait que l'accueillir. -->
  <views:MainView x:Name="View" />
</Window>

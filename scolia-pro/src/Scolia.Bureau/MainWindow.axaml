<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Scolia.Bureau.ViewModels"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="Scolia.Bureau.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="SCOLIA"
        Width="1280" Height="820" MinWidth="980" MinHeight="620"
        KeyDown="OnKeyDown">
  <Grid>
    <!-- Connexion : tant qu'aucune session n'est ouverte -->
    <!-- Première installation : l'assistant remplace la connexion tant qu'aucune configuration n'existe -->
    <ContentControl Content="{Binding Setup}" IsVisible="{Binding IsSetupRequired}" />
    <ContentControl Content="{Binding Login}" IsVisible="{Binding ShowLogin}" />

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="{Binding IsLoggedIn}">

      <!-- Barre de titre couleur d'accent : identité, recherche au centre, utilisateur -->
      <Border Grid.Row="0" Classes="titlebar">
        <Grid ColumnDefinitions="*,Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="avares://SCOLIA/Assets/scolia.png" Width="22" Height="22" />
            <TextBlock Text="SCOLIA" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" />
            <TextBlock Text="{Binding SchoolLine}" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" Opacity="0.85" />
          </StackPanel>
          <Button Grid.Column="1" Classes="titlesearch" Command="{Binding SearchCommand}" ToolTip.Tip="Rechercher (Ctrl+K)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" />
              <TextBlock Text="Rechercher" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Classes="ghost" Command="{Binding ReloadCommand}" ToolTip.Tip="Actualiser (F5)" Padding="8,4" Foreground="{DynamicResource OnAccentBrush}">
              <mi:MaterialIcon Kind="Refresh" Width="18" Height="18" />
            </Button>
            <TextBlock Text="{Binding UserLine}" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" />
            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource OnAccentBrush}">
              <TextBlock Text="{Binding UserInitials}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Onglets du ruban : Fichier, puis les onglets de l'écran. Les onglets contextuels ont leur couleur. -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Background="{DynamicResource Surface2Brush}">
        <ItemsControl ItemsSource="{Binding Tabs}" Margin="6,4,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="0" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding ContextLabel}" IsVisible="{Binding IsContext}" Foreground="{Binding ContextBrush}"
                           FontSize="{DynamicResource FsCaption}" FontWeight="SemiBold" Margin="10,0,0,0" />
                <Button Classes="ribbontab" Classes.selected="{Binding IsSelected}" Classes.file="{Binding IsFile}"
                        Content="{Binding Title}" Click="OnTabClick" Tag="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Column="1" Classes="ghost" Margin="4,4,8,2" Padding="8,4"
                ToolTip.Tip="Réduire ou développer le ruban (Ctrl+F1)" Click="OnToggleRibbon">
          <Grid>
            <mi:MaterialIcon Kind="ChevronDown" Width="18" Height="18" IsVisible="{Binding Prefs.RibbonCollapsed}" />
            <mi:MaterialIcon Kind="ChevronUp" Width="18" Height="18" IsVisible="{Binding !Prefs.RibbonCollapsed}" />
          </Grid>
        </Button>
      </Grid>

      <!-- Ruban : commandes de l'onglet choisi -->
      <Border Grid.Row="2" Classes="ribbonbody" IsVisible="{Binding !Prefs.RibbonCollapsed}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding SelectedGroups}" Margin="6,4">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="groupsep" Padding="8,2,8,2" Margin="0,0,0,0">
                <StackPanel Spacing="4">
                  <ItemsControl ItemsSource="{Binding Commands}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Command="{Binding Command}" Classes="ribbon" Classes.large="{Binding Large}" Classes.on="{Binding IsOn}"
                                ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="400" VerticalAlignment="Top">
                          <Grid>
                            <StackPanel Spacing="4" IsVisible="{Binding Large}" HorizontalAlignment="Center">
                              <mi:MaterialIcon Kind="{Binding Icon}" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{Binding Brush}" />
                              <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsSmall}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="92" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !Large}" VerticalAlignment="Center">
                              <mi:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{Binding Brush}" />
                              <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Title}" Classes="grouptitle" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Écran courant : en-tête de page, puis contenu. Dialogues et notifications se superposent. -->
      <Grid Grid.Row="3">
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasPage}">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,16,24,8">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Current.Title}" Classes="title" />
              <TextBlock Text="{Binding Current.Subtitle}" Classes="muted" />
            </StackPanel>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Current.Actions}" VerticalAlignment="Center" MaxWidth="640" Margin="16,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding Command}" Content="{Binding Label}" Classes.primary="{Binding Primary}" Padding="14,6" Margin="0,0,8,6" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <ContentControl Grid.Row="1" Content="{Binding Current}" Margin="24,0,24,16" />
        </Grid>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Current.Busy}" VerticalAlignment="Top" Height="2" MinHeight="2" />

        <!-- Menu Fichier : couvre l'écran -->
        <ContentControl Content="{Binding Backstage}" IsVisible="{Binding BackstageOpen}" Background="{DynamicResource BgBrush}" />

        <!-- Boîte de dialogue modale : formulaire, recherche, confirmation -->
        <Border Classes="scrim" IsVisible="{Binding HasDialog}">
          <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
        </Border>

        <!-- Notification discrète, en bas à gauche -->
        <Border Classes="snackbar" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24" IsVisible="{Binding HasNotice}">
          <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource BgBrush}" TextWrapping="Wrap" />
        </Border>
      </Grid>

      <!-- Barre d'état : statut, serveur, année, zoom -->
      <Border Grid.Row="4" Classes="statusbar" IsVisible="{Binding Prefs.StatusBar}">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ServerLine}" Classes="muted" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button Classes="ghost" Padding="4,0" Click="OnZoomOut" Content="−" />
            <TextBlock Text="{Binding Prefs.ZoomLabel}" Classes="muted" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" />
            <Button Classes="ghost" Padding="4,0" Click="OnZoomIn" Content="+" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Scolia.Bureau.ViewModels"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="Scolia.Bureau.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="SCOLIA"
        Width="1280" Height="820" MinWidth="760" MinHeight="520"
        KeyDown="OnKeyDown">
  <!-- Toute l'interface suit la taille de la fenêtre : la mise en page de 1280 × 720, agrandie ou réduite d'un bloc -->
  <LayoutTransformControl x:Name="Scaler">
  <Grid>
    <!-- Connexion : tant qu'aucune session n'est ouverte -->
    <!-- Première installation : l'assistant remplace la connexion tant qu'aucune configuration n'existe -->
    <ContentControl Content="{Binding Setup}" IsVisible="{Binding IsSetupRequired}" />
    <ContentControl Content="{Binding Login}" IsVisible="{Binding ShowLogin}" />
    <ContentControl Content="{Binding Connection}" IsVisible="{Binding ChoosingServer}" />

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto" IsVisible="{Binding IsLoggedIn}">

      <!-- Volet latéral flottant, comme les Réglages de macOS : recherche, compte, puis chaque outil avec son icône -->
      <Border Grid.Column="0" Classes="sidebar" Width="250" Margin="8,8,0,8" IsVisible="{Binding SidebarShown}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="10,12,10,6">
            <Button Classes="titlesearch" Command="{Binding SearchCommand}" ToolTip.Tip="Rechercher (Ctrl+K)">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="0,0,6,0" />
                <TextBlock Grid.Column="1" Text="Rechercher" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Ctrl+K" Classes="muted" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navitem" Click="OnAccountClick" Padding="6,6" ToolTip.Tip="Compte et poste">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ToneNeutral}" Margin="0,0,10,0">
                  <TextBlock Text="{Binding UserInitials}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Compte et poste" Classes="muted" />
                </StackPanel>
              </Grid>
            </Button>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Navigation}" Margin="10,4,10,12">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="navitem" Classes.selected="{Binding IsSelected}" Command="{Binding Open}" Margin="0,1">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Classes="appicon" Background="{Binding Brush}">
                              <mi:MaterialIcon Kind="{Binding Icon}" />
                            </Border>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Page : flèches retour et suivant, titre, actions ; puis le contenu -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" IsVisible="{Binding HasPage}">
        <Border Grid.Row="0" Classes="pagebar" x:Name="PageBar">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Button Classes="toolicon" Command="{Binding ToggleSidebarCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                    ToolTip.Tip="Afficher ou masquer le volet (Ctrl+B)">
              <mi:MaterialIcon Kind="DockLeft" Width="18" Height="18" />
            </Button>
            <Border Grid.Column="1" Classes="navcapsule" VerticalAlignment="Center" Margin="0,0,14,0">
              <StackPanel Orientation="Horizontal">
                <Button Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="Précédent (Alt+Gauche)">
                  <mi:MaterialIcon Kind="ChevronLeft" Width="20" Height="20" />
                </Button>
                <Rectangle Width="1" Height="16" Fill="{DynamicResource LineBrush}" VerticalAlignment="Center" />
                <Button Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="Suivant (Alt+Droite)">
                  <mi:MaterialIcon Kind="ChevronRight" Width="20" Height="20" />
                </Button>
              </StackPanel>
            </Border>
            <Grid Grid.Column="2" ColumnDefinitions="Auto,*" VerticalAlignment="Center" MinWidth="200">
              <Border Classes="appicon medium" Background="{Binding CurrentIconBrush}" Margin="0,0,10,0">
                <mi:MaterialIcon Kind="{Binding CurrentIcon}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Current.Heading}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Current.Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="6">
              <ItemsControl ItemsSource="{Binding Current.VisibleActions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding Command}" Classes.primary="{Binding IsPrimary}" Classes.danger="{Binding Danger}" ToolTip.Tip="{Binding Label}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button IsVisible="{Binding Current.HasMoreActions}" ToolTip.Tip="Plus d'actions" Padding="8,4">
                <mi:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight" ItemsSource="{Binding Current.MoreActions}">
                    <MenuFlyout.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}" />
                        <Setter Property="Command" Value="{Binding Command}" />
                      </ControlTheme>
                    </MenuFlyout.ItemContainerTheme>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <Button Grid.Column="4" Classes="toolicon" Click="OnMenuClick" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Toutes les commandes">
              <mi:MaterialIcon Kind="Menu" Width="18" Height="18" />
            </Button>
          </Grid>
        </Border>
        <TransitioningContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding Current}" Margin="20,8,20,16" />
      </Grid>
      <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding Current.Busy}" VerticalAlignment="Top" Height="2" MinHeight="2" />

      <!-- Compte et réglages du poste : couvre la fenêtre -->
      <ContentControl Grid.ColumnSpan="2" Grid.RowSpan="2" Content="{Binding Backstage}" IsVisible="{Binding BackstageOpen}" Background="{DynamicResource BgBrush}" />

      <!-- Notification discrète, en bas -->
      <Border Grid.Column="1" Classes="snackbar" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24" IsVisible="{Binding HasNotice}">
        <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource BgBrush}" TextWrapping="Wrap" />
      </Border>

      <!-- Barre d'état : statut, serveur, zoom -->
      <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="statusbar" IsVisible="{Binding Prefs.StatusBar}">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ServerLine}" Classes="muted" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button Classes="ghost" Padding="4,0" MinHeight="0" Click="OnZoomOut" Content="−" />
            <TextBlock Text="{Binding Prefs.ZoomLabel}" Classes="muted" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" />
            <Button Classes="ghost" Padding="4,0" MinHeight="0" Click="OnZoomIn" Content="+" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Boîte de dialogue modale : elle couvre toute la fenêtre -->
      <Border Grid.ColumnSpan="2" Grid.RowSpan="2" Classes="scrim" IsVisible="{Binding HasDialog}">
        <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
      </Border>
    </Grid>
  </Grid>
  </LayoutTransformControl>
</Window>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Ordinateur : Fluent de Windows 11, comme l'application Paramètres. Fond Mica gris clair (#F3F3F3), cartes
       #FBFBFB cernées d'un filet #E5E5E5, accent bleu Windows, texte presque noir, coins de 8 px (4 px pour les
       commandes). Le bandeau perd son dégradé bleu : la barre de la page se pose sur le même fond que la fenêtre. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#004C93" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#E0ECF8" />
      <SolidColorBrush x:Key="BgBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Surface2Brush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="GroupBrush" Color="#FBFBFB" />
      <SolidColorBrush x:Key="ToolbarBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SearchBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="LineBrush" Color="#E5E5E5" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#7A7A7A" />
      <!-- Volet de navigation de Windows 11 : posé sur le fond, sans cadre ; éléments transparents -->
      <SolidColorBrush x:Key="SidebarStrokeBrush" Color="Transparent" />
      <SolidColorBrush x:Key="NavItemBrush" Color="Transparent" />
      <SolidColorBrush x:Key="FieldLineBrush" Color="#868686" />
      <SolidColorBrush x:Key="ButtonLineBrush" Color="#8A8A8A" />
      <!-- Bouton standard WinUI : remplissage ControlFillColorDefault, filet d'élévation plus sombre en bas -->
      <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F6F6F6" />
      <SolidColorBrush x:Key="ButtonFillBrush" Color="#FBFBFB" />
      <SolidColorBrush x:Key="ButtonPressedBrush" Color="#F5F5F5" />
      <LinearGradientBrush x:Key="ButtonStrokeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#E5E5E5" />
        <GradientStop Offset="0.9" Color="#E5E5E5" />
        <GradientStop Offset="1" Color="#CCCCCC" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B" />
      <SolidColorBrush x:Key="Text2Brush" Color="#323232" />
      <SolidColorBrush x:Key="MutedBrush" Color="#5C5C5C" />
      <SolidColorBrush x:Key="TableHeadBrush" Color="#F7F7F7" />
      <SolidColorBrush x:Key="TableAltBrush" Color="#F9F9F9" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E6E6E6" />
      <SolidColorBrush x:Key="HoverBrush" Color="#EDEDED" />
      <SolidColorBrush x:Key="SnackbarBrush" Color="#1B1B1B" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="HeaderBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="HeaderTextBrush" Color="#1B1B1B" />
      <SolidColorBrush x:Key="HeaderMutedBrush" Color="#5C5C5C" />
      <SolidColorBrush x:Key="HeaderControlBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="HeaderHoverBrush" Color="#EAEAEA" />
      <SolidColorBrush x:Key="HeaderLineBrush" Color="#E5E5E5" />
      <SolidColorBrush x:Key="FileTabBrush" Color="#005FB8" />
      <SolidColorBrush x:Key="MicaBgBrush" Color="#C7F3F3F3" />
      <SolidColorBrush x:Key="MicaHeaderBrush" Color="#00F3F3F3" />
      <Color x:Key="AccentColor">#005FB8</Color>
      <Color x:Key="ShadowColor">#14000000</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#8DDBFF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F3A4F" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#000000" />
      <SolidColorBrush x:Key="BgBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#262626" />
      <SolidColorBrush x:Key="Surface2Brush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="GroupBrush" Color="#212121" />
      <SolidColorBrush x:Key="ToolbarBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="FieldBrush" Color="#262626" />
      <SolidColorBrush x:Key="SearchBrush" Color="#262626" />
      <SolidColorBrush x:Key="LineBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#8A8A8A" />
      <SolidColorBrush x:Key="SidebarStrokeBrush" Color="Transparent" />
      <SolidColorBrush x:Key="NavItemBrush" Color="Transparent" />
      <SolidColorBrush x:Key="FieldLineBrush" Color="#8F8F8F" />
      <SolidColorBrush x:Key="ButtonLineBrush" Color="#8A8A8A" />
      <SolidColorBrush x:Key="ButtonHoverBrush" Color="#323232" />
      <SolidColorBrush x:Key="ButtonFillBrush" Color="#2D2D2D" />
      <SolidColorBrush x:Key="ButtonPressedBrush" Color="#272727" />
      <LinearGradientBrush x:Key="ButtonStrokeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#3A3A3A" />
        <GradientStop Offset="0.1" Color="#353535" />
        <GradientStop Offset="1" Color="#353535" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Text2Brush" Color="#E0E0E0" />
      <SolidColorBrush x:Key="MutedBrush" Color="#C5C5C5" />
      <SolidColorBrush x:Key="TableHeadBrush" Color="#212121" />
      <SolidColorBrush x:Key="TableAltBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="HoverBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="SnackbarBrush" Color="#F2F2F2" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#232323" />
      <SolidColorBrush x:Key="HeaderBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="HeaderMutedBrush" Color="#C5C5C5" />
      <SolidColorBrush x:Key="HeaderControlBrush" Color="#262626" />
      <SolidColorBrush x:Key="HeaderHoverBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="HeaderLineBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="FileTabBrush" Color="#60CDFF" />
      <SolidColorBrush x:Key="MicaBgBrush" Color="#C71A1A1A" />
      <SolidColorBrush x:Key="MicaHeaderBrush" Color="#001A1A1A" />
      <Color x:Key="AccentColor">#60CDFF</Color>
      <Color x:Key="ShadowColor">#66000000</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <BoxShadows x:Key="SidebarShadow">0 0 0 0 #00000000</BoxShadows>
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>
  <CornerRadius x:Key="RadiusField">4</CornerRadius>
  <CornerRadius x:Key="RadiusPill">4</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <!-- Contrôles WinUI 3 : boutons et champs de 32 px, coins de 4 px, filet de 1 px, texte en Regular -->
  <Thickness x:Key="ButtonStroke">1</Thickness>
  <x:Double x:Key="FieldHeight">32</x:Double>
  <x:Double x:Key="SearchHeight">36</x:Double>
  <CornerRadius x:Key="RadiusInput">4</CornerRadius>
  <!-- Recherche, puce du compte, boutons de barre et lignes : 4 px comme les contrôles WinUI -->
  <CornerRadius x:Key="RadiusSearch">4</CornerRadius>
  <CornerRadius x:Key="RadiusChip">4</CornerRadius>
  <CornerRadius x:Key="RadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RadiusIconButton">4</CornerRadius>
  <CornerRadius x:Key="RadiusRow">4</CornerRadius>
  <FontWeight x:Key="BodyWeight">Normal</FontWeight>
</ResourceDictionary>

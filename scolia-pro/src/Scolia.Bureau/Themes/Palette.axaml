<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Clarté façon SCOLIA Console (JP-Services) : fond de page très clair légèrement bleuté, cartes et volet blancs
       cernés d'un filet fin, champs blancs, texte bleu nuit net, teintes douces pour les états. Contraste élevé (comme « Augmenter le contraste » d'iOS et le contraste élevé d'Android) :
       en clair, chaque teinte d'icône porte un pictogramme blanc à 4,9:1 au moins et reste lisible en texte ;
       les bordures des champs atteignent 3:1. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <LinearGradientBrush x:Key="WelcomeBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#EDF4FF" /><GradientStop Offset="0.55" Color="#F8FBFF" /><GradientStop Offset="1" Color="#EDF8F2" />
      </LinearGradientBrush>
      <!-- Marque SCOLIA : bleu et vert sur fond clair -->
      <SolidColorBrush x:Key="LogoPrimaryBrush" Color="#1D4ED8" />
      <SolidColorBrush x:Key="LogoSecondaryBrush" Color="#16A34A" />
      <SolidColorBrush x:Key="AccentBrush" Color="#1D4ED8" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#1E40AF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3EDFF" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="OnToneBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DangerBrush" Color="#A8201A" />
      <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BgBrush" Color="#F5F7FC" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Surface2Brush" Color="#EAEFF6" />
      <SolidColorBrush x:Key="GroupBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToolbarBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SearchBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="LineBrush" Color="#E1E8F2" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#7D8798" />
      <SolidColorBrush x:Key="SidebarStrokeBrush" Color="#E1E8F2" />
      <SolidColorBrush x:Key="NavItemBrush" Color="#FFFFFF" />
      <!-- Contour des champs blancs : visible (3:1 sur blanc) sans alourdir, l'accent marque le focus -->
      <SolidColorBrush x:Key="FieldLineBrush" Color="#8A94A6" />
      <SolidColorBrush x:Key="ButtonLineBrush" Color="#7D8798" />
      <SolidColorBrush x:Key="ButtonHoverBrush" Color="#DEE6F1" />
      <SolidColorBrush x:Key="ButtonFillBrush" Color="#EAEFF6" />
      <SolidColorBrush x:Key="ButtonPressedBrush" Color="#D3DEED" />
      <SolidColorBrush x:Key="ButtonStrokeBrush" Color="Transparent" />
      <SolidColorBrush x:Key="NavSelectedBrush" Color="#E7EEFA" />
      <SolidColorBrush x:Key="TextBrush" Color="#152C4D" />
      <SolidColorBrush x:Key="Text2Brush" Color="#263D5E" />
      <SolidColorBrush x:Key="MutedBrush" Color="#56677F" />
      <SolidColorBrush x:Key="TableHeadBrush" Color="#F7F9FC" />
      <SolidColorBrush x:Key="TableAltBrush" Color="#F9FBFD" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E3EDFF" />
      <SolidColorBrush x:Key="HoverBrush" Color="#EEF3FA" />
      <SolidColorBrush x:Key="SnackbarBrush" Color="#152C4D" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#33000000" />
      <SolidColorBrush x:Key="ToneBlue" Color="#1D4ED8" />
      <SolidColorBrush x:Key="ToneGreen" Color="#15803D" />
      <SolidColorBrush x:Key="ToneOrange" Color="#B53000" />
      <SolidColorBrush x:Key="TonePurple" Color="#1D4ED8" />
      <SolidColorBrush x:Key="ToneRed" Color="#C9001A" />
      <SolidColorBrush x:Key="ToneTeal" Color="#15803D" />
      <SolidColorBrush x:Key="ToneIndigo" Color="#1D4ED8" />
      <SolidColorBrush x:Key="TonePink" Color="#15803D" />
      <SolidColorBrush x:Key="ToneNeutral" Color="#636366" />
      <SolidColorBrush x:Key="GreenSoftBrush" Color="#E5F6EC" />
      <SolidColorBrush x:Key="OrangeSoftBrush" Color="#FFF4E2" />
      <SolidColorBrush x:Key="RedSoftBrush" Color="#FFECEE" />
      <SolidColorBrush x:Key="PurpleSoftBrush" Color="#EAF0FF" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#EEF2F8" />
      <!-- Bandeau du haut : bleu ciel, du titre de la fenêtre jusqu'à la barre de la page -->
      <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#BFE4FF" />
        <GradientStop Offset="1" Color="#93CDF8" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="HeaderTextBrush" Color="#0B2545" />
      <SolidColorBrush x:Key="HeaderMutedBrush" Color="#2E5376" />
      <SolidColorBrush x:Key="HeaderControlBrush" Color="#8CFFFFFF" />
      <SolidColorBrush x:Key="HeaderHoverBrush" Color="#D9FFFFFF" />
      <SolidColorBrush x:Key="HeaderLineBrush" Color="#7FB6DD" />
      <SolidColorBrush x:Key="FileTabBrush" Color="#1D4ED8" />
      <!-- Fond Mica de Windows 11 : le fond de page et le bandeau laissent passer la teinte du bureau, les cartes
           restent opaques (lisibilité inchangée). Utilisés seulement quand Windows confirme l'effet. -->
      <SolidColorBrush x:Key="MicaBgBrush" Color="#C7F5F7FC" />
      <LinearGradientBrush x:Key="MicaHeaderBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#D9BFE4FF" />
        <GradientStop Offset="1" Color="#D993CDF8" />
      </LinearGradientBrush>
      <Color x:Key="AccentColor">#1D4ED8</Color>
      <Color x:Key="ShadowColor">#14152C4D</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <LinearGradientBrush x:Key="WelcomeBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#182C48" /><GradientStop Offset="0.55" Color="#172638" /><GradientStop Offset="1" Color="#183A33" />
      </LinearGradientBrush>
      <!-- Sombre façon Android 16 (Material 3) : fond gris très foncé, jamais noir pur, cartes à peine plus claires,
           textes adoucis. Les zones hors des cartes et les cartes restent dans la même famille de tons. -->
      <!-- Marque SCOLIA : bleu et vert éclaircis sur fond sombre -->
      <SolidColorBrush x:Key="LogoPrimaryBrush" Color="#5B8DEF" />
      <SolidColorBrush x:Key="LogoSecondaryBrush" Color="#22C55E" />
      <SolidColorBrush x:Key="AccentBrush" Color="#78B9FF" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#99CAFF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#1C3A5E" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#111111" />
      <!-- Pictogramme des icônes : blanc, comme en clair -->
      <SolidColorBrush x:Key="OnToneBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFB4AB" />
      <SolidColorBrush x:Key="OnDangerBrush" Color="#111111" />
      <SolidColorBrush x:Key="BgBrush" Color="#131316" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C21" />
      <SolidColorBrush x:Key="Surface2Brush" Color="#2E2E34" />
      <SolidColorBrush x:Key="GroupBrush" Color="#212126" />
      <SolidColorBrush x:Key="ToolbarBrush" Color="#131316" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#18181C" />
      <SolidColorBrush x:Key="FieldBrush" Color="#2A2A30" />
      <SolidColorBrush x:Key="SearchBrush" Color="#26262B" />
      <SolidColorBrush x:Key="LineBrush" Color="#303036" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#808088" />
      <SolidColorBrush x:Key="SidebarStrokeBrush" Color="#303036" />
      <SolidColorBrush x:Key="NavItemBrush" Color="#212126" />
      <SolidColorBrush x:Key="FieldLineBrush" Color="#85858D" />
      <SolidColorBrush x:Key="ButtonLineBrush" Color="#808088" />
      <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3A3A41" />
      <SolidColorBrush x:Key="ButtonFillBrush" Color="#2E2E34" />
      <SolidColorBrush x:Key="ButtonPressedBrush" Color="#44444C" />
      <SolidColorBrush x:Key="NavSelectedBrush" Color="#2B3446" />
      <SolidColorBrush x:Key="ButtonStrokeBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TextBrush" Color="#E6E6EB" />
      <SolidColorBrush x:Key="Text2Brush" Color="#C9C9CF" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A1A1A9" />
      <SolidColorBrush x:Key="TableHeadBrush" Color="#212126" />
      <SolidColorBrush x:Key="TableAltBrush" Color="#1A1A1E" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#26354A" />
      <SolidColorBrush x:Key="HoverBrush" Color="#2A2A30" />
      <SolidColorBrush x:Key="SnackbarBrush" Color="#E6E6EB" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
      <!-- Couleurs des icônes : les mêmes teintes franches qu'en clair, comme les couleurs système d'iOS et de macOS
           en sombre. Une icône garde sa nature et sa netteté quand on change de thème ; elle ne pâlit jamais. -->
      <SolidColorBrush x:Key="ToneBlue" Color="#78B9FF" />
      <SolidColorBrush x:Key="ToneGreen" Color="#6CE09C" />
      <SolidColorBrush x:Key="ToneOrange" Color="#FF9F0A" />
      <SolidColorBrush x:Key="TonePurple" Color="#78B9FF" />
      <SolidColorBrush x:Key="ToneRed" Color="#FF453A" />
      <SolidColorBrush x:Key="ToneTeal" Color="#6CE09C" />
      <SolidColorBrush x:Key="ToneIndigo" Color="#78B9FF" />
      <SolidColorBrush x:Key="TonePink" Color="#6CE09C" />
      <SolidColorBrush x:Key="ToneNeutral" Color="#98989D" />
      <SolidColorBrush x:Key="GreenSoftBrush" Color="#173A22" />
      <SolidColorBrush x:Key="OrangeSoftBrush" Color="#3D2C12" />
      <SolidColorBrush x:Key="RedSoftBrush" Color="#3E1A18" />
      <SolidColorBrush x:Key="PurpleSoftBrush" Color="#1D304C" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#2A2A30" />
      <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#0F2E4C" />
        <GradientStop Offset="1" Color="#164272" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="HeaderTextBrush" Color="#F2F8FF" />
      <SolidColorBrush x:Key="HeaderMutedBrush" Color="#A8C4E0" />
      <SolidColorBrush x:Key="HeaderControlBrush" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="HeaderHoverBrush" Color="#38FFFFFF" />
      <SolidColorBrush x:Key="HeaderLineBrush" Color="#2A5885" />
      <SolidColorBrush x:Key="FileTabBrush" Color="#78B9FF" />
      <SolidColorBrush x:Key="MicaBgBrush" Color="#C7131316" />
      <LinearGradientBrush x:Key="MicaHeaderBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#D90F2E4C" />
        <GradientStop Offset="1" Color="#D9164272" />
      </LinearGradientBrush>
      <Color x:Key="AccentColor">#78B9FF</Color>
      <Color x:Key="ShadowColor">#66000000</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Logo du logiciel, dessiné en vecteurs : net à toutes les tailles, couleurs selon le thème. Même tracé que docs/logo/scolia.svg. -->
  <DrawingImage x:Key="ScoliaMark">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M40,40 H472 V472 H40 Z" />
        <GeometryDrawing Geometry="M330,118 H206 Q148,118 148,176 Q148,234 206,234 H226">
          <GeometryDrawing.Pen><Pen Brush="{DynamicResource LogoPrimaryBrush}" Thickness="62" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M286,278 H306 Q364,278 364,336 Q364,394 306,394 H182">
          <GeometryDrawing.Pen><Pen Brush="{DynamicResource LogoSecondaryBrush}" Thickness="62" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="{DynamicResource LogoPrimaryBrush}"><GeometryDrawing.Geometry><EllipseGeometry Center="418,118" RadiusX="38" RadiusY="38" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="{DynamicResource LogoSecondaryBrush}"><GeometryDrawing.Geometry><EllipseGeometry Center="94,394" RadiusX="38" RadiusY="38" /></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Police du système : Segoe UI Variable sous Windows 11, Segoe UI sous Windows 10, Inter embarquée ailleurs. -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, avares://SCOLIA/Assets/Fonts#Inter</FontFamily>
  <!-- Géométrie macOS : boutons en capsule, champs à 6 px, blocs à 12 px. -->
  <CornerRadius x:Key="RadiusCard">14</CornerRadius>
  <CornerRadius x:Key="RadiusField">6</CornerRadius>
  <CornerRadius x:Key="RadiusPill">14</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
  <BoxShadows x:Key="SidebarShadow">0 1 5 0 #10000000</BoxShadows>
  <!-- Géométrie des contrôles, ajustée par Themes/Windows11.axaml sur l'ordinateur -->
  <Thickness x:Key="TableHeaderPadding">22,4,8,4</Thickness>
  <Thickness x:Key="ButtonStroke">0</Thickness>
  <x:Double x:Key="FieldHeight">44</x:Double>
  <x:Double x:Key="SearchHeight">44</x:Double>
  <x:Double x:Key="SearchBarHeight">46</x:Double>
  <x:Double x:Key="FsSearch">15</x:Double>
  <CornerRadius x:Key="RadiusInput">12</CornerRadius>
  <CornerRadius x:Key="RadiusSearch">23</CornerRadius>
  <CornerRadius x:Key="RadiusChip">17</CornerRadius>
  <CornerRadius x:Key="RadiusControl">14</CornerRadius>
  <CornerRadius x:Key="RadiusIconButton">22</CornerRadius>
  <CornerRadius x:Key="RadiusRow">10</CornerRadius>
  <FontWeight x:Key="BodyWeight">Medium</FontWeight>
  <x:Double x:Key="FsBase">13.5</x:Double>
  <x:Double x:Key="FsSmall">12</x:Double>
  <x:Double x:Key="FsCaption">11</x:Double>
  <x:Double x:Key="FsHeading">15</x:Double>
  <x:Double x:Key="FsPageHeading">17</x:Double>
  <x:Double x:Key="FsStickyValue">20</x:Double>
  <x:Double x:Key="FsTitle">22</x:Double>
  <x:Double x:Key="FsDisplay">28</x:Double>
  <x:Double x:Key="RowHeight">36</x:Double>
  <x:Double x:Key="CtlHeight">30</x:Double>
</ResourceDictionary>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Couleurs de Windows 11 (Fluent) : fond gris clair, surfaces blanches, traits fins, bleu d'accent du système.
       Les teintes d'état sont celles de Windows : succès, attention, erreur. Aucune couleur décorative. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#1975C5" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5F0FA" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BgBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Surface2Brush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="ToolbarBrush" Color="#F9F9F9" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SearchBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="LineBrush" Color="#E5E5E5" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#D1D1D1" />
      <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="Text2Brush" Color="#424242" />
      <SolidColorBrush x:Key="MutedBrush" Color="#616161" />
      <SolidColorBrush x:Key="TableHeadBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TableAltBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#EAEAEA" />
      <SolidColorBrush x:Key="SnackbarBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#4D000000" />
      <SolidColorBrush x:Key="ToneBlue" Color="#0067C0" />
      <SolidColorBrush x:Key="ToneGreen" Color="#0F7B0F" />
      <SolidColorBrush x:Key="ToneOrange" Color="#9D5D00" />
      <SolidColorBrush x:Key="TonePurple" Color="#8764B8" />
      <SolidColorBrush x:Key="ToneRed" Color="#C42B1C" />
      <SolidColorBrush x:Key="ToneTeal" Color="#00727C" />
      <SolidColorBrush x:Key="ToneIndigo" Color="#4F52B2" />
      <SolidColorBrush x:Key="ToneNeutral" Color="#616161" />
      <SolidColorBrush x:Key="GreenSoftBrush" Color="#DFF6DD" />
      <SolidColorBrush x:Key="OrangeSoftBrush" Color="#FFF4CE" />
      <SolidColorBrush x:Key="RedSoftBrush" Color="#FDE7E9" />
      <SolidColorBrush x:Key="PurpleSoftBrush" Color="#EFE9F7" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="FileTabBrush" Color="#0067C0" />
      <Color x:Key="AccentColor">#0067C0</Color>
      <Color x:Key="ShadowColor">#1A000000</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#47B1E8" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F3A4D" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#000000" />
      <SolidColorBrush x:Key="BgBrush" Color="#202020" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="Surface2Brush" Color="#323232" />
      <SolidColorBrush x:Key="ToolbarBrush" Color="#272727" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#202020" />
      <SolidColorBrush x:Key="FieldBrush" Color="#2D2D2D" />
      <SolidColorBrush x:Key="SearchBrush" Color="#2D2D2D" />
      <SolidColorBrush x:Key="LineBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#4A4A4A" />
      <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Text2Brush" Color="#D6D6D6" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A0A0A0" />
      <SolidColorBrush x:Key="TableHeadBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="TableAltBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2D2D2D" />
      <SolidColorBrush x:Key="SnackbarBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#8C000000" />
      <SolidColorBrush x:Key="ToneBlue" Color="#4CC2FF" />
      <SolidColorBrush x:Key="ToneGreen" Color="#6CCB5F" />
      <SolidColorBrush x:Key="ToneOrange" Color="#FFB900" />
      <SolidColorBrush x:Key="TonePurple" Color="#B4A0FF" />
      <SolidColorBrush x:Key="ToneRed" Color="#FF99A4" />
      <SolidColorBrush x:Key="ToneTeal" Color="#4FC3C9" />
      <SolidColorBrush x:Key="ToneIndigo" Color="#9C9EFF" />
      <SolidColorBrush x:Key="ToneNeutral" Color="#A0A0A0" />
      <SolidColorBrush x:Key="GreenSoftBrush" Color="#393D1B" />
      <SolidColorBrush x:Key="OrangeSoftBrush" Color="#433519" />
      <SolidColorBrush x:Key="RedSoftBrush" Color="#442726" />
      <SolidColorBrush x:Key="PurpleSoftBrush" Color="#3A2E4F" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#2D2D2D" />
      <SolidColorBrush x:Key="FileTabBrush" Color="#4CC2FF" />
      <Color x:Key="AccentColor">#4CC2FF</Color>
      <Color x:Key="ShadowColor">#40000000</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Police du système : Segoe UI Variable sous Windows 11, Segoe UI sous Windows 10, Inter embarquée ailleurs. -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, avares://SCOLIA/Assets/Fonts#Inter</FontFamily>
  <!-- Géométrie Windows 11 : 4 px pour les contrôles, 8 px pour les panneaux. -->
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>
  <CornerRadius x:Key="RadiusField">4</CornerRadius>
  <CornerRadius x:Key="RadiusPill">4</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <x:Double x:Key="FsBase">14</x:Double>
  <x:Double x:Key="FsSmall">12</x:Double>
  <x:Double x:Key="FsCaption">12</x:Double>
  <x:Double x:Key="FsHeading">16</x:Double>
  <x:Double x:Key="FsTitle">24</x:Double>
  <x:Double x:Key="FsDisplay">28</x:Double>
  <x:Double x:Key="RowHeight">34</x:Double>
  <x:Double x:Key="CtlHeight">32</x:Double>
</ResourceDictionary>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Couleurs du système de design d'Adobe (Spectrum), celui d'Acrobat : barre d'onglets grise, panneaux blancs,
       fond de travail gris très clair, bleu d'action, icônes d'outils colorées. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AccentBrush" Color="#1473E6" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#0D66D0" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5F0FD" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BgBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Surface2Brush" Color="#EAEAEA" />
      <SolidColorBrush x:Key="ToolbarBrush" Color="#EDEDED" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SearchBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="LineBrush" Color="#E1E1E1" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#B3B3B3" />
      <SolidColorBrush x:Key="ButtonLineBrush" Color="#8E8E8E" />
      <SolidColorBrush x:Key="TextBrush" Color="#222222" />
      <SolidColorBrush x:Key="Text2Brush" Color="#4B4B4B" />
      <SolidColorBrush x:Key="MutedBrush" Color="#6E6E6E" />
      <SolidColorBrush x:Key="TableHeadBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TableAltBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E1E1E1" />
      <SolidColorBrush x:Key="HoverBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="SnackbarBrush" Color="#323232" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
      <SolidColorBrush x:Key="ToneBlue" Color="#1473E6" />
      <SolidColorBrush x:Key="ToneGreen" Color="#268E6C" />
      <SolidColorBrush x:Key="ToneOrange" Color="#CB6F10" />
      <SolidColorBrush x:Key="TonePurple" Color="#7E4DCF" />
      <SolidColorBrush x:Key="ToneRed" Color="#D7373F" />
      <SolidColorBrush x:Key="ToneTeal" Color="#0F797D" />
      <SolidColorBrush x:Key="ToneIndigo" Color="#5151D3" />
      <SolidColorBrush x:Key="ToneNeutral" Color="#6E6E6E" />
      <SolidColorBrush x:Key="GreenSoftBrush" Color="#E5F5EE" />
      <SolidColorBrush x:Key="OrangeSoftBrush" Color="#FDF1E3" />
      <SolidColorBrush x:Key="RedSoftBrush" Color="#FCE9EA" />
      <SolidColorBrush x:Key="PurpleSoftBrush" Color="#F1EAFB" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="FileTabBrush" Color="#1473E6" />
      <Color x:Key="AccentColor">#1473E6</Color>
      <Color x:Key="ShadowColor">#26000000</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AccentBrush" Color="#378EF0" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#4B9CF5" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#20364F" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BgBrush" Color="#1D1D1D" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#2C2C2C" />
      <SolidColorBrush x:Key="Surface2Brush" Color="#3E3E3E" />
      <SolidColorBrush x:Key="ToolbarBrush" Color="#252525" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#2C2C2C" />
      <SolidColorBrush x:Key="FieldBrush" Color="#252525" />
      <SolidColorBrush x:Key="SearchBrush" Color="#252525" />
      <SolidColorBrush x:Key="LineBrush" Color="#3E3E3E" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#5A5A5A" />
      <SolidColorBrush x:Key="ButtonLineBrush" Color="#7C7C7C" />
      <SolidColorBrush x:Key="TextBrush" Color="#EBEBEB" />
      <SolidColorBrush x:Key="Text2Brush" Color="#C8C8C8" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A2A2A2" />
      <SolidColorBrush x:Key="TableHeadBrush" Color="#2C2C2C" />
      <SolidColorBrush x:Key="TableAltBrush" Color="#2C2C2C" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#3E3E3E" />
      <SolidColorBrush x:Key="HoverBrush" Color="#353535" />
      <SolidColorBrush x:Key="SnackbarBrush" Color="#EBEBEB" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
      <SolidColorBrush x:Key="ToneBlue" Color="#378EF0" />
      <SolidColorBrush x:Key="ToneGreen" Color="#33AB84" />
      <SolidColorBrush x:Key="ToneOrange" Color="#E68619" />
      <SolidColorBrush x:Key="TonePurple" Color="#9D64E1" />
      <SolidColorBrush x:Key="ToneRed" Color="#EC5B62" />
      <SolidColorBrush x:Key="ToneTeal" Color="#1BAEB3" />
      <SolidColorBrush x:Key="ToneIndigo" Color="#7575E9" />
      <SolidColorBrush x:Key="ToneNeutral" Color="#A2A2A2" />
      <SolidColorBrush x:Key="GreenSoftBrush" Color="#1E3A30" />
      <SolidColorBrush x:Key="OrangeSoftBrush" Color="#3D2D17" />
      <SolidColorBrush x:Key="RedSoftBrush" Color="#452326" />
      <SolidColorBrush x:Key="PurpleSoftBrush" Color="#33264A" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#353535" />
      <SolidColorBrush x:Key="FileTabBrush" Color="#378EF0" />
      <Color x:Key="AccentColor">#378EF0</Color>
      <Color x:Key="ShadowColor">#66000000</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Police du système : Segoe UI Variable sous Windows 11, Segoe UI sous Windows 10, Inter embarquée ailleurs. -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, avares://SCOLIA/Assets/Fonts#Inter</FontFamily>
  <!-- Géométrie Spectrum : boutons ronds, champs et panneaux à petits arrondis. -->
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>
  <CornerRadius x:Key="RadiusField">4</CornerRadius>
  <CornerRadius x:Key="RadiusPill">16</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <x:Double x:Key="FsBase">14</x:Double>
  <x:Double x:Key="FsSmall">12</x:Double>
  <x:Double x:Key="FsCaption">12</x:Double>
  <x:Double x:Key="FsHeading">16</x:Double>
  <x:Double x:Key="FsTitle">22</x:Double>
  <x:Double x:Key="FsDisplay">28</x:Double>
  <x:Double x:Key="RowHeight">40</x:Double>
  <x:Double x:Key="CtlHeight">32</x:Double>
</ResourceDictionary>

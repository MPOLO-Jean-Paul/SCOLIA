<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Une même hiérarchie que le téléphone, avec une densité adaptée au clavier et à la souris. -->
  <Style Selector="TextBlock.metriclabel, TextBlock.metricdetail">
    <Setter Property="FontSize" Value="{DynamicResource FsSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="TextBlock.metriclabel">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.metricvalue">
    <Setter Property="FontSize" Value="{DynamicResource FsTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.metricicon">
    <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="LayoutTransformControl:not(.phone) Border.card, LayoutTransformControl:not(.phone) Border.desktopgroup, LayoutTransformControl:not(.phone) Border.desktopwelcome, LayoutTransformControl:not(.phone) Border.tile">
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="LayoutTransformControl:not(.phone) Border.tile">
    <Setter Property="Padding" Value="16" />
    <Setter Property="MinHeight" Value="128" />
  </Style>
  <Style Selector="LayoutTransformControl:not(.phone) Border.desktopwelcome">
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>
  <Style Selector="LayoutTransformControl:not(.phone) Border.workspaceglyph">
    <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="LayoutTransformControl:not(.phone) Button.workspacerow">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="LayoutTransformControl:not(.phone) Button.heroaction">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="LayoutTransformControl:not(.phone) Border.guide">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="LayoutTransformControl:not(.phone) TextBlock.fieldlabel">
    <Setter Property="Margin" Value="0,0,0,3" />
  </Style>
</Styles>

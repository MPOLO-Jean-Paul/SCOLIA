<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             x:Class="Scolia.Bureau.Views.PosteView">
  <UserControl.Resources>
    <!-- Rejoindre un serveur : recherche sur le Wi-Fi, code QR, ou devenir le serveur. Partagé par le poste relié et le serveur. -->
    <DataTemplate x:Key="JoinActions">
      <StackPanel Spacing="6">
        <WrapPanel>
          <Button infra:Icons.Lead="Magnify" Content="Rechercher SCOLIA sur le réseau" Command="{Binding Search}" IsEnabled="{Binding NotSearching}" Margin="0,0,10,6" />
          <Button Command="{Binding ScanCode}" Margin="0,0,10,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="QrcodeScan" Width="16" Height="16" />
              <TextBlock Text="{Binding ScanLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button infra:Icons.Lead="ImageSearchOutline" Content="Importer une photo QR" Command="{Binding ImportQrImage}" Margin="0,0,10,6" IsVisible="{Binding CanImportQrImage}" />
          <Button infra:Icons.Lead="ServerOutline" Classes="ghost" Content="Utiliser cet ordinateur comme serveur" Command="{Binding UseThisComputer}" IsVisible="{Binding CanBecomeServer}" Margin="0,0,10,6" />
        </WrapPanel>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Searching}" Height="2" MinHeight="2" />
        <TextBlock Text="{Binding SearchLine}" IsVisible="{Binding HasSearchLine}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" />
        <ItemsControl ItemsSource="{Binding Servers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding School}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" />
                </StackPanel>
                <Button infra:Icons.Lead="LoginVariant" Grid.Column="1" Classes="primary" Content="Rejoindre" Command="{Binding Join}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Pastille d'état : un point de couleur et un texte court, pour lire le partage d'un coup d'œil. -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource GroupBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,8,6" />
    </Style>
    <Style Selector="TextBlock.sectiontitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,6,0,-6" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left" infra:LiveRefresh.Enabled="True">
    <StackPanel Spacing="4" IsVisible="{Binding ShowTitle}">
      <TextBlock Text="Poste et réseau" Classes="title" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Comment ce poste rejoint le serveur, et comment les autres appareils joignent ce serveur : par le Wi-Fi de l'établissement ou par Internet." />
    </StackPanel>

    <!-- ===== Serveur : vue d'ensemble du partage ===== -->
    <Border Classes="card" Padding="18,16" IsVisible="{Binding IsServerComputer}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowSpacing="10" infra:Adaptive.StackBelow="560">
        <Border Classes="appicon medium" Background="{Binding AccessBrush}" VerticalAlignment="Top" HorizontalAlignment="Left"><mi:MaterialIcon Kind="ShareVariantOutline" /></Border>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="{Binding AccessTitle}" FontWeight="SemiBold" FontSize="{DynamicResource FsHeading}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AccessSummary}" Classes="muted" TextWrapping="Wrap" />
          <WrapPanel Margin="0,4,0,0">
            <Border Classes="chip">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" Fill="{Binding WifiBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding WifiState}" FontSize="{DynamicResource FsSmall}" />
              </StackPanel>
            </Border>
            <Border Classes="chip" IsVisible="{Binding Remote.CanManage}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" Fill="{Binding InternetBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding InternetState}" FontSize="{DynamicResource FsSmall}" />
              </StackPanel>
            </Border>
            <Border Classes="chip" IsVisible="{Binding CanManageDevices}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="CellphoneLink" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DevicesState}" FontSize="{DynamicResource FsSmall}" />
              </StackPanel>
            </Border>
          </WrapPanel>
        </StackPanel>
        <Button x:Name="ShowCodeButton" Grid.Column="2" Classes="primary" Command="{Binding ShowCode}" VerticalAlignment="Top"
                ToolTip.Tip="Afficher le code QR à scanner sur l'autre appareil">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="QrcodeScan" Width="16" Height="16" />
            <TextBlock Text="Relier un appareil" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- ===== Poste relié : à quel serveur, et comment en changer ===== -->
    <TextBlock Text="Ce poste" Classes="sectiontitle" IsVisible="{Binding IsLinked}" />
    <Border Classes="card" Padding="0" IsVisible="{Binding IsLinked}">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*" Margin="18,16">
          <Border Classes="appicon medium" Background="{DynamicResource ToneBlue}" Margin="0,0,14,0"><mi:MaterialIcon Kind="DesktopTowerMonitor" /></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding ConnectionTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ConnectionLine}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" />
          </StackPanel>
        </Grid>
        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="58,0,0,0" />
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JoinActions}" Margin="58,12,18,10" />
      </StackPanel>
    </Border>

    <!-- ===== Serveur : Wi-Fi de l'établissement ===== -->
    <TextBlock Text="Wi-Fi de l'établissement" Classes="sectiontitle" IsVisible="{Binding IsServerComputer}" />
    <Border Classes="card" Padding="0" IsVisible="{Binding IsServerComputer}">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,16">
          <Border Classes="appicon medium" Background="{DynamicResource ToneGreen}" Margin="0,0,14,0"><mi:MaterialIcon Kind="Wifi" /></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="Partager avec les postes du Wi-Fi" />
            <TextBlock Text="{Binding LanLine}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" IsChecked="{Binding LanEnabled, Mode=OneWay}"
                        Command="{Binding ToggleLan}" IsEnabled="{Binding IsWindows}"
                        ToolTip.Tip="Ouvrir ou fermer l'accès des autres postes du réseau local" />
        </Grid>
        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="58,0,0,0" IsVisible="{Binding HasAddresses}" />
        <Grid ColumnDefinitions="*,Auto" Margin="58,12,18,14" IsVisible="{Binding HasAddresses}" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="Adresse pour un navigateur" Classes="caption" />
            <SelectableTextBlock Text="{Binding AddressList}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="Les postes équipés de SCOLIA trouvent ce serveur seuls ; l'adresse sert aux autres navigateurs du même réseau."
                       Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding CopyAddresses}" VerticalAlignment="Center" ToolTip.Tip="Copier l'adresse">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
              <TextBlock Text="Copier" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" Margin="58,0,18,14" IsVisible="{Binding ShowWifiWindowsNote}"
                   Text="Le partage sur le Wi-Fi se règle sur l'ordinateur principal sous Windows." />
      </StackPanel>
    </Border>

    <!-- ===== Serveur : accès par Internet (relais chiffré) ===== -->
    <TextBlock Text="Accès par Internet" Classes="sectiontitle" IsVisible="{Binding Remote.CanManage}" />
    <Border Classes="card" Padding="0" IsVisible="{Binding Remote.CanManage}">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*" Margin="18,16">
          <Border Classes="appicon medium" Background="{DynamicResource ToneBlue}" Margin="0,0,14,0" VerticalAlignment="Top"><mi:MaterialIcon Kind="CloudLockOutline" /></Border>
          <StackPanel Grid.Column="1" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Appareils distants" />
              <Border Classes="chip" Margin="0" Padding="8,1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="8" Height="8" Fill="{Binding Remote.StatusBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Remote.StatusTitle}" FontSize="{DynamicResource FsSmall}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Remote.StatusLine}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" />
            <WrapPanel Margin="0,8,0,0">
              <Button infra:Icons.Lead="CloudCheckOutline" Classes="primary" Content="{Binding Remote.EnableLabel}" Command="{Binding Remote.Enable}" Margin="0,0,10,6" />
              <Button infra:Icons.Lead="CloudOffOutline" Classes="ghost" Content="Désactiver" Command="{Binding Remote.Disable}" IsVisible="{Binding Remote.IsActive}" Margin="0,0,10,6"
                      ToolTip.Tip="Couper l'accès des appareils distants (demande confirmation)" />
            </WrapPanel>
            <TextBlock Text="{Binding Remote.Message}" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" IsVisible="{Binding Remote.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Expander Header="Adresse du relais (réglage avancé)" IsExpanded="False" Margin="0,6,0,0" HorizontalAlignment="Stretch">
              <StackPanel Margin="4,8" Spacing="6">
                <TextBox Text="{Binding Remote.Relay}" PlaceholderText="wss://adresse-du-relais/" />
                <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}"
                           Text="Relais Cloudflare ou Render de l'établissement, sous la forme wss://…/. Changer de relais renouvelle la liaison : les appareils distants devront scanner un nouveau code QR." />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- ===== Serveur : appareils autorisés à ouvrir le compte ===== -->
    <TextBlock Text="Appareils autorisés" Classes="sectiontitle" IsVisible="{Binding CanManageDevices}" />
    <Border Classes="card" Padding="0" IsVisible="{Binding CanManageDevices}">
      <StackPanel>
        <TextBlock Text="{Binding DevicesLine}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" Margin="18,14,18,8" />
        <ItemsControl ItemsSource="{Binding Devices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,8,18,10">
                <Border Classes="appicon small" Background="{DynamicResource ToneIndigo}" Margin="0,0,12,0" VerticalAlignment="Center"
                        IsVisible="{Binding Active}"><mi:MaterialIcon Kind="CellphoneCheck" /></Border>
                <Border Classes="appicon small" Background="{DynamicResource ToneNeutral}" Margin="0,0,12,0" VerticalAlignment="Center"
                        IsVisible="{Binding !Active}"><mi:MaterialIcon Kind="CellphoneOff" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" />
                </StackPanel>
                <Button infra:Icons.Lead="CellphoneRemove" Grid.Column="2" Classes="danger" Content="Retirer l'accès" Command="{Binding Revoke}" IsVisible="{Binding Active}"
                        VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button infra:Icons.Lead="Refresh" Classes="ghost" Content="Actualiser la liste" Command="{Binding LoadDevices}" HorizontalAlignment="Left" Margin="12,0,0,10" />
      </StackPanel>
    </Border>

    <!-- ===== Serveur : disponibilité de l'ordinateur principal ===== -->
    <TextBlock Text="Ordinateur principal" Classes="sectiontitle" IsVisible="{Binding IsServerComputer}" />
    <Border Classes="card" Padding="0" IsVisible="{Binding IsServerComputer}">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,16">
          <Border Classes="appicon medium" Background="{DynamicResource ToneNeutral}" Margin="0,0,14,0"><mi:MaterialIcon Kind="Power" /></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="Démarrer avec Windows" />
            <TextBlock Text="{Binding ServiceLine}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" IsChecked="{Binding ServiceInstalled, Mode=OneWay}"
                        Command="{Binding ToggleService}" IsEnabled="{Binding IsWindows}" ToolTip.Tip="Démarrer SCOLIA avec Windows" />
        </Grid>

        <!-- Les autres postes dépendent de cet ordinateur : il ne s'endort pas, même fenêtre réduite -->
        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="58,0,0,0" IsVisible="{Binding ShowAwake}" />
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,16" IsVisible="{Binding ShowAwake}">
          <Border Classes="appicon medium" Background="{DynamicResource ToneIndigo}" Margin="0,0,14,0"><mi:MaterialIcon Kind="WeatherNight" /></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="Toujours éveillé pour les autres postes" />
            <TextBlock Text="{Binding AwakeLine}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}"
                       Text="Un portable dont on ferme le couvercle s'endort quand même : choisissez « Ne rien faire » quand il est branché." />
          </StackPanel>
          <Button infra:Icons.Lead="PowerSettings" Grid.Column="2" Content="Options d'alimentation" Command="{Binding OpenPowerOptions}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
      </StackPanel>
    </Border>
    <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" IsVisible="{Binding IsServerWindows}"
               Text="À la première ouverture du partage, Windows demande une seule autorisation : SCOLIA ouvre son port et sa découverte dans le pare-feu (réseaux privés uniquement)." />

    <!-- ===== Serveur : rejoindre un autre serveur, rarement utile, donc replié ===== -->
    <Expander Header="Rejoindre un autre serveur" IsExpanded="False" IsVisible="{Binding IsServerComputer}" HorizontalAlignment="Stretch">
      <StackPanel Spacing="6" Margin="4,8">
        <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}"
                   Text="Pour travailler sur les données d'un autre ordinateur principal. Rejoindre ferme la session en cours ; les données de cet ordinateur restent intactes." />
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JoinActions}" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Scolia.Bureau.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:views="using:Scolia.Bureau.Views"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="Scolia.Bureau.Views.MainView"
             x:DataType="vm:ShellViewModel"
             KeyDown="OnKeyDown">
  <UserControl.Styles>
    <Style Selector="TransitioningContentControl#PageHost"><Setter Property="Margin" Value="20,8,20,16" /></Style>
    <!-- Barre d'action fixe : la page laisse sa place en bas pour ne rien cacher -->
    <Style Selector="TransitioningContentControl#PageHost.withsticky"><Setter Property="Margin" Value="20,8,20,92" /></Style>
    <!-- Notification : en bas à gauche sur l'ordinateur, au-dessus des onglets sur le téléphone -->
    <Style Selector="Border#Snackbar"><Setter Property="Margin" Value="24" /></Style>
    <Style Selector="LayoutTransformControl.phone Border#Snackbar">
      <Setter Property="Margin" Value="12,0,12,78" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- Fenêtre de dialogue sur le téléphone : presque tout l'écran, pour des champs lisibles -->
    <Style Selector="LayoutTransformControl.phone Border.scrim > ContentControl"><Setter Property="Margin" Value="12" /></Style>
    <!-- Indicateur de traitement : l'icône tourne tant que le traitement dure -->
    <Style Selector="mi|MaterialIcon.spin">
      <Setter Property="RenderTransform"><RotateTransform /></Setter>
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- La coque reste opaque et immobile. Seuls le message de bienvenue et le contenu des pages s'animent. -->

    <!-- Ouverture : fondu court, la barre avance en douceur -->
    <Style Selector="LayoutTransformControl.anim Grid#OpeningHost[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.25" Easing="CubicEaseOut" FillMode="Both">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="LayoutTransformControl.anim Grid#OpeningHost ProgressBar">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Value" Duration="0:0:0.35" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>

    <!-- Écran de connexion : il apparaît en fondu, la carte monte doucement -->
    <Style Selector="LayoutTransformControl.anim ContentControl#LoginHost[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.24" Easing="CubicEaseOut" FillMode="Both">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="6" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Boîtes de dialogue et indicateur : le voile se pose en fondu, la boîte arrive avec un léger zoom -->
    <Style Selector="LayoutTransformControl.anim Border.scrim[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.18" Easing="QuadraticEaseOut" FillMode="Both">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="LayoutTransformControl.anim Border.scrim[IsVisible=True] > ContentControl">
      <Style.Animations>
        <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Both">
          <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.96" /><Setter Property="ScaleTransform.ScaleY" Value="0.96" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="LayoutTransformControl.anim Border.working[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.2" FillMode="Both">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Trois points discrets : seule l'opacité varie, sans mesure ni déplacement du contenu. -->
    <Style Selector="Border.welcomedot">
      <Setter Property="Width" Value="6" /><Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" /><Setter Property="Opacity" Value="0.3" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="LayoutTransformControl.anim Grid#OpeningHost[IsVisible=True] Border.welcomedot.first">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.00" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="70%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="LayoutTransformControl.anim Grid#OpeningHost[IsVisible=True] Border.welcomedot.second">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.14" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="70%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="LayoutTransformControl.anim Grid#OpeningHost[IsVisible=True] Border.welcomedot.third">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.28" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="70%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Grid#OpeningHost TextBlock.title">
      <Setter Property="FontSize" Value="{DynamicResource FsTitle}" />
    </Style>
    <Style Selector="LayoutTransformControl.phone Grid#OpeningHost TextBlock.title">
      <Setter Property="FontSize" Value="22" />
    </Style>
  </UserControl.Styles>

  <!-- Toute l'interface suit la taille de la fenêtre : la mise en page de 1280 × 720, agrandie ou réduite d'un bloc -->
  <Grid RowDefinitions="Auto,*">
  <!-- Barre de titre de Windows dessinée par SCOLIA : bleu ciel comme le bandeau de la page, les trois boutons de la fenêtre à droite -->
  <Border x:Name="TitleRow" Classes="titlerow" Classes.onbrand="{Binding ShowLogin}" IsVisible="False" chrome:WindowDecorationProperties.ElementRole="TitleBar">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,150,0" VerticalAlignment="Center" IsHitTestVisible="False">
      <Image Source="{DynamicResource ScoliaMark}" Width="16" Height="16" VerticalAlignment="Center" />
      <TextBlock Text="SCOLIA Pro" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Text="·" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsLoggedIn}" />
      <TextBlock Text="{Binding SchoolTitle}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsLoggedIn}" />
    </StackPanel>
  </Border>
  <LayoutTransformControl x:Name="Scaler" Grid.Row="1" Classes.anim="{Binding Prefs.Animations}">
  <Grid>
    <!-- Détection de première installation : jamais afficher le formulaire de connexion
         avant de connaître l’état réel de configuration. -->
    <Border Background="{DynamicResource BgBrush}" IsVisible="{Binding ShowStartup}">
      <StackPanel MaxWidth="340" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Border Width="76" Height="76" CornerRadius="20" Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" HorizontalAlignment="Center">
          <Image Source="{DynamicResource ScoliaMark}" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="SCOLIA Pro" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Height="3" MinHeight="3" Width="164" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
    <!-- Connexion : seulement si l’établissement est déjà configuré -->
    <!-- Première installation : l'assistant remplace la connexion tant qu'aucune configuration n'existe -->
    <ContentControl Content="{Binding Setup}" IsVisible="{Binding ShowSetup}" />
    <ContentControl x:Name="LoginHost" Content="{Binding Login}" IsVisible="{Binding ShowLogin}">
      <ContentControl.RenderTransform><TranslateTransform /></ContentControl.RenderTransform>
    </ContentControl>
    <ContentControl Content="{Binding Connection}" IsVisible="{Binding ChoosingServer}" />

    <!-- Ouverture : logo, trois points discrets et progression avant l'accueil -->
    <Grid x:Name="OpeningHost" IsVisible="{Binding Opening}" Background="{DynamicResource BgBrush}">
      <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalAlignment="Center">
      <StackPanel x:Name="WelcomeContent" MaxWidth="320" Margin="24" HorizontalAlignment="Stretch" Spacing="12">
        <Border Width="92" Height="92" CornerRadius="24" Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" HorizontalAlignment="Center">
          <Image Source="{DynamicResource ScoliaMark}" Width="68" Height="68"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="SCOLIA Pro" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding OpeningTitle}" Classes="muted"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,2,0,2">
          <Border Classes="welcomedot first" /><Border Classes="welcomedot second" /><Border Classes="welcomedot third" />
        </StackPanel>
        <TextBlock Text="{Binding OpeningStep}" Classes="muted" HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="Wrap" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding OpeningProgress, Mode=OneWay}" Height="4" MinHeight="4" Margin="24,2,24,0" />
      </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="AppArea" IsVisible="{Binding ShowApp}">
      <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>

      <!-- Ordinateur : bandeau bleu, volet, page et barre d'état -->
      <Grid x:Name="DesktopArea" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*,Auto" IsVisible="{Binding !Phone}">

      <!-- Bandeau bleu ciel sur toute la largeur : volet, flèches, titre de la page, recherche, actions, réseau, compte, menu -->
      <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="pagebar appheader" x:Name="PageBar">
        <Grid ColumnDefinitions="Auto,Auto,2*,3*,Auto,Auto,Auto" IsVisible="{Binding HasPage}">
          <Button Classes="toolicon" Command="{Binding ToggleSidebarCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTip.Tip="Afficher ou masquer le volet (Ctrl+B)">
            <mi:MaterialIcon Kind="DockLeft" Width="18" Height="18" />
          </Button>
          <Border Grid.Column="1" Classes="navcapsule" VerticalAlignment="Center" Margin="0,0,14,0">
            <StackPanel Orientation="Horizontal">
              <Button Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="Précédent (Alt+Gauche)">
                <mi:MaterialIcon Kind="ChevronLeft" Width="20" Height="20" />
              </Button>
              <Rectangle Width="1" Height="16" Fill="{DynamicResource HeaderLineBrush}" VerticalAlignment="Center" />
              <Button Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="Suivant (Alt+Droite)">
                <mi:MaterialIcon Kind="ChevronRight" Width="20" Height="20" />
              </Button>
            </StackPanel>
          </Border>
          <Grid x:Name="HeaderTitle" Grid.Column="2" ColumnDefinitions="Auto,*" VerticalAlignment="Center" MinWidth="140" MaxWidth="300">
            <Border Classes="appicon medium" Background="{Binding CurrentIconBrush}" Margin="0,0,10,0">
              <mi:MaterialIcon Kind="{Binding CurrentIcon}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Current.Heading}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Current.Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
          <!-- Une seule recherche d'en-tête par métier : locale sur une liste, globale à l'accueil.
               Ctrl+K conserve toujours la palette globale, y compris sur desktop. -->
          <Button x:Name="HeaderSearch" Grid.Column="3" Classes="hdrsearch" Click="OnDesktopSearchClick"
                  IsVisible="{Binding !HeaderSearch.IsOpen}" ToolTip.Tip="{Binding HeaderSearch.SearchHint}"
                  HorizontalAlignment="Stretch" MaxWidth="440" MinWidth="180" Margin="18,0" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding HeaderSearch.Placeholder}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Border Grid.Column="2" Classes="keycap" Margin="8,0,0,0"><TextBlock Text="{Binding HeaderSearch.ShortcutText}" /></Border>
            </Grid>
          </Button>
          <Border Grid.Column="3" Background="{DynamicResource GroupBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="1" CornerRadius="12" Padding="8,0" MaxWidth="440" MinWidth="180"
                  Margin="18,0" VerticalAlignment="Center" IsVisible="{Binding HeaderSearch.IsOpen}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
              <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBox x:Name="DesktopContextSearchBox" Grid.Column="1"
                       Text="{Binding HeaderSearch.Query, Mode=TwoWay}"
                       PlaceholderText="{Binding HeaderSearch.Placeholder}"
                       BorderThickness="0" Background="Transparent"
                       KeyDown="OnDesktopContextSearchKeyDown" MinHeight="40" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="toolicon" Command="{Binding HeaderSearch.Clear}"
                      IsVisible="{Binding HeaderSearch.HasQuery}" ToolTip.Tip="Effacer le texte cherché" MinWidth="40" MinHeight="40">
                <mi:MaterialIcon Kind="CloseCircleOutline" Width="18" Height="18" />
              </Button>
              <Button Grid.Column="3" Classes="toolicon" Command="{Binding HeaderSearch.Close}"
                      ToolTip.Tip="Fermer le filtre de cette page" MinWidth="40" MinHeight="40">
                <mi:MaterialIcon Kind="Close" Width="18" Height="18" />
              </Button>
            </Grid>
          </Border>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
            <ItemsControl ItemsSource="{Binding Current.VisibleActions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="hdr" Command="{Binding Command}" Classes.primary="{Binding IsPrimary}" Classes.danger="{Binding Danger}" ToolTip.Tip="{Binding Hint}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <mi:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16" />
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="hdr" IsVisible="{Binding Current.HasMoreActions}" ToolTip.Tip="Plus d'actions" Padding="8,4">
              <mi:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight" ItemsSource="{Binding Current.MoreActions}">
                  <MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                      <Setter Property="Header" Value="{Binding Label}" />
                      <Setter Property="Command" Value="{Binding Command}" />
                      <Setter Property="ToolTip.Tip" Value="{Binding Hint}" />
                    </ControlTheme>
                  </MenuFlyout.ItemContainerTheme>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <!-- État du réseau et compte connecté : toujours visibles, à droite -->
          <StackPanel x:Name="HeaderExtras" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Margin="12,0,0,0">
            <Button Classes="toolicon" Command="{Binding NetworkCommand}" ToolTip.Tip="{Binding Sync.StatusText}">
              <Panel Width="18" Height="18">
                <mi:MaterialIcon Kind="LanConnect" Width="18" Height="18" IsVisible="{Binding Sync.Online}" />
                <mi:MaterialIcon Kind="CloudOffOutline" Width="18" Height="18" Foreground="{DynamicResource ToneOrange}" IsVisible="{Binding Sync.Offline}" />
                <Border Classes="livedot" Classes.pulse="{Binding Sync.Pulse}" IsVisible="{Binding Sync.Online}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" />
              </Panel>
            </Button>
            <Button Classes="accountchip" Click="OnAccountClick" ToolTip.Tip="Compte et poste">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentBrush}">
                  <TextBlock Text="{Binding UserInitials}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" />
                </Border>
                <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button Grid.Column="6" Classes="toolicon" Click="OnMenuClick" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Toutes les commandes">
            <mi:MaterialIcon Kind="Menu" Width="18" Height="18" />
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="1" Grid.Column="0" Classes="sidebar" Width="250" Margin="8,8,0,8" IsVisible="{Binding SidebarShown}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="10,12,10,6">
            <!-- L'établissement : son logo et son nom, en tête du volet -->
            <Grid ColumnDefinitions="Auto,*" Margin="4,0,4,4">
              <Image Source="{Binding SchoolLogo}" IsVisible="{Binding HasSchoolLogo}" Width="38" Height="38" Margin="0,0,10,0" VerticalAlignment="Center" />
              <Image Source="{DynamicResource ScoliaMark}" IsVisible="{Binding !HasSchoolLogo}" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding SchoolTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SchoolYearLine}" Classes="muted" FontSize="{DynamicResource FsCaption}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding NavigationBlocks}" Margin="10,4,10,12">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="6" Margin="0,6,0,8">
                    <TextBlock Text="{Binding Title}" Classes="navblocktitle" />
                    <ItemsControl ItemsSource="{Binding Groups}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <!-- Une seule surface arrondie par rubrique : titre joint aux outils. -->
                          <Border Classes="navaccordion" Margin="0,0,0,5">
                            <StackPanel Spacing="0">
                              <Button Classes="navcategory" IsVisible="{Binding HasTitle}" Command="{Binding Toggle}" ToolTip.Tip="{Binding Title}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                  <Border Classes="appicon" Background="{Binding Brush}">
                                    <mi:MaterialIcon Kind="{Binding Icon}" />
                                  </Border>
                                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  <mi:MaterialIcon Grid.Column="2" Kind="ChevronDown" Width="16" Height="16" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding !IsExpanded}" />
                                  <mi:MaterialIcon Grid.Column="2" Kind="ChevronUp" Width="16" Height="16" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding IsExpanded}" />
                                </Grid>
                              </Button>
                              <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}" Margin="0,0,0,5">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Button Classes="navitem" Classes.selected="{Binding IsSelected}" Command="{Binding Open}"
                                            Margin="0" HorizontalContentAlignment="Stretch">
                                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Classes="appicon" Background="{Binding Brush}">
                                          <mi:MaterialIcon Kind="{Binding Icon}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                                      </Grid>
                                    </Button>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Contenu de la page -->
      <Grid Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasPage}">
        <!-- Sur téléphone, la page entière défile ; sur l'ordinateur, chaque page garde sa hauteur et ses tableaux défilent -->
        <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="{Binding PageScroll}">
          <TransitioningContentControl x:Name="PageHost" Content="{Binding DesktopPage}"
                                       Classes.withsticky="{Binding Current.Sticky.IsVisible, FallbackValue=False}" />
        </ScrollViewer>
        <!-- Barre d'action fixe de la page : le total et le bouton qui valide, toujours visibles en bas -->
        <Border Classes="stickybar" VerticalAlignment="Bottom" IsVisible="{Binding Current.Sticky.IsVisible, FallbackValue=False}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding Current.Sticky.Title}" Classes="muted" FontSize="{DynamicResource FsSmall}" />
              <TextBlock Text="{Binding Current.Sticky.Value}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Current.Sticky.Detail}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Current.Sticky.HasDetail, FallbackValue=False}" />
            </StackPanel>
            <Button x:Name="DesktopStickyAction" Grid.Column="1" Classes="primary stickyaction" Command="{Binding Current.Sticky.Command}"
                    IsEnabled="{Binding Current.Sticky.CanRun, FallbackValue=False}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="CheckCircleOutline" Width="20" Height="20" />
                <TextBlock Text="{Binding Current.Sticky.Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Des données ont changé sur un autre poste pendant une saisie : la page attend qu'on le demande -->
        <Button Classes="remotechip" Command="{Binding ApplyRemoteCommand}" IsVisible="{Binding RemoteWaiting}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="ArrowDownBoldCircleOutline" Width="16" Height="16" />
            <TextBlock Text="Nouvelles données d'un autre poste · Afficher" />
          </StackPanel>
        </Button>
      </Grid>
      <ProgressBar Grid.Row="1" Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding Current.Busy}" VerticalAlignment="Top" Height="2" MinHeight="2" />

      <!-- Barre d'état : statut, serveur, zoom -->
      <Border x:Name="DesktopStatusBar" Grid.Row="2" Grid.ColumnSpan="2" Classes="statusbar" IsVisible="{Binding ShowStatusBar}">
        <Grid ColumnDefinitions="*,2*,*,Auto">
          <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <!-- Direct : autres postes, activité qui vient d'avoir lieu ailleurs, ou travail hors ligne -->
          <Button Grid.Column="1" Classes="ghost" Padding="8,0" MinHeight="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding NetworkCommand}" ToolTip.Tip="Réseau et activité" Margin="0,0,16,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
              <Panel Width="15" Height="15">
              <Border Classes="livedot" Classes.pulse="{Binding Sync.Pulse}" VerticalAlignment="Center" IsVisible="{Binding Sync.Online}" />
              <mi:MaterialIcon Kind="CloudOffOutline" Width="15" Height="15" Foreground="{DynamicResource ToneOrange}" IsVisible="{Binding Sync.Offline}" />
              </Panel>
              <TextBlock Grid.Column="1" Text="{Binding Sync.Ticker}" IsVisible="{Binding Sync.HasTicker}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Sync.StatusText}" Foreground="{Binding Sync.StatusBrush}" IsVisible="{Binding !Sync.HasTicker}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding Sync.PeersText}" Classes="muted" IsVisible="{Binding Sync.HasPeers}" VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <TextBlock x:Name="DesktopServerLine" Text="{Binding ServerLine}" Classes="muted" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ServerLine}" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
            <!-- Bascule rapide du thème clair au thème sombre -->
            <Button Classes="ghost" Padding="6,0" MinHeight="0" Click="OnThemeToggle" ToolTip.Tip="Thème clair ou sombre" Margin="0,0,10,0">
              <mi:MaterialIcon x:Name="ThemeIcon" Kind="WeatherNight" Width="15" Height="15" />
            </Button>
            <Button Classes="ghost" Padding="4,0" MinHeight="0" Click="OnZoomOut" Content="−" />
            <TextBlock Text="{Binding Prefs.ZoomLabel}" Classes="muted" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" />
            <Button Classes="ghost" Padding="4,0" MinHeight="0" Click="OnZoomIn" Content="+" />
          </StackPanel>
        </Grid>
      </Border>
      </Grid>

      <!-- Téléphone : son propre cadre, avec ses onglets en bas et ses pages dessinées pour le petit écran -->
      <views:PhoneFrame IsVisible="{Binding Phone}" />

      <!-- Compte et réglages du poste : couvre la fenêtre -->
      <ContentControl Content="{Binding Backstage}" IsVisible="{Binding BackstageOpen}" Background="{DynamicResource BgBrush}" />

      <!-- Notification discrète, en bas -->
      <Border x:Name="Snackbar" Classes="snackbar" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding HasNotice}" IsHitTestVisible="False">
        <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource BgBrush}" TextWrapping="Wrap" />
      </Border>

      <!-- Boîte de dialogue modale : elle couvre toute la fenêtre -->
      <Border Classes="scrim" IsVisible="{Binding HasDialog}">
        <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" RenderTransformOrigin="50%,50%">
          <ContentControl.RenderTransform><ScaleTransform /></ContentControl.RenderTransform>
        </ContentControl>
      </Border>

      <!-- Traitement qui dure : un indicateur au centre, la fenêtre reste visible mais n'accepte pas de second clic -->
      <Border Classes="working" Background="#14000000" IsVisible="{Binding Working}">
        <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,16" BoxShadow="0 8 28 0 #33000000">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <mi:MaterialIcon Kind="Loading" Classes="spin" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Traitement en cours…" VerticalAlignment="Center" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Grid>
  </LayoutTransformControl>
  <!-- Changement de thème : l'ancien rendu s'efface en fondu au-dessus du nouveau -->
  <Image x:Name="ThemeFade" Grid.Row="1" IsHitTestVisible="False" IsVisible="False" Stretch="Fill" />
  </Grid>
</UserControl>

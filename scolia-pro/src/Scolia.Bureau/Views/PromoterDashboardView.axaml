<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:vm="using:Scolia.Bureau.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.PromoterDashboardView"
             x:DataType="vm:PromoterDashboardPage">
  <UserControl.Resources>
    <!-- Un mois : nom, reste à payer, barre de ce qui est réglé, et l'argent entré pendant le mois. -->
    <DataTemplate x:Key="PeriodRow" x:DataType="vm:PromoterPeriodRowVm">
      <Border Padding="10,8" CornerRadius="10" Margin="0,0,0,4" Background="{DynamicResource GroupBrush}">
        <StackPanel Spacing="5">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding Period}" FontWeight="SemiBold" />
              <Border IsVisible="{Binding IsCurrent}" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="6,1">
                <TextBlock Text="en cours" FontSize="{DynamicResource FsSmall}" Foreground="{DynamicResource AccentBrush}" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <mi:MaterialIcon Kind="CheckCircle" Width="15" Height="15" Foreground="{DynamicResource ToneGreen}" IsVisible="{Binding IsSettled}" />
              <TextBlock Text="Réglé" FontWeight="SemiBold" Foreground="{DynamicResource ToneGreen}" IsVisible="{Binding IsSettled}" />
              <TextBlock Text="Reste" Classes="muted" IsVisible="{Binding !IsSettled}" />
              <TextBlock Text="{Binding Remaining}" FontWeight="SemiBold" IsVisible="{Binding !IsSettled}" />
            </StackPanel>
          </Grid>
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding PaidShare, Mode=OneWay}" Height="5" MinHeight="5" CornerRadius="3" />
          <WrapPanel>
            <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" Margin="0,0,12,0">
              <Run Text="Réglé" /> <Run Text="{Binding Paid, Mode=OneWay}" /> <Run Text="sur" /> <Run Text="{Binding Due, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" IsVisible="{Binding HasCollected}">
              <Run Text="Encaissé pendant le mois :" /> <Run Text="{Binding Collected, Mode=OneWay}" />
            </TextBlock>
          </WrapPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14" Margin="4,6,4,18">
      <!-- En-tête : ce qu'est cet écran, et l'heure des chiffres -->
      <Border Classes="card" Padding="16">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="appicon medium" Background="{DynamicResource ToneIndigo}" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="ViewDashboardOutline" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="4">
            <WrapPanel>
              <TextBlock Text="Pilotage de l'établissement" FontWeight="SemiBold" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
              <Border Background="{DynamicResource GroupBrush}" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <mi:MaterialIcon Kind="EyeOutline" Width="13" Height="13" />
                  <TextBlock Text="Lecture seule" FontSize="{DynamicResource FsSmall}" />
                </StackPanel>
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding AsOf}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="Chiffres consolidés, sans dossiers ni informations nominatives."
                       Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Point d'attention : l'argent exigible non réglé -->
      <Border Classes="guide" IsVisible="{Binding HasAttention}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <mi:MaterialIcon Kind="AlertCircleOutline" Width="20" Height="20" VerticalAlignment="Top" Foreground="{DynamicResource ToneOrange}" />
          <TextBlock Grid.Column="1" Text="{Binding Attention}" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <!-- Six chiffres clés : trois colonnes sur ordinateur, deux sur téléphone -->
      <ItemsControl ItemsSource="{Binding Kpis}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" infra:Adaptive.MinItemWidth="150" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PromoterKpiVm">
            <Border Classes="card" Padding="14" Margin="0,0,10,10">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBlock Text="{Binding Label}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="appicon" Background="{Binding Brush}" VerticalAlignment="Top">
                    <mi:MaterialIcon Kind="{Binding Icon}" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Établissement, mois par mois : replié pour garder l'écran lisible -->
      <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="14">
          <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="CalendarMonthOutline" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Établissement · mois par mois" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Expander.Header>
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap"
                       Text="Barre : part réglée des frais du mois. « Encaissé pendant le mois » suit la date des reçus." />
            <ItemsControl ItemsSource="{Binding SchoolPeriods}" ItemTemplate="{StaticResource PeriodRow}" />
          </StackPanel>
        </Expander>

      <TextBlock Text="Situation par promotion" Classes="heading" FontWeight="SemiBold" IsVisible="{Binding HasPromotions}" />
      <ItemsControl ItemsSource="{Binding Promotions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PromoterPromotionRowVm">
            <Border Classes="card" Padding="14" Margin="0,0,0,12">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Code}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Name}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="14" Padding="10,6" VerticalAlignment="Top">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Students}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                      <TextBlock Text="inscrits" Classes="muted" FontSize="{DynamicResource FsSmall}" />
                    </StackPanel>
                  </Border>
                </Grid>

                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding YearShareText}" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                      <mi:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="{DynamicResource ToneOrange}" IsVisible="{Binding HasLate}" />
                      <TextBlock Text="{Binding LateDebtors}" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding YearShare, Mode=OneWay}" Height="8" MinHeight="8" CornerRadius="4" />
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <StackPanel>
                    <TextBlock Text="Encaissé aujourd'hui" Classes="muted" FontSize="{DynamicResource FsSmall}" />
                    <TextBlock Text="{Binding CollectedToday}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Encaissé ce mois" Classes="muted" FontSize="{DynamicResource FsSmall}" />
                    <TextBlock Text="{Binding CollectedMonth}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Row="1">
                    <TextBlock Text="Reste à percevoir" Classes="muted" FontSize="{DynamicResource FsSmall}" />
                    <TextBlock Text="{Binding Outstanding}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="Déjà exigible" Classes="muted" FontSize="{DynamicResource FsSmall}" />
                    <TextBlock Text="{Binding Overdue}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource ToneOrange}" IsVisible="{Binding HasOverdue}" />
                    <TextBlock Text="Rien" FontWeight="SemiBold" Foreground="{DynamicResource ToneGreen}" IsVisible="{Binding !HasOverdue}" />
                  </StackPanel>
                </Grid>

                <Expander Background="Transparent" BorderThickness="0" Padding="0,6,0,0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Expander.Header>
                    <TextBlock Text="Détail par mois" FontWeight="SemiBold" />
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding Periods}" ItemTemplate="{StaticResource PeriodRow}" />
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>

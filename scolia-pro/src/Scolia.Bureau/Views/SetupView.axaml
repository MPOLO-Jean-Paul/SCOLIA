<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.SetupView">
  <!-- Première installation : assistant en deux étapes, centré, adapté à toute taille de fenêtre -->
  <Grid Background="{DynamicResource BgBrush}">
    <ScrollViewer>
      <Border Classes="card" Padding="28" Margin="24" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Image Source="{DynamicResource ScoliaMark}" Width="44" Height="44" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Configurer SCOLIA" Classes="title" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Première connexion sur ce poste. Ces réglages se modifient ensuite dans Paramètres, depuis le compte secrétariat." />
            </StackPanel>
          </StackPanel>

          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" />
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding StepLabel}" Classes="muted" FontSize="{DynamicResource FsSmall}" />
            <TextBlock Text="{Binding StepTitle}" Classes="heading" />
          </StackPanel>

          <!-- Étape 1 : établissement et année -->
          <StackPanel IsVisible="{Binding IsStepOne}" Spacing="14">
            <WrapPanel ItemWidth="320">
              <StackPanel Margin="0,0,16,12" Spacing="4">
                <TextBlock Text="Nom de l'établissement" Classes="muted" />
                <TextBox Text="{Binding SchoolName}" PlaceholderText="Institut technique médical" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12" Spacing="4">
                <TextBlock Text="Sigle" Classes="muted" />
                <TextBox Text="{Binding ShortName}" PlaceholderText="ITM" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12" Spacing="4">
                <TextBlock Text="Ville" Classes="muted" />
                <TextBox Text="{Binding City}" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12" Spacing="4">
                <TextBlock Text="Téléphone" Classes="muted" />
                <TextBox Text="{Binding Phone}" infra:PhoneInput.Digits="True" PlaceholderText="10 chiffres, ex. 0812345678" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12" Spacing="4">
                <TextBlock Text="Année scolaire" Classes="muted" />
                <TextBox Text="{Binding YearLabel}" PlaceholderText="2026 - 2027" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12" Spacing="4">
                <TextBlock Text="Premier mois de paiement" Classes="muted" />
                <ComboBox ItemsSource="{Binding StartMonths}" SelectedItem="{Binding StartMonth}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12" Spacing="4">
                <TextBlock Text="Durée de l'année" Classes="muted" />
                <ComboBox ItemsSource="{Binding MonthCounts}" SelectedItem="{Binding MonthCount}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </WrapPanel>
            <!-- Logo de l'établissement : il figure sur la connexion, les reçus, les listes et les cartes d'accès -->
            <StackPanel Spacing="8">
              <TextBlock Text="Logo de l'établissement" Classes="heading" />
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="64" Height="64" CornerRadius="12" Background="{DynamicResource Surface2Brush}" Margin="0,0,14,0">
                    <Panel>
                      <Image Source="{Binding Logo}" IsVisible="{Binding HasLogo}" Width="56" Height="56" />
                      <mi:MaterialIcon Kind="ImageOutline" Width="26" Height="26" IsVisible="{Binding !HasLogo}" Foreground="{DynamicResource MutedBrush}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding LogoLine}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Image PNG ou JPEG, de préférence carrée." Classes="muted" FontSize="{DynamicResource FsSmall}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="ghost" Content="Retirer" Command="{Binding ClearLogo}" IsVisible="{Binding HasLogo}" />
                    <Button Command="{Binding PickLogo}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="ImagePlusOutline" Width="16" Height="16" />
                        <TextBlock Text="Choisir le logo" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>

            <!-- Promotions : comme le paramétrage de la version 79, un code de 4 caractères et la mensualité -->
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="Promotions" Classes="heading" />
                  <TextBlock Text="Code de 4 caractères, par exemple INF1 : il commence chaque matricule. D'autres promotions s'ajoutent ensuite dans Paramètres."
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{Binding AddPromotion}" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                    <TextBlock Text="Ajouter une promotion" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="110,*,150,40" Margin="0,0,0,2">
                    <TextBlock Text="Code" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="Désignation" Classes="muted" Margin="10,0,0,0" />
                    <TextBlock Grid.Column="2" Text="Mensualité (FC)" Classes="muted" Margin="10,0,0,0" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Promotions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="110,*,150,40" Margin="0,0,0,6">
                          <TextBox Text="{Binding Code}" PlaceholderText="INF1" MaxLength="4" />
                          <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="Première année" Margin="10,0,0,0" />
                          <TextBox Grid.Column="2" Text="{Binding Fee}" PlaceholderText="55000" Margin="10,0,0,0" />
                          <Button Grid.Column="3" Classes="toolicon" Command="{Binding Remove}" ToolTip.Tip="Retirer cette promotion" HorizontalAlignment="Right">
                            <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="4">
              <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="Devise de l'établissement (facultatif)" Classes="muted" />
                <TextBox Text="{Binding Motto}" PlaceholderText="Savoir, discipline, service" />
              </StackPanel>
              <TextBlock Text="{Binding CurrencyLine}" Classes="muted" />
              <CheckBox IsChecked="{Binding LoadDemo}" Content="Charger des données de démonstration fictives, pour découvrir SCOLIA" Margin="0,8,0,0" />
            </StackPanel>
          </StackPanel>

          <!-- Étape 2 : comptes et sécurité -->
          <StackPanel IsVisible="{Binding IsStepTwo}" Spacing="18">
            <StackPanel Spacing="10">
              <TextBlock Text="Secrétariat" Classes="heading" />
              <TextBlock Text="C'est le compte administrateur : apprenants, encaissements, scolarité, et aussi tout le paramétrage, les utilisateurs et les sauvegardes. Gardez son mot de passe en lieu sûr." Classes="muted" TextWrapping="Wrap" />
              <WrapPanel ItemWidth="320">
                <StackPanel Margin="0,0,16,12" Spacing="4"><TextBlock Text="Identifiant" Classes="muted" /><TextBox Text="{Binding AdminUserName}" /></StackPanel>
                <StackPanel Margin="0,0,16,12" Spacing="4"><TextBlock Text="Nom de la personne" Classes="muted" /><TextBox Text="{Binding AdminDisplayName}" /></StackPanel>
                <StackPanel Margin="0,0,16,12" Spacing="4"><TextBlock Text="Mot de passe" Classes="muted" /><TextBox Text="{Binding AdminPassword}" PasswordChar="•" /></StackPanel>
                <StackPanel Margin="0,0,16,12" Spacing="4"><TextBlock Text="Confirmer le mot de passe" Classes="muted" /><TextBox Text="{Binding AdminConfirm}" PasswordChar="•" /></StackPanel>
              </WrapPanel>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="Comptabilité" Classes="heading" />
              <TextBlock Text="Facultatif. Encaisse, tient la caisse, enregistre les dépenses, consulte le journal et les rapports. Ne touche pas au paramétrage." Classes="muted" TextWrapping="Wrap" />
              <CheckBox IsChecked="{Binding UseComptabilite}" Content="Créer le compte comptabilité" />
              <WrapPanel ItemWidth="320" IsEnabled="{Binding UseComptabilite}">
                <StackPanel Margin="0,0,16,12" Spacing="4"><TextBlock Text="Identifiant" Classes="muted" /><TextBox Text="{Binding ComptabiliteUserName}" /></StackPanel>
                <StackPanel Margin="0,0,16,12" Spacing="4"><TextBlock Text="Nom de la personne" Classes="muted" /><TextBox Text="{Binding ComptabiliteDisplayName}" /></StackPanel>
                <StackPanel Margin="0,0,16,12" Spacing="4"><TextBlock Text="Mot de passe" Classes="muted" /><TextBox Text="{Binding ComptabilitePassword}" PasswordChar="•" /></StackPanel>
                <StackPanel Margin="0,0,16,12" Spacing="4"><TextBlock Text="Confirmer le mot de passe" Classes="muted" /><TextBox Text="{Binding ComptabiliteConfirm}" PasswordChar="•" /></StackPanel>
              </WrapPanel>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ToneRed}" TextWrapping="Wrap" />

          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Classes="ghost" Content="Retour" Command="{Binding Back}" IsVisible="{Binding IsStepTwo}" IsEnabled="{Binding !Busy}" />
            <Button Grid.Column="0" Classes="ghost" Content="Rejoindre un SCOLIA existant sur le réseau" Command="{Binding JoinExisting}" IsVisible="{Binding IsStepOne}" />
            <Button Grid.Column="2" Classes="primary" Command="{Binding Next}" IsVisible="{Binding IsStepOne}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Suivant" />
                <mi:MaterialIcon Kind="ArrowRight" Width="18" Height="18" Foreground="{DynamicResource OnAccentBrush}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="primary" Command="{Binding Finish}" IsVisible="{Binding IsStepTwo}" IsEnabled="{Binding !Busy}" Content="Terminer la configuration" />
          </Grid>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>

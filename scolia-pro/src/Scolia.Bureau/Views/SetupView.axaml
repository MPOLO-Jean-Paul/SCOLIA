<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.SetupView">
  <UserControl.Styles>
    <!-- Champ de l'assistant : libellé court au-dessus, champ dessous, peu d'espace entre les deux -->
    <Style Selector="StackPanel.field"><Setter Property="Spacing" Value="3" /></Style>
    <Style Selector="StackPanel.field > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
      <Setter Property="FontSize" Value="{DynamicResource FsSmall}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Fenêtre moyenne : bandeau plus étroit, le formulaire garde la place utile. -->
    <Style Selector="Border.setupband"><Setter Property="Width" Value="290" /></Style>
    <Style Selector="Grid.medium Border.setupband"><Setter Property="Width" Value="225" /></Style>
    <Style Selector="Grid.medium Grid.setupform"><Setter Property="Margin" Value="22,22,22,18" /></Style>
    <Style Selector="TextBlock.section">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource FsHeading}" />
    </Style>
    <!-- Étapes du bandeau : une pastille numérotée, blanche pour l'étape en cours -->
    <Style Selector="Border.stepdot">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="#9DBDF0" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="Border.stepdot.on">
      <Setter Property="Background" Value="#1769E6" />
      <Setter Property="BorderBrush" Value="#1769E6" />
    </Style>
    <Style Selector="Border.stepdot > TextBlock">
      <Setter Property="Foreground" Value="#1769E6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.stepdot.on > TextBlock"><Setter Property="Foreground" Value="White" /></Style>
    <!-- Champs et boutons arrondis du style iOS, comme la page de connexion. -->
    <Style Selector="TextBox.w11"><Setter Property="MinHeight" Value="40" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="40" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Button.primary"><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="CheckBox TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Button.profileChoice">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MinHeight" Value="76" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.profileChoice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Première installation, style iOS clair comme la connexion : un bandeau doux à gauche, le formulaire à droite.
       Tout tient sur un écran de 1366 × 768 sans défiler ; une fenêtre plus petite garde le défilement. -->
  <Grid x:Name="SetupRoot">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#D9E7FF" />
        <GradientStop Offset="0.48" Color="#BAD2FA" />
        <GradientStop Offset="1" Color="#9CBDEE" />
      </LinearGradientBrush>
    </Grid.Background>
    <!-- Accueil de première utilisation : langage visuel de l'espace de travail Power BI. -->
    <Grid IsVisible="{Binding IsChoosingInstitution}" Background="{DynamicResource SurfaceBrush}" ColumnDefinitions="Auto,*">
      <Border Classes="setupband" Background="{DynamicResource GroupBrush}" Padding="24,30" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <StackPanel Spacing="18">
          <Image Source="{DynamicResource ScoliaMark}" Width="48" Height="48" HorizontalAlignment="Left" />
          <TextBlock Text="SCOLIA Pro" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Première utilisation" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="Créer un établissement" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
          <Button Classes="ghost" Command="{Binding JoinExisting}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <TextBlock Text="Rejoindre un établissement" TextWrapping="Wrap" />
          </Button>
          <TextBlock Text="Déjà configuré sur un autre poste ? Rejoignez son serveur au lieu de créer une nouvelle école." Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,30,30,24" Spacing="18" MaxWidth="1060">
          <TextBlock Text="ACCUEIL / PREMIÈRE CONFIGURATION" Classes="muted" FontSize="11" FontWeight="SemiBold" />
          <TextBlock Text="Bienvenue dans SCOLIA Pro" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Choisissez le type de votre établissement pour commencer. SCOLIA adapte ensuite les paramètres et le vocabulaire à votre activité." Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="Créer un établissement" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12" infra:Adaptive.StackBelow="520">
            <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="ItmIm" Grid.Row="0" Grid.Column="0">
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="ITM / IEM" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Instituts techniques médicaux et d'enseignement médical" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
            <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="Maternelle" Grid.Row="0" Grid.Column="1">
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="École maternelle" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Enseignement préscolaire" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
            <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="Primaire" Grid.Row="1" Grid.Column="0">
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="École primaire" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Classes et suivi des élèves" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
            <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="Secondaire" Grid.Row="1" Grid.Column="1">
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="École secondaire / technique" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Humanités, options et filières techniques" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
            <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="ComplexeScolaire" Grid.Row="2" Grid.Column="0">
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Complexe scolaire" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Plusieurs cycles dans un même établissement" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
            <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="SuperieurLmd" Grid.Row="2" Grid.Column="1">
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Université / institut supérieur" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Enseignement supérieur et système LMD" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
          </Grid>
          <Border Background="{DynamicResource GroupBrush}" CornerRadius="8" Padding="14">
            <TextBlock Text="1. Choix du type   •   2. Établissement et calendrier   •   3. Comptes et sécurité" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <ScrollViewer IsVisible="{Binding !IsChoosingInstitution}" HorizontalScrollBarVisibility="Disabled">
      <Border Margin="14" MaxWidth="1180" MinHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False">
        <Grid ColumnDefinitions="Auto,*">

          <!-- Bandeau : marque, étapes, aide, sur un fond bleu très clair -->
          <Border Classes="setupband" BorderThickness="0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#B8D0F5" />
                <GradientStop Offset="1" Color="#D9E7FF" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid RowDefinitions="Auto,*,Auto" Margin="26,28,24,22">
              <StackPanel Spacing="14">
                <Border Width="58" Height="58" CornerRadius="18" Background="White" HorizontalAlignment="Left"
                        BorderBrush="#D6E2F5" BorderThickness="1" BoxShadow="0 8 20 0 #160D459B">
                  <Image Source="{DynamicResource ScoliaMark}" Width="36" Height="36" />
                </Border>
                <StackPanel Spacing="4">
                  <TextBlock Text="Bienvenue dans SCOLIA Pro" Foreground="#102A52" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                  <TextBlock Text="Trois étapes pour préparer votre établissement sur ce poste." Foreground="#41618D" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Row="1" Spacing="18" Margin="0,34,0,0">
                <StackPanel Spacing="4"><TextBlock Text="1 · Type choisi" Foreground="#16396D" FontWeight="SemiBold" /><TextBlock Text="{Binding ProfileLabel}" Foreground="#41618D" TextWrapping="Wrap" /></StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <Border Classes="stepdot" Classes.on="{Binding IsStepOne}"><TextBlock Text="2" /></Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="1">
                    <TextBlock Text="Établissement" Foreground="#16396D" FontWeight="SemiBold" />
                    <TextBlock Text="Nom, logo, année, promotions" Foreground="#5B7AA6" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                  <Border Classes="stepdot" Classes.on="{Binding IsStepTwo}"><TextBlock Text="3" /></Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="1">
                    <TextBlock Text="Comptes" Foreground="#16396D" FontWeight="SemiBold" />
                    <TextBlock Text="Secrétariat et comptabilité" Foreground="#5B7AA6" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <Border Grid.Row="2" Background="White" BorderBrush="#D6E2F5" BorderThickness="1" CornerRadius="16" Padding="14,12">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16" Foreground="#1769E6" />
                    <TextBlock Text="Paramètres modifiables" Foreground="#16396D" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Foreground="#41618D" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap"
                             Text="Le profil pédagogique est fixé lors de l’installation. Les autres paramètres restent modifiables ensuite." />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- Formulaire -->
          <Grid Grid.Column="1" Classes="setupform" RowDefinitions="Auto,*,Auto" Margin="30,26,30,20">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding StepLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="{DynamicResource FsSmall}" />
                  <TextBlock Text="{Binding StepTitle}" Classes="title" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" MinHeight="4" />
            </StackPanel>

            <!-- Étape 1 : établissement, année, promotions -->
            <StackPanel Grid.Row="1" IsVisible="{Binding IsStepOne}" Spacing="14" Margin="0,16,0,0">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Logo : une vignette cliquable à côté de l'identité de l'établissement -->
                <StackPanel Spacing="6" Margin="0,0,18,0" Width="112">
                  <Button Command="{Binding PickLogo}" Width="112" Height="112" Padding="0" CornerRadius="16"
                          Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Choisir le logo : toute image (PNG, JPEG, WebP, SVG, photo…), de préférence carrée.">
                    <Panel>
                      <Image Source="{Binding Logo}" IsVisible="{Binding HasLogo}" Width="96" Height="96" />
                      <StackPanel IsVisible="{Binding !HasLogo}" Spacing="4" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="ImagePlusOutline" Width="28" Height="28" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Logo" HorizontalAlignment="Center" Foreground="{DynamicResource Text2Brush}" />
                      </StackPanel>
                    </Panel>
                  </Button>
                  <TextBlock Text="{Binding LogoLine}" Classes="muted" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" TextAlignment="Center" MaxHeight="44" />
                  <Button infra:Icons.Lead="ImageOff" Classes="ghost small" Content="Retirer le logo" Command="{Binding ClearLogo}" IsVisible="{Binding HasLogo}" HorizontalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Column="1" ColumnDefinitions="2*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                  <StackPanel Classes="field" Grid.ColumnSpan="2">
                    <TextBlock Text="Nom de l'établissement" />
                    <TextBox Classes="w11" Text="{Binding SchoolName}" PlaceholderText="Nom officiel" />
                  </StackPanel>
                  <StackPanel Classes="field" Grid.Column="2">
                    <TextBlock Text="Sigle" />
                    <TextBox Classes="w11" Text="{Binding ShortName}" PlaceholderText="Sigle" />
                  </StackPanel>
                  <StackPanel Classes="field" Grid.Row="1">
                    <TextBlock Text="Devise (facultatif)" />
                    <TextBox Classes="w11" Text="{Binding Motto}" PlaceholderText="Savoir, discipline, service" />
                  </StackPanel>
                  <StackPanel Classes="field" Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="Ville" />
                    <TextBox Classes="w11" Text="{Binding City}" PlaceholderText="Kinshasa" />
                  </StackPanel>
                  <StackPanel Classes="field" Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="Téléphone" />
                    <TextBox Classes="w11" Text="{Binding Phone}" infra:PhoneInput.Digits="True" PlaceholderText="0812345678" />
                  </StackPanel>
                </Grid>
              </Grid>

              <!-- Profil pédagogique et régime juridique : deux choix indépendants. -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12" infra:Adaptive.StackBelow="640">
                <StackPanel Classes="field" Spacing="4">
                  <TextBlock Text="Type d'établissement" />
                  <TextBlock Text="{Binding ProfileLabel}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding ProfileHint}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="field" Spacing="4">
                  <TextBlock Text="Régime de l'établissement" />
                  <ComboBox ItemsSource="{Binding GovernanceTypes}" SelectedItem="{Binding Governance}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Grid>
              <TextBlock Text="Public : les frais ne sont pas activés sans base réglementaire vérifiée. Les bulletins pédagogiques demeurent non officiels jusqu'à validation des modèles applicables."
                         Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" />

              <Border IsVisible="{Binding IsComplexSchool}" Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12">
  <StackPanel Spacing="6">
    <TextBlock Text="Cycles du complexe scolaire" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="Sélectionnez au moins deux cycles. Aucun tarif n'est créé automatiquement." Classes="muted" TextWrapping="Wrap" />
    <CheckBox IsChecked="{Binding IncludeMaternelle}" Content="Maternelle" />
    <CheckBox IsChecked="{Binding IncludePrimaire}" Content="Primaire" />
    <CheckBox IsChecked="{Binding IncludeSecondaire}" Content="Secondaire" />
  </StackPanel>
</Border>
              <!-- Calendrier scolaire : choix explicites du début, de la fin et du dernier jour autorisé. -->
              <StackPanel Spacing="10">
                <TextBlock Text="Année scolaire et paiements" Classes="section" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" infra:Adaptive.StackBelow="700">
                  <StackPanel Classes="field">
                    <TextBlock Text="Année" />
                    <TextBox Classes="w11" Text="{Binding YearLabel}" PlaceholderText="2026-2027" />
                  </StackPanel>
                  <StackPanel Classes="field" Grid.Column="1">
                    <TextBlock Text="Premier mois à encaisser" />
                    <ComboBox ItemsSource="{Binding StartMonths}" SelectedItem="{Binding StartMonth}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Classes="field" Grid.Column="2">
                    <TextBlock Text="Dernier mois à encaisser" />
                    <ComboBox ItemsSource="{Binding EndMonths}" SelectedItem="{Binding EndMonth}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,2*" ColumnSpacing="12" infra:Adaptive.StackBelow="580">
                  <StackPanel Classes="field">
                    <TextBlock Text="Dernier jour sans retard (mois suivant)" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding PaymentDeadlineDays}" SelectedItem="{Binding LastOnTimeDay}"
                              HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="12,10">
                    <TextBlock Text="{Binding MonthRangeSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </Border>
                </Grid>
                <TextBlock Text="Exemple : octobre peut être payé jusqu'au 5 novembre ; l'apprenant est en retard dès le 6 novembre."
                           Classes="muted" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Promotions : un code de 4 caractères et la mensualité ; la liste défile au-delà de trois -->
              <StackPanel Spacing="8" IsVisible="{Binding ShowPromotionEditor}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding PromotionHeading}" Classes="section" />
                    <TextBlock Text="Le code identifie la classe ou la promotion. Le matricule affiché reste le code anonyme." Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{Binding AddPromotion}" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                      <TextBlock Text="Ajouter" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="12,8">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="96,*,150,36" ColumnSpacing="10">
                      <TextBlock Text="Code" Classes="muted" FontSize="{DynamicResource FsSmall}" />
                      <TextBlock Grid.Column="1" Text="Désignation" Classes="muted" FontSize="{DynamicResource FsSmall}" />
                      <TextBlock Grid.Column="2" Text="{Binding FeeHeading}" Classes="muted" FontSize="{DynamicResource FsSmall}" />
                    </Grid>
                    <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding Promotions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,0,0,6" Spacing="4">
                              <Grid ColumnDefinitions="96,*,150,36" ColumnSpacing="10">
                                <TextBox Classes="w11" Text="{Binding Code}" PlaceholderText="INF1" MaxLength="4" />
                                <TextBox Classes="w11" Grid.Column="1" Text="{Binding Name}" PlaceholderText="Désignation" />
                                <TextBox Classes="w11" Grid.Column="2" Text="{Binding Fee}" PlaceholderText="55000" />
                                <Button Grid.Column="3" Classes="toolicon" Command="{Binding Remove}" ToolTip.Tip="Retirer cette promotion" HorizontalAlignment="Right">
                                  <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                                </Button>
                              </Grid>
                              <!-- Désignations prédites d'après le code : un toucher remplit la ligne -->
                              <ItemsControl ItemsSource="{Binding Suggestions}" IsVisible="{Binding HasSuggestions}" Margin="106,0,46,0">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Button Classes="suggestion" Command="{Binding $parent[ItemsControl].DataContext.Pick}" CommandParameter="{Binding}">
                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                        <mi:MaterialIcon Kind="AutoFix" Width="14" Height="14" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                      </StackPanel>
                                    </Button>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <CheckBox IsChecked="{Binding LoadDemo}" IsVisible="{Binding CanLoadDemo}"><TextBlock Text="Charger des données de démonstration fictives, pour découvrir SCOLIA" TextWrapping="Wrap" /></CheckBox>
                  <TextBlock Grid.Column="1" Text="{Binding CurrencyLine}" Classes="muted" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
              </StackPanel>
            </StackPanel>

            <!-- Étape 2 : les deux comptes, côte à côte -->
            <Grid Grid.Row="1" IsVisible="{Binding IsStepTwo}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16" Margin="0,16,0,0" VerticalAlignment="Top" infra:Adaptive.StackBelow="640">
              <Border Background="{DynamicResource Surface2Brush}" CornerRadius="14" Padding="18,16">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="appicon medium" Background="{DynamicResource ToneBlue}"><mi:MaterialIcon Kind="ShieldAccountOutline" /></Border>
                    <TextBlock Text="Secrétariat" Classes="section" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap"
                             Text="Compte administrateur : apprenants, encaissements, scolarité, paramétrage, utilisateurs et sauvegardes. Gardez son mot de passe en lieu sûr." />
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" infra:Adaptive.StackBelow="300">
                    <StackPanel Classes="field"><TextBlock Text="Identifiant" /><TextBox Classes="w11" Text="{Binding AdminUserName}" /></StackPanel>
                    <StackPanel Classes="field" Grid.Column="1"><TextBlock Text="Nom de la personne" /><TextBox Classes="w11" Text="{Binding AdminDisplayName}" /></StackPanel>
                    <StackPanel Classes="field" Grid.Row="1"><TextBlock Text="Mot de passe" /><TextBox Classes="w11" Text="{Binding AdminPassword}" PasswordChar="•" /></StackPanel>
                    <StackPanel Classes="field" Grid.Row="1" Grid.Column="1"><TextBlock Text="Confirmer" /><TextBox Classes="w11" Text="{Binding AdminConfirm}" PasswordChar="•" /></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}" CornerRadius="14" Padding="18,16">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="appicon medium" Background="{DynamicResource ToneGreen}"><mi:MaterialIcon Kind="CashRegister" /></Border>
                    <TextBlock Grid.Column="1" Text="Comptabilité" Classes="section" VerticalAlignment="Center" Margin="10,0,8,0" />
                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding UseComptabilite}" OnContent="" OffContent="" ToolTip.Tip="Créer le compte comptabilité" />
                  </Grid>
                  <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap"
                             Text="Facultatif. Encaisse, tient la caisse, enregistre les dépenses, consulte le journal et les rapports. Ne touche pas au paramétrage." />
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" IsEnabled="{Binding UseComptabilite}" infra:Adaptive.StackBelow="300">
                    <StackPanel Classes="field"><TextBlock Text="Identifiant" /><TextBox Classes="w11" Text="{Binding ComptabiliteUserName}" /></StackPanel>
                    <StackPanel Classes="field" Grid.Column="1"><TextBlock Text="Nom de la personne" /><TextBox Classes="w11" Text="{Binding ComptabiliteDisplayName}" /></StackPanel>
                    <StackPanel Classes="field" Grid.Row="1"><TextBlock Text="Mot de passe" /><TextBox Classes="w11" Text="{Binding ComptabilitePassword}" PasswordChar="•" /></StackPanel>
                    <StackPanel Classes="field" Grid.Row="1" Grid.Column="1"><TextBlock Text="Confirmer" /><TextBox Classes="w11" Text="{Binding ComptabiliteConfirm}" PasswordChar="•" /></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <!-- Conseils : ce qui se passe à la connexion et comment choisir les mots de passe -->
              <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" ColumnSpacing="16" RowSpacing="10" Margin="0,16,0,0" infra:Adaptive.StackBelow="760">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Margin="0,0,10,0" Classes="appicon medium" Background="{DynamicResource ToneIndigo}"><mi:MaterialIcon Kind="FormTextboxPassword" /></Border>
                  <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" VerticalAlignment="Center"
                             Text="Code PIN de 6 chiffres ou plus, ou mot de passe de 8 caractères ou plus." />
                </DockPanel>
                <DockPanel Grid.Column="1">
                  <Border DockPanel.Dock="Left" Margin="0,0,10,0" Classes="appicon medium" Background="{DynamicResource ToneOrange}"><mi:MaterialIcon Kind="LockClock" /></Border>
                  <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" VerticalAlignment="Center"
                             Text="Après 5 erreurs, la connexion est bloquée 2 minutes." />
                </DockPanel>
                <DockPanel Grid.Column="2">
                  <Border DockPanel.Dock="Left" Margin="0,0,10,0" Classes="appicon medium" Background="{DynamicResource ToneTeal}"><mi:MaterialIcon Kind="AccountMultiplePlusOutline" /></Border>
                  <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" VerticalAlignment="Center"
                             Text="D'autres comptes s'ajoutent ensuite dans Paramètres." />
                </DockPanel>
              </Grid>
            </Grid>

            <!-- Pied : erreur éventuelle, puis les boutons -->
            <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,0">
              <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ToneRed}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0" Classes="ghost" Content="Retour" HorizontalAlignment="Left" Command="{Binding Back}" IsVisible="{Binding CanGoBack}" IsEnabled="{Binding !Busy}" />
                <Button Grid.Column="0" Classes="ghost" Command="{Binding JoinExisting}" IsVisible="{Binding IsChoosingInstitution}" HorizontalAlignment="Left">
                  <DockPanel>
                    <mi:MaterialIcon DockPanel.Dock="Left" Kind="LanConnect" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Rejoindre un SCOLIA existant sur le réseau" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </DockPanel>
                </Button>
                <Button Grid.Column="1" Classes="primary" Command="{Binding Next}" IsVisible="{Binding IsStepOne}" MinWidth="140" Height="38">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Suivant" />
                    <mi:MaterialIcon Kind="ArrowRight" Width="18" Height="18" Foreground="{DynamicResource OnAccentBrush}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="primary" Command="{Binding Finish}" IsVisible="{Binding IsStepTwo}" IsEnabled="{Binding !Busy}" Height="38">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="{DynamicResource OnAccentBrush}" />
                    <TextBlock Text="Terminer la configuration" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.AccessCodeView">
  <!-- Code d'accès, comme le verrouillage d'écran d'Android : la personne choisit un code PIN ou un mot de passe,
       les règles se cochent pendant la saisie, un seul bouton enregistre. Téléphone et ordinateur. -->
  <UserControl.Styles>
    <!-- Dans le groupe gris de la page Sécurité : les choix et les règles ressortent sur la surface -->
    <Style Selector="Border.methods">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.method">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.method /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.method.chosen /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="TextBox.code">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBlock.fieldlabel">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,4,0,0" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="10" Margin="0,4,0,0">
      <!-- 1. La méthode, comme « Verrouillage de l'écran » d'Android : deux lignes à cocher -->
      <TextBlock Text="Type de code" Classes="fieldlabel" />
      <Border Classes="methods">
        <StackPanel>
          <Button x:Name="PinChoice" Classes="method" Classes.chosen="{Binding UsePin}" Command="{Binding ChoosePin}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <mi:MaterialIcon Kind="Dialpad" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="Code PIN" FontWeight="Medium" />
                <TextBlock Text="6 chiffres ou plus, rapide à saisir" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" Width="22" Height="22" Margin="10,0,0,0">
                <mi:MaterialIcon Kind="RadioboxMarked" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding UsePin}" />
                <mi:MaterialIcon Kind="RadioboxBlank" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding !UsePin}" />
              </Panel>
            </Grid>
          </Button>
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="50,0,12,0" />
          <Button x:Name="PasswordChoice" Classes="method" Classes.chosen="{Binding UsePassword}" Command="{Binding ChoosePassword}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <mi:MaterialIcon Kind="FormTextboxPassword" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="Mot de passe" FontWeight="Medium" />
                <TextBlock Text="8 caractères ou plus : lettres, chiffres, symboles" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" Width="22" Height="22" Margin="10,0,0,0">
                <mi:MaterialIcon Kind="RadioboxMarked" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding UsePassword}" />
                <mi:MaterialIcon Kind="RadioboxBlank" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding !UsePassword}" />
              </Panel>
            </Grid>
          </Button>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding MethodHint}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />

      <!-- 2. Le code actuel -->
      <TextBlock Text="Code PIN ou mot de passe actuel" Classes="fieldlabel" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBox x:Name="CurrentCodeBox" Classes="code w11" Text="{Binding CurrentCode}" PasswordChar="{Binding CodeMask}"
                 TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True" PlaceholderText="Celui que vous utilisez aujourd'hui" />
        <Button Grid.Column="1" Classes="quiet" Command="{Binding ToggleCodeVisible}" MinWidth="48" MinHeight="48"
                ToolTip.Tip="Afficher ou masquer les saisies">
          <mi:MaterialIcon Kind="{Binding CodeEyeIcon}" Width="22" Height="22" />
        </Button>
      </Grid>

      <!-- 3. Le nouveau code, avec le clavier qui convient -->
      <TextBlock Text="{Binding NewCodeLabel}" Classes="fieldlabel" />
      <TextBox x:Name="NewPinBox" Classes="code w11" Text="{Binding NewCode}" PasswordChar="{Binding CodeMask}" IsVisible="{Binding UsePin}"
               TextInputOptions.ContentType="Pin" TextInputOptions.IsSensitive="True" MaxLength="16" PlaceholderText="Chiffres seulement" />
      <TextBox x:Name="NewPasswordBox" Classes="code w11" Text="{Binding NewCode}" PasswordChar="{Binding CodeMask}" IsVisible="{Binding UsePassword}"
               TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True" MaxLength="128" PlaceholderText="Lettres, chiffres, symboles" />
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="14,10">
        <ItemsControl ItemsSource="{Binding CodeRules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                <Panel Width="18" Height="18" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="CheckCircleOutline" Foreground="{DynamicResource ToneGreen}" IsVisible="{Binding Met}" />
                  <mi:MaterialIcon Kind="CircleOutline" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding !Met}" />
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock Text="{Binding ConfirmCodeLabel}" Classes="fieldlabel" />
      <TextBox x:Name="ConfirmPinBox" Classes="code w11" Text="{Binding ConfirmCode}" PasswordChar="{Binding CodeMask}" IsVisible="{Binding UsePin}"
               TextInputOptions.ContentType="Pin" TextInputOptions.IsSensitive="True" MaxLength="16" PlaceholderText="Le même code" />
      <TextBox x:Name="ConfirmPasswordBox" Classes="code w11" Text="{Binding ConfirmCode}" PasswordChar="{Binding CodeMask}" IsVisible="{Binding UsePassword}"
               TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True" MaxLength="128" PlaceholderText="Le même mot de passe" />
      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowMatch}">
        <Panel Width="16" Height="16">
          <mi:MaterialIcon Kind="CheckCircleOutline" Foreground="{DynamicResource ToneGreen}" IsVisible="{Binding CodesMatch}" />
          <mi:MaterialIcon Kind="AlertCircleOutline" Foreground="{DynamicResource ToneOrange}" IsVisible="{Binding !CodesMatch}" />
        </Panel>
        <TextBlock Text="{Binding MatchText}" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
      </StackPanel>

      <Border Background="{DynamicResource RedSoftBrush}" CornerRadius="14" Padding="14,10" IsVisible="{Binding HasCodeError}">
        <TextBlock Text="{Binding CodeError}" TextWrapping="Wrap" />
      </Border>
      <Button x:Name="SaveCodeButton" Classes="primary" Command="{Binding SaveCode}" IsEnabled="{Binding CanSaveCode}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="52" CornerRadius="26" Margin="0,4,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="ContentSaveOutline" Width="18" Height="18" />
          <TextBlock Text="Enregistrer le nouveau code" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
  </StackPanel>
</UserControl>

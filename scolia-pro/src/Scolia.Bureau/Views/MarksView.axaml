<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:c="using:Scolia.Bureau.Controls"
             x:Class="Scolia.Bureau.Views.MarksView">
  <Grid ColumnDefinitions="3*,4*" RowDefinitions="Auto,*" infra:Adaptive.StackBelow="760">
    <Border Grid.ColumnSpan="2" Classes="band" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Promotion" Classes="fieldlabel" />
          <ComboBox Width="260" ItemsSource="{Binding Promotions}" SelectedItem="{Binding Promotion}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Cote à encoder" Classes="fieldlabel" />
          <ComboBox Width="230" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" />
        </StackPanel>
        <TextBlock Text="{Binding EncodingRules}" Classes="muted" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" Margin="8,0,0,8" />
        <TextBlock Text="{Binding Notice}" IsVisible="{Binding HasNotice}" Classes="muted" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" Margin="8,0,0,8" />
        <CheckBox Content="Feuille anonyme (codes seulement)" IsChecked="{Binding Anonymous}" IsVisible="{Binding CanChooseAnonymous}" VerticalAlignment="Center" Margin="16,0,12,8" />
      </WrapPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Classes="card" Margin="0,0,10,0" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Text="1. Choisissez un cours" Classes="heading" Margin="16,12,16,4" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding Courses}" SelectedItem="{Binding Course}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" CornerRadius="0">
          <DataGrid.Columns>
            <!-- L'avancement compte le plus : sur un écran moyen, Maxima, Org. puis N° s'effacent d'abord. -->
            <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="Auto" MinWidth="74" infra:GridPriority.Level="3" />
            <DataGridTextColumn Header="Cours" Binding="{Binding Name}" Width="*" MinWidth="176" />
            <DataGridTextColumn Header="Org." Binding="{Binding Semester}" Width="Auto" MinWidth="92" infra:GridPriority.Level="3" />
            <DataGridTextColumn Header="Maxima" Binding="{Binding Max}" Width="Auto" MinWidth="110" infra:GridPriority.Level="4" />
            <DataGridTextColumn Header="Avancement" Binding="{Binding Progress}" Width="Auto" MinWidth="160" infra:GridPriority.Level="2" />
          </DataGrid.Columns>
        </DataGrid>
        <c:EmptyState Grid.Row="1" Icon="BookOpenVariant" Title="Aucun cours"
                      Hint="Créez les cours de la promotion dans « Cours et notes », avec leur maxima et leur organisation (S1, S2 ou annuel)." IsVisible="{Binding Courses.Count, Converter={StaticResource IsEmpty}}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Classes="card" Padding="0">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Text="{Binding SheetTitle}" Classes="heading" Margin="16,12,16,0" />
        <TextBlock Grid.Row="1" Text="{Binding SheetHint}" Classes="muted" TextWrapping="Wrap" Margin="16,2,16,6" />

        <!-- Parcours enseignant natif : promotion, cours, code anonyme validé, puis note. -->
        <Border Grid.Row="2" IsVisible="{Binding ShowTeacherEntry}" Margin="14,4,14,10"
                Padding="14,12" CornerRadius="12" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" Background="{DynamicResource Surface2Brush}">
          <StackPanel Spacing="9">
            <TextBlock Text="Code anonyme de la copie" Classes="fieldlabel" />
            <TextBox Text="{Binding CodeSearch, Mode=TwoWay}" MaxLength="16"
                     PlaceholderText="Saisir les premières lettres ou chiffres"
                     AutomationProperties.Name="Rechercher un code anonyme" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Les codes de cette promotion apparaissent dès le premier caractère, sans afficher les noms." />
            <ItemsControl ItemsSource="{Binding CodeSuggestions}" IsVisible="{Binding HasCodeSuggestions}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="secondary" MinHeight="40" Margin="0,0,7,7" Padding="12,7"
                          Command="{Binding $parent[ItemsControl].DataContext.ChooseAnonymousCode}"
                          CommandParameter="{Binding}" AutomationProperties.Name="Sélectionner le code anonyme">
                    <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Valider le code saisi" Command="{Binding ValidateAnonymousCode}"
                    HorizontalAlignment="Left" MinHeight="40" />
            <TextBlock Text="{Binding CodeError}" Foreground="{DynamicResource ToneRed}"
                       IsVisible="{Binding HasCodeError}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding VerifiedCodeText}" Foreground="{DynamicResource ToneGreen}"
                       IsVisible="{Binding CodeVerified}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding MaxScoreLabel}" Classes="fieldlabel" />
            <TextBox Text="{Binding ScoreInput, Mode=TwoWay}" MaxLength="12"
                     Watermark="Note obtenue" IsEnabled="{Binding CanEnterScore}"
                     AutomationProperties.Name="Note de la copie" />
            <TextBlock Text="{Binding ScoreError}" Foreground="{DynamicResource ToneRed}"
                       IsVisible="{Binding HasScoreError}" TextWrapping="Wrap" />
            <Button Classes="primary" Content="Enregistrer la note" MinHeight="44"
                    Command="{Binding SaveAnonymousScore}" IsEnabled="{Binding CanSaveAnonymousScore}"
                    HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding LastEncoded}" IsVisible="{Binding HasLastEncoded}"
                       Foreground="{DynamicResource ToneGreen}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <c:EmptyState Grid.Row="3" Icon="Pen" Title="2. Encodez les cotes"
                      Hint="Choisissez un cours : ses apprenants s'affichent ici. « Saisie par code anonyme » encode copie par copie." IsVisible="{Binding NoCourse}" />
        <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="False" BorderThickness="0" CornerRadius="0" IsVisible="{Binding !IsTeacher}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Code" Binding="{Binding Code}" IsReadOnly="True" Width="Auto" MinWidth="110" />
            <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" IsReadOnly="True" Width="Auto" MinWidth="110" infra:GridPriority.Level="2" />
            <DataGridTextColumn Header="Nom complet" Binding="{Binding FullName}" IsReadOnly="True" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="Cote" Binding="{Binding Value}" Width="Auto" MinWidth="90" />
            <DataGridTemplateColumn Header="Retenue" Width="Auto" MinWidth="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Retained}" Foreground="{Binding RetainedBrush}" VerticalAlignment="Center" Margin="12,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <!-- Récapitulatif enseignant non modifiable : uniquement les codes, jamais les identités. -->
        <Expander Grid.Row="3" Header="Relevé anonyme du cours" IsExpanded="False"
                  IsVisible="{Binding ShowTeacherEntry}" Margin="14,0,14,10">
          <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                    BorderThickness="0" MaxHeight="360">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*" MinWidth="100" />
              <DataGridTextColumn Header="Cote" Binding="{Binding Value}" Width="Auto" MinWidth="80" />
              <DataGridTextColumn Header="Retenue" Binding="{Binding Retained}" Width="Auto" MinWidth="90" />
            </DataGrid.Columns>
          </DataGrid>
        </Expander>
      </Grid>
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Scolia.Bureau.Views"
             x:Class="Scolia.Bureau.Views.SkeletonView"
             IsHitTestVisible="False">
  <!-- Silhouettes de chargement : la forme du contenu à venir, qui respire doucement, au lieu d'un écran vide. -->
  <UserControl.Styles>
    <Style Selector="Border.bone">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.skeletoncard">
      <Setter Property="Background" Value="{DynamicResource GroupBrush}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="views|SkeletonView[IsVisible=True] StackPanel#Bones">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <StackPanel x:Name="Bones" Spacing="12" Margin="16,12">
    <Border Classes="bone" Height="40" CornerRadius="12" HorizontalAlignment="Stretch" />
    <Border Classes="skeletoncard">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto"><Border Classes="bone" Width="170" Height="16" /><Border Grid.Column="1" Classes="bone" Width="72" Height="16" /></Grid>
        <Border Classes="bone" Width="110" />
        <Border Classes="bone" HorizontalAlignment="Stretch" />
        <Border Classes="bone" Width="200" />
      </StackPanel>
    </Border>
    <Border Classes="skeletoncard">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto"><Border Classes="bone" Width="140" Height="16" /><Border Grid.Column="1" Classes="bone" Width="64" Height="16" /></Grid>
        <Border Classes="bone" Width="90" />
        <Border Classes="bone" HorizontalAlignment="Stretch" />
        <Border Classes="bone" Width="170" />
      </StackPanel>
    </Border>
    <Border Classes="skeletoncard">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto"><Border Classes="bone" Width="190" Height="16" /><Border Grid.Column="1" Classes="bone" Width="80" Height="16" /></Grid>
        <Border Classes="bone" Width="120" />
        <Border Classes="bone" HorizontalAlignment="Stretch" />
        <Border Classes="bone" Width="150" />
      </StackPanel>
    </Border>
    <Border Classes="skeletoncard">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto"><Border Classes="bone" Width="150" Height="16" /><Border Grid.Column="1" Classes="bone" Width="70" Height="16" /></Grid>
        <Border Classes="bone" Width="100" />
        <Border Classes="bone" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scolia.Bureau.Views.DataView">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
      <TextBlock TextWrapping="Wrap"
                 Text="Les sauvegardes sont créées chaque jour et avant chaque migration. Restaurer une sauvegarde remplace la base : une copie de la base actuelle est conservée avant." />
    </Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Fichier" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Créée le" Binding="{Binding Created}" Width="Auto" MinWidth="190" />
        <DataGridTextColumn Header="Taille" Binding="{Binding Size}" Width="Auto" MinWidth="110" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="1" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0"
               Text="Aucune sauvegarde pour l'instant. Cliquez sur « Sauvegarder » pour créer la première."
               IsVisible="{Binding Items.Count, Converter={StaticResource IsEmpty}}" />
  </Grid>
</UserControl>

<UserControl xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Scolia.Bureau.Controls"
             x:Class="Scolia.Bureau.Views.StaffView">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,10">
      <WrapPanel>
        <Border Classes="segmented" VerticalAlignment="Bottom" Margin="0,0,16,6">
          <StackPanel Orientation="Horizontal">
            <RadioButton Classes="segment" GroupName="staff" Content="Dossiers du personnel" IsChecked="{Binding !ShowPayroll}" />
            <RadioButton Classes="segment" GroupName="staff" Content="Paie mensuelle" IsChecked="{Binding ShowPayroll}" />
          </StackPanel>
        </Border>
        <StackPanel Classes="field" IsVisible="{Binding ShowPayroll}">
          <TextBlock Text="Mois" Classes="fieldlabel" />
          <ComboBox Width="200" ItemsSource="{Binding Periods}" SelectedItem="{Binding PeriodChoice}" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Staff}" SelectedItem="{Binding SelectedStaff}"
              AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding !ShowPayroll}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="N° de dossier" Binding="{Binding Number}" Width="Auto" MinWidth="152" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Name}" Width="*" MinWidth="140" />
        <DataGridTextColumn Header="Fonction" Binding="{Binding Function}" Width="Auto" MinWidth="170" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Téléphone" Binding="{Binding Phone}" Width="Auto" MinWidth="130" />
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Embauche" Binding="{Binding Hired}" Width="Auto" MinWidth="114" />
        <DataGridTextColumn Header="Salaire de base" Binding="{Binding Salary}" Width="Auto" MinWidth="168" />
        <DataGridTemplateColumn Header="Statut" Width="Auto" MinWidth="100">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Classes="status">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Payroll}" SelectedItem="{Binding SelectedPayroll}"
              AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding ShowPayroll}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="Auto" MinWidth="110" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Name}" Width="*" MinWidth="140" />
        <DataGridTextColumn Header="Fonction" Binding="{Binding Function}" Width="Auto" MinWidth="150" />
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Base" Binding="{Binding Base}" Width="Auto" MinWidth="120" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Primes" Binding="{Binding Allowances}" Width="Auto" MinWidth="110" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Retenues" Binding="{Binding Deductions}" Width="Auto" MinWidth="114" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Avances" Binding="{Binding Advances}" Width="Auto" MinWidth="110" />
        <DataGridTextColumn Header="Net à payer" Binding="{Binding Net}" Width="Auto" MinWidth="137" />
        <DataGridTemplateColumn Header="Statut" Width="Auto" MinWidth="110">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Classes="status">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Payé le" Binding="{Binding PaidOn}" Width="Auto" MinWidth="107" />
      </DataGrid.Columns>
    </DataGrid>
    <c:EmptyState Grid.Row="1" Icon="BriefcaseOutline" Title="Aucun membre du personnel" Hint="Ajoutez le premier avec « Nouveau membre »." IsVisible="{Binding StaffEmpty}" />
    <c:EmptyState Grid.Row="1" Icon="CashMultiple" Title="Aucun bulletin pour ce mois" Hint="Cliquez sur « Préparer la paie » pour générer les bulletins des membres actifs." IsVisible="{Binding PayrollEmpty}" />
  </Grid>
</UserControl>

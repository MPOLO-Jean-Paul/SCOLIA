<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:views="using:Scolia.Bureau.Views"
             x:Class="Scolia.Bureau.Views.NetworkHubView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" MaxWidth="820" Margin="0,0,10,20" HorizontalAlignment="Left">
      <!-- Réseau local, invitations QR et liaison Internet chiffrée. -->
      <views:PosteView DataContext="{Binding Connection}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

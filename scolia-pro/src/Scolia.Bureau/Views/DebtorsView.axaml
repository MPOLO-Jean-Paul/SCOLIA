<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Scolia.Bureau.Controls"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             x:Class="Scolia.Bureau.Views.DebtorsView">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Rechercher" Classes="fieldlabel" />
          <TextBox Width="260" Text="{Binding Search}" PlaceholderText="Nom ou matricule" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Promotion" Classes="fieldlabel" />
          <ComboBox Width="220" ItemsSource="{Binding Promotions}" SelectedItem="{Binding Promotion}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Ancienneté" Classes="fieldlabel" />
          <ComboBox Width="210" ItemsSource="{Binding Buckets}" SelectedItem="{Binding Bucket}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Retard minimum" Classes="fieldlabel" />
          <TextBox Width="190" Text="{Binding MinMonths}" PlaceholderText="Retard minimum (mois)" />
        </StackPanel>
      </WrapPanel>
    </Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Matricule" Binding="{Binding Matricule}" Width="Auto" MinWidth="122" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Name}" Width="2*" MinWidth="270" />
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Promotion" Binding="{Binding Promotion}" Width="Auto" MinWidth="122" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Solde" Binding="{Binding Balance}" Width="Auto" MinWidth="130" />
        <DataGridTextColumn Header="Reste exigible" Binding="{Binding Overdue}" Width="Auto" MinWidth="160" />
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Échéances" Binding="{Binding Count}" Width="Auto" MinWidth="122" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Ancienneté" Binding="{Binding Bucket}" Width="Auto" MinWidth="130" />
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Garant" Binding="{Binding Guardian}" Width="Auto" MinWidth="200" />
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Téléphone" Binding="{Binding Phone}" Width="Auto" MinWidth="130" />
      </DataGrid.Columns>
    </DataGrid>
    <c:EmptyState Grid.Row="1" Icon="CheckDecagramOutline" Title="Aucun retard de paiement" Hint="Tous les apprenants de ces critères sont à jour : rien à relancer." IsVisible="{Binding Items.Count, Converter={StaticResource IsEmpty}}" />
  </Grid>
</UserControl>

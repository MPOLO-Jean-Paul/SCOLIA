<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Scolia.Bureau.Controls"
             x:Class="Scolia.Bureau.Views.HomeView">
  <UserControl.Styles>
    <Style Selector="TextBlock.kpivalue"><Setter Property="FontSize" Value="{DynamicResource FsTitle}" /></Style>
    <!-- Accueil Windows natif : surface système, contraste automatique clair/sombre et bord discret. -->
    <Style Selector="TextBlock.greeting"><Setter Property="FontSize" Value="23" /></Style>
    <Style Selector="TextBlock.sectiontitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Border.offlinestate">
      <Setter Property="Background" Value="{DynamicResource GroupBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="Border.desktopwelcome">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style Selector="Border.desktopstatechip">
      <Setter Property="Background" Value="{DynamicResource GroupBrush}" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.heroaction">
      <Setter Property="Background" Value="{DynamicResource GroupBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.heroaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.bare:pointerover Border.desktopstatechip">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <!-- Outil : tuile compacte, l'icône à gauche, le nom et une ligne de description -->
    <Style Selector="Button.tooltile">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.tooltile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Spacing="18" Margin="0,0,6,16">

      <!-- Accueil : la salutation reste TOUJOURS à gauche, les deux commandes
           restent TOUJOURS à droite. Seules les deux commandes passent de
           côte-à-côte à l'une au-dessus de l'autre dans leur colonne droite. -->
      <Border Classes="desktopwelcome" Padding="0" ClipToBounds="True">
        <StackPanel Spacing="0">
          <Border Height="3" Background="{DynamicResource AccentBrush}" />
          <Grid x:Name="WelcomeLayout" ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="0" Margin="22,19,22,20">
            <!-- Bloc de salutation : dimension variable, jamais masqué par des boutons. -->
            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="11"
                  VerticalAlignment="Center">
              <Border x:Name="WelcomeAvatar" Width="42" Height="42" CornerRadius="12"
                      Background="{DynamicResource AccentSoftBrush}"
                      VerticalAlignment="Top">
                <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="VOTRE ESPACE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock x:Name="WelcomeGreeting" Text="{Binding Greeting}" Classes="greeting"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding AccountContextLine}"
                           FontSize="{DynamicResource FsSmall}" Foreground="{DynamicResource Text2Brush}"
                           TextWrapping="Wrap" MaxLines="3" />
                <TextBlock Text="{Binding DateLine}" Classes="muted"
                           FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                <Border Classes="desktopstatechip" IsVisible="{Binding HasCashLine}"
                        HorizontalAlignment="Left" Margin="0,5,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="7" Height="7" Fill="{Binding CashBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CashLine}" Foreground="{DynamicResource TextBrush}"
                               FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
            <!-- Barre verticale entre le message et la zone des actions. -->
            <Border Grid.Column="1" Width="1" Background="{DynamicResource LineBrush}"
                    Margin="13,2,13,2" VerticalAlignment="Stretch" />
            <ItemsControl x:Name="WelcomeQuickActions" Grid.Column="2"
                          ItemsSource="{Binding QuickActions}" Width="278"
                          HorizontalAlignment="Right" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" infra:Adaptive.MinItemWidth="132" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="heroaction" Command="{Binding Open}"
                          ToolTip.Tip="{Binding Description}"
                          Margin="3" Padding="8,10" MinHeight="48"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <mi:MaterialIcon Kind="{Binding Icon}" Width="17" Height="17"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding ShortTitle}" FontSize="12"
                                 TextWrapping="Wrap" MaxLines="2" TextAlignment="Center"
                                 VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </StackPanel>
      </Border>

      <!-- État de connexion non intrusif : reste dans le flux de la page. -->
      <Border Classes="offlinestate" IsVisible="{Binding Sync.Offline}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
          <Border Width="35" Height="35" CornerRadius="11"
                  Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="CloudOffOutline" Width="21" Height="21"
                             Foreground="{Binding Sync.StatusBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding Sync.StatusText}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" FontSize="12" />
            <TextBlock Text="Les données déjà téléchargées restent consultables. Les opérations autorisées attendent le serveur."
                       Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap"
                       FontSize="{DynamicResource FsSmall}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="link" Command="{Binding Network}"
                  MinWidth="75" MinHeight="40" Content="Détails"
                  VerticalAlignment="Center" ToolTip.Tip="Voir les envois en attente" />
        </Grid>
      </Border>

      <!-- Indicateurs : 1 à 4 colonnes selon la largeur restante APRÈS le menu latéral ;
           aucune largeur fixe et aucun chevauchement quand la fenêtre rétrécit. -->
      <Grid ColumnDefinitions="*,Auto" Margin="2,2,8,-8">
        <TextBlock Text="Indicateurs essentiels" Classes="sectiontitle" />
        <TextBlock Grid.Column="1" Text="Situation de l'établissement" Classes="muted"
                   FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Kpis}" IsVisible="{Binding HasKpis}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="4" infra:Adaptive.MinItemWidth="260" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="cardbutton" Command="{Binding Open}" Margin="0,0,10,10"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="Ouvrir le détail">
              <Border Classes="toolcard" MinHeight="118" Padding="16,15" ClipToBounds="True"
                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="1" CornerRadius="14">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                  <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text2Brush}"
                             FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                             VerticalAlignment="Center" />
                  <Border Grid.Column="1" Grid.RowSpan="2" Classes="appicon medium" Background="{Binding Brush}"
                          VerticalAlignment="Top" Margin="8,0,0,0"><mi:MaterialIcon Kind="{Binding Icon}" /></Border>
                  <TextBlock Grid.Row="1" Text="{Binding Value}" FontSize="24"
                             FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                             TextWrapping="Wrap" MaxLines="2" />
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Hint}" Classes="muted"
                             FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" MaxLines="2" />
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Outils : tuiles compactes, un clic ouvre l'outil -->
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto" infra:Adaptive.StackBelow="410">
          <TextBlock Text="Accès rapides" Classes="sectiontitle" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="link" Content="{Binding AllToolsLabel}" Command="{Binding ShowAllTools}"
                  HorizontalAlignment="Left" MinHeight="36"
                  ToolTip.Tip="Déployer les fonctionnalités autorisées dans cette page" />
        </Grid>
        <ItemsControl ItemsSource="{Binding MoreTools}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="3" infra:Adaptive.MinItemWidth="230" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="tooltile" Command="{Binding Open}" Margin="0,0,10,10" MinHeight="74" ToolTip.Tip="{Binding Description}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="appicon medium" Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,12,0"><mi:MaterialIcon Kind="{Binding Icon}" /></Border>
                  <!-- Un titre net ; l'explication reste dans l'info-bulle, au survol -->
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                  <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Le bouton Afficher tous les outils ouvre vraiment le catalogue du rôle,
           même lorsque le volet latéral est déjà visible. -->
      <Border Classes="card" IsVisible="{Binding AllToolsVisible}" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="Toutes les fonctionnalités accessibles" FontWeight="SemiBold" FontSize="{DynamicResource FsHeading}" />
          <ItemsControl ItemsSource="{Binding AllToolGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="7" Margin="0,2,0,12">
                  <TextBlock Text="{Binding Title}" Classes="heading" />
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="3" infra:Adaptive.MinItemWidth="210" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="tooltile" Command="{Binding Open}" Margin="0,0,8,8" MinHeight="54">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <Border Classes="appicon" Background="{Binding Brush}" VerticalAlignment="Center">
                              <mi:MaterialIcon Kind="{Binding Icon}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" MaxLines="2"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Derniers reçus, et à côté ce qui reste à faire aujourd'hui -->
      <Grid ColumnDefinitions="2*,16,*" infra:Adaptive.StackBelow="760">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" infra:Adaptive.StackBelow="390">
            <TextBlock Text="Derniers reçus" Classes="sectiontitle" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding TodayLine}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasTodayLine}" />
          </Grid>
          <Border Classes="card" Padding="6">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Receipts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="listrow" Command="{Binding Open}" Padding="12,9" ToolTip.Tip="Ouvrir le reçu">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="appicon" Background="{DynamicResource TonePurple}" VerticalAlignment="Center">
                          <mi:MaterialIcon Kind="ReceiptTextOutline" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Student}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Number}" Classes="muted" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Date}" Classes="muted" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Amount}" FontWeight="SemiBold" MaxWidth="120"
                                   VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" MaxLines="2" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <c:EmptyState Icon="ReceiptTextOutline" Title="Aucun reçu récent"
                            Hint="Les derniers encaissements apparaîtront ici."
                            IsVisible="{Binding !Receipts.Count}" Margin="16" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="8">
          <TextBlock Text="{Binding TasksTitle}" Classes="sectiontitle" />
          <Border Classes="card" Padding="6">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="listrow" Command="{Binding Open}" Padding="10,8">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="appicon" Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,10,0"><mi:MaterialIcon Kind="{Binding Icon}" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Classes="wrap2" Text="{Binding Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Classes="wrap2 muted" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <c:EmptyState Icon="CheckCircleOutline" Title="Rien en attente" Hint="La caisse, l'appel et les rendez-vous du jour sont à jour." IsVisible="{Binding !HasTasks}" Margin="16" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

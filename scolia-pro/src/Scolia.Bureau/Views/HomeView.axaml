<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Scolia.Bureau.Controls"
             x:Class="Scolia.Bureau.Views.HomeView">
  <ScrollViewer>
    <StackPanel Spacing="12" Margin="0,0,6,8">

      <!-- Outils recommandés, comme l'accueil d'Acrobat : icône de couleur, nom, description, bouton Ouvrir -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Outils recommandés" Classes="heading" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="link" Content="Afficher tous les outils" Command="{Binding ShowAllTools}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Tools}" Margin="0,0,-12,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="toolcard" Margin="0,0,12,0">
              <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Border Classes="appicon large" Background="{Binding Brush}" HorizontalAlignment="Left"><mi:MaterialIcon Kind="{Binding Icon}" /></Border>
                <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="Bold" Margin="0,12,0,4" />
                <TextBlock Grid.Row="2" Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                <Button Grid.Row="3" Classes="outline" Content="Ouvrir" Command="{Binding Open}" HorizontalAlignment="Left" Margin="0,14,0,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Récents : la liste des derniers reçus, comme la liste des fichiers récents d'Acrobat -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,0">
        <TextBlock Text="Récents" Classes="heading" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding TodayLine}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasTodayLine}" />
      </Grid>
      <Border Classes="card" Padding="0">
        <StackPanel>
          <Grid ColumnDefinitions="2*,3*,1.3*,1.3*,1.3*" Margin="16,10,16,8">
            <TextBlock Text="Reçu" Classes="colhead" />
            <TextBlock Grid.Column="1" Text="Apprenant" Classes="colhead" />
            <TextBlock Grid.Column="2" Text="Date" Classes="colhead" />
            <TextBlock Grid.Column="3" Text="Mode" Classes="colhead" />
            <TextBlock Grid.Column="4" Text="Montant" Classes="colhead" TextAlignment="Right" />
          </Grid>
          <Border Height="1" Background="{DynamicResource LineBrush}" />
          <ItemsControl ItemsSource="{Binding Receipts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="row" Command="{Binding Open}">
                  <Grid ColumnDefinitions="2*,3*,1.3*,1.3*,1.3*">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <mi:MaterialIcon Kind="ReceiptTextOutline" Width="18" Height="18" Foreground="{DynamicResource TonePurple}" />
                      <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Student}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Date}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Method}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding Amount}" VerticalAlignment="Center" TextAlignment="Right" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <c:EmptyState Icon="ReceiptTextOutline" Title="Aucun reçu récent" Hint="Les derniers encaissements apparaîtront ici." IsVisible="{Binding !Receipts.Count}" Margin="24" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

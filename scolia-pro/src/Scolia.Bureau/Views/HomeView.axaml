<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Scolia.Bureau.Controls"
             x:Class="Scolia.Bureau.Views.HomeView">
  <!-- Espace de travail de type Power BI Desktop / Fluent Windows 11 :
       actions d'abord, indicateurs synthétiques, outils, puis activité récente.
       Chaque action reprend les droits effectifs du compte et les commandes existantes. -->
  <UserControl.Styles>
    <Style Selector="Border.pbiPanel">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.pbiInfo">
      <Setter Property="Background" Value="{DynamicResource GroupBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,9" />
    </Style>
    <Style Selector="TextBlock.pbiTitle">
      <Setter Property="FontSize" Value="23" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.pbiSection">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.pbiMuted">
      <Setter Property="FontSize" Value="{DynamicResource FsSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    </Style>
    <Style Selector="Button.pbiAction">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="13,13" />
      <Setter Property="MinHeight" Value="86" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.pbiAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.pbiMetric">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="15,13" />
      <Setter Property="MinHeight" Value="104" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.pbiMetric:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.pbiRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.pbiRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.pbiAction:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.pbiMetric:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.pbiRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.pbiState">
      <Setter Property="Background" Value="{DynamicResource GroupBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,11" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="4,2,7,20">
      <!-- Bandeau de contexte, comme l'accueil récent de Power BI Desktop : sobre, dense et utile. -->
      <Grid x:Name="WelcomeLayout" ColumnDefinitions="*,Auto" ColumnSpacing="12"
            infra:Adaptive.StackBelow="610">
        <StackPanel Spacing="5">
          <TextBlock Text="ESPACE DE TRAVAIL" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="Accueil" Classes="pbiTitle" />
          <TextBlock Text="{Binding HeaderSchoolLine}" Classes="pbiMuted"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    HorizontalAlignment="Right">
          <StackPanel Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock x:Name="WelcomeGreeting" Text="{Binding Greeting}" FontWeight="SemiBold"
                       FontSize="13" TextAlignment="Right" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock Text="{Binding DateLine}" Classes="pbiMuted" TextAlignment="Right" />
          </StackPanel>
          <Border x:Name="WelcomeAvatar" Width="42" Height="42" CornerRadius="21"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="1">
            <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          </Border>
        </StackPanel>
      </Grid>

      <!-- Démarrage rapide : commandes réellement exécutables, pas de fausses tuiles. -->
      <Grid ColumnDefinitions="2*,*" ColumnSpacing="14" infra:Adaptive.StackBelow="820">
        <Border Classes="pbiPanel" Padding="18">
          <StackPanel Spacing="13">
            <StackPanel Spacing="3">
              <TextBlock Text="Actions rapides" Classes="pbiSection" />
              <TextBlock Text="Vos opérations courantes." Classes="pbiMuted" TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl x:Name="WelcomeQuickActions" ItemsSource="{Binding QuickActions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" infra:Adaptive.MinItemWidth="180" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="pbiAction" Command="{Binding Open}" ToolTip.Tip="{Binding Description}"
                          Margin="0,0,10,2">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                      <mi:MaterialIcon Kind="{Binding Icon}" Width="25" Height="25"
                                       Foreground="{Binding Brush}" />
                      <TextBlock Grid.Row="1" Text="{Binding ShortTitle}" FontSize="14"
                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                      <TextBlock Grid.Row="2" Text="{Binding Description}" Classes="pbiMuted"
                                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="link" Content="{Binding AllToolsLabel}" Command="{Binding ShowAllTools}"
                    HorizontalAlignment="Left" ToolTip.Tip="Afficher les fonctionnalités autorisées du compte" />
          </StackPanel>
        </Border>

        <!-- Panneau de session : connexion et état de caisse, ancré à droite comme les volets Power BI. -->
        <Border Grid.Column="1" Classes="pbiPanel" Padding="17">
          <StackPanel Spacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="État de la session" Classes="pbiSection" />
              <TextBlock Text="{Binding AccountContextLine}" Classes="pbiMuted"
                         TextWrapping="Wrap" MaxLines="2" />
            </StackPanel>
            <Button Classes="pbiState" Command="{Binding Network}" ToolTip.Tip="{Binding Sync.StatusDetail}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                <mi:MaterialIcon Kind="{Binding Sync.StatusIcon}" Foreground="{Binding Sync.StatusBrush}"
                                 Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding Sync.StatusText}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <TextBlock Text="{Binding Sync.StatusHint}" Classes="pbiMuted"
                             TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
              </Grid>
            </Button>
            <Border Classes="pbiInfo" IsVisible="{Binding HasCashLine}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <mi:MaterialIcon Kind="CashRegister" Width="22" Height="22"
                                 Foreground="{Binding CashBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="Situation de la caisse" Classes="pbiMuted" />
                  <TextBlock Text="{Binding CashLine}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="pbiInfo" IsVisible="{Binding OverviewUnavailable}">
        <TextBlock Text="Les indicateurs ne sont pas disponibles pour le moment. Vos outils restent accessibles." Classes="pbiMuted" TextWrapping="Wrap" />
      </Border>
      <!-- KPI type visualisations Power BI : lecture immédiate, drill-through au clic. -->
      <StackPanel Spacing="10" IsVisible="{Binding HasKpis}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="Indicateurs de l'établissement" Classes="pbiSection"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Situation actuelle" Classes="pbiMuted"
                     VerticalAlignment="Center" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Kpis}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" infra:Adaptive.MinItemWidth="190" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="pbiMetric" Command="{Binding Open}" ToolTip.Tip="Ouvrir l'indicateur"
                      Margin="0,0,10,5">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" Classes="pbiMuted" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <mi:MaterialIcon Grid.Column="1" Kind="{Binding Icon}" Width="20" Height="20"
                                     Foreground="{Binding Brush}" />
                  </Grid>
                  <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Text="{Binding Hint}" Classes="pbiMuted" TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Raccourcis recommandés : aucune illustration géante, vocabulaire métier conservé. -->
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Recommandé pour vous" Classes="pbiSection" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Outils métier" Classes="pbiMuted" VerticalAlignment="Center" />
        </Grid>
        <ItemsControl x:Name="FeatureCards" ItemsSource="{Binding MoreTools}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" infra:Adaptive.MinItemWidth="175" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="pbiAction" Command="{Binding Open}" ToolTip.Tip="{Binding Description}"
                      Margin="0,0,10,4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Border Width="40" Height="40" CornerRadius="8"
                          Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                    <mi:MaterialIcon Kind="{Binding Icon}" Width="24" Height="24"
                                     Foreground="{Binding Brush}" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" Classes="pbiMuted" TextWrapping="Wrap"
                               MaxLines="2" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Panneau complet de navigation, accessible même quand le volet gauche est réduit. -->
      <Border Classes="pbiPanel" IsVisible="{Binding AllToolsVisible}" Padding="15">
        <StackPanel Spacing="11">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Toutes les fonctionnalités" Classes="pbiSection" />
            <Button Grid.Column="1" Classes="link" Content="Réduire" Command="{Binding ShowAllTools}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding AllToolGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="7" Margin="0,4,0,10">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="4" infra:Adaptive.MinItemWidth="170" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="pbiRow" Command="{Binding Open}" Margin="0,0,7,6">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <mi:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18"
                                             Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Activité récente : uniquement si les données ont été chargées. -->
      <Grid ColumnDefinitions="2*,*" ColumnSpacing="14" infra:Adaptive.StackBelow="820" IsVisible="{Binding OverviewAvailable}">
        <Border Classes="pbiPanel" Padding="16">
          <StackPanel Spacing="11">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="Récents · Encaissements" Classes="pbiSection" />
              <TextBlock Grid.Column="1" Text="{Binding TodayLine}" Classes="pbiMuted"
                         IsVisible="{Binding HasTodayLine}" VerticalAlignment="Center" />
            </Grid>
            <Border Background="{DynamicResource GroupBrush}" CornerRadius="6" Padding="10,7">
              <Grid ColumnDefinitions="*,120" ColumnSpacing="8">
                <TextBlock Text="Dossier / Référence" Classes="pbiMuted" FontWeight="SemiBold" />
                <TextBlock x:Name="RecentAmountHeader" Grid.Column="1" Text="Montant" Classes="pbiMuted" FontWeight="SemiBold"
                           TextAlignment="Right" />
              </Grid>
            </Border>
            <ItemsControl x:Name="RecentReceiptRows" ItemsSource="{Binding Receipts}" HorizontalAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="pbiRow" Command="{Binding Open}" ToolTip.Tip="Ouvrir le reçu" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8">
                    <Grid ColumnDefinitions="*,120" ColumnSpacing="8">
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Student}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding Number}" Classes="pbiMuted" />
                          <TextBlock Text="{Binding Date}" Classes="pbiMuted" />
                        </StackPanel>
                      </StackPanel>
                      <TextBlock x:Name="RecentAmountValue" Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold"
                                 TextAlignment="Right" VerticalAlignment="Center"
                                 TextWrapping="Wrap" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <c:EmptyState Icon="ReceiptTextOutline" Title="Aucun reçu récent"
                          Hint="Les encaissements de l'établissement apparaîtront ici."
                          IsVisible="{Binding !Receipts.Count}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="pbiPanel" Padding="16">
          <StackPanel Spacing="11">
            <TextBlock Text="{Binding TasksTitle}" Classes="pbiSection" />
            <ItemsControl ItemsSource="{Binding Tasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="pbiRow" Command="{Binding Open}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <mi:MaterialIcon Kind="{Binding Icon}" Width="21" Height="21"
                                       Foreground="{Binding Brush}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Classes="pbiMuted"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <c:EmptyState Icon="CheckCircleOutline" Title="Aucune tâche affichée"
                          Hint="Les tâches connues de la journée apparaissent ici."
                          IsVisible="{Binding !HasTasks}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
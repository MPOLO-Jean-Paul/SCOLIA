<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             x:Class="Scolia.Bureau.Views.CashView">
  <ScrollViewer>
    <StackPanel Spacing="16">
      <Border Classes="filterbar">
        <WrapPanel>
          <StackPanel Classes="field">
            <TextBlock Text="Situation au" Classes="fieldlabel" />
            <CalendarDatePicker PlaceholderText="jj/mm/aaaa" SelectedDateFormat="Short" Width="180" SelectedDate="{Binding Day}" />
          </StackPanel>
        </WrapPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Figures}" ItemTemplate="{StaticResource KpiTile}" Margin="0,0,-12,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" infra:Adaptive.MinItemWidth="150" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Mouvements de la période" Classes="heading" />
          <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="340">
            <DataGrid.Columns>
              <DataGridTextColumn infra:GridPriority.Level="2" Header="Date" Binding="{Binding Date}" Width="Auto" MinWidth="130" />
              <DataGridTextColumn infra:GridPriority.Level="2" Header="Type" Binding="{Binding Type}" Width="Auto" MinWidth="120" />
              <DataGridTextColumn infra:GridPriority.Level="3" Header="Numéro" Binding="{Binding Number}" Width="Auto" MinWidth="130" />
              <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="*" MinWidth="140" />
              <DataGridTextColumn infra:GridPriority.Level="3" Header="Mode" Binding="{Binding Method}" Width="Auto" MinWidth="120" />
              <DataGridTextColumn Header="Entrée" Binding="{Binding In}" Width="Auto" MinWidth="130" />
              <DataGridTextColumn Header="Sortie" Binding="{Binding Out}" Width="Auto" MinWidth="130" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Arrêtés de caisse" Classes="heading" />
          <DataGrid ItemsSource="{Binding Closings}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="Auto" MinWidth="130" />
              <DataGridTextColumn Header="Attendu" Binding="{Binding Expected}" Width="Auto" MinWidth="140" />
              <DataGridTextColumn Header="Compté" Binding="{Binding Counted}" Width="Auto" MinWidth="140" />
              <DataGridTemplateColumn Header="Écart" Width="Auto" MinWidth="140">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Difference}" Foreground="{Binding DifferenceBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Par" Binding="{Binding ClosedBy}" Width="Auto" MinWidth="140" />
              <DataGridTextColumn Header="Observation" Binding="{Binding Note}" Width="*" MinWidth="140" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Scolia.Bureau.ViewModels"
             x:Class="Scolia.Bureau.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <!-- Pas de carte englobante : le formulaire forme la fenêtre de connexion. -->
  <StackPanel Width="340" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Image Source="avares://SCOLIA-Bureau/Assets/scolia.png" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,8" />
    <TextBlock Text="SCOLIA" FontSize="24" HorizontalAlignment="Center" />
    <TextBlock Text="Connectez-vous pour continuer" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,12" />
    <TextBox PlaceholderText="Identifiant" Text="{Binding UserName, Mode=TwoWay}" Height="44" />
    <TextBox PlaceholderText="Mot de passe" PasswordChar="•" Text="{Binding Password, Mode=TwoWay}" Height="44" />
    <Button Content="Se connecter" Command="{Binding Submit}" Height="44" HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center" Classes="accent" IsDefault="True" />
    <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#B3261E" TextWrapping="Wrap" />
    <TextBlock Text="Après 5 erreurs, le compte est verrouillé 15 minutes. Mot de passe oublié : contactez l’administrateur."
               FontSize="12" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scolia.Bureau.Views.UsersView">
  <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
    <DataGrid.Columns>
      <DataGridTextColumn Header="Identifiant" Binding="{Binding UserName}" Width="Auto" MinWidth="150" />
      <DataGridTextColumn Header="Nom complet" Binding="{Binding DisplayName}" Width="*" MinWidth="140" />
      <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="Auto" MinWidth="170" />
      <DataGridTemplateColumn Header="Compte" Width="Auto" MinWidth="120">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <StackPanel Classes="status">
                <Ellipse Width="8" Height="8" Fill="{Binding ActiveBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Active}" VerticalAlignment="Center" />
              </StackPanel>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="Dernière connexion" Binding="{Binding LastLogin}" Width="Auto" MinWidth="190" />
      <DataGridTextColumn Header="Verrouillage" Binding="{Binding Locked}" Width="Auto" MinWidth="145" />
    </DataGrid.Columns>
  </DataGrid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scolia.Bureau.Views.ReEnrollmentView">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Année cible" VerticalAlignment="Center" Classes="muted" />
        <ComboBox Width="260" ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" />
        <TextBlock Text="Cochez les apprenants à reconduire, puis choisissez leur promotion cible." Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" />
      </StackPanel>
    </Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Reconduire" Binding="{Binding Selected}" Width="Auto" MinWidth="110" />
        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" IsReadOnly="True" Width="Auto" MinWidth="105" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
        <DataGridTextColumn Header="Promotion actuelle" Binding="{Binding FromPromotion}" IsReadOnly="True" Width="Auto" MinWidth="160" />
        <DataGridTextColumn Header="Solde reporté" Binding="{Binding PreviousBalance}" IsReadOnly="True" Width="Auto" MinWidth="140" />
        <DataGridTemplateColumn Header="Promotion cible" Width="Auto" MinWidth="260">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Target}" HorizontalAlignment="Stretch" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>

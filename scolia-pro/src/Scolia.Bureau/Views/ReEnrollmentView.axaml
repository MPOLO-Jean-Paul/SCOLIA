<UserControl xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Scolia.Bureau.Controls"
             x:Class="Scolia.Bureau.Views.ReEnrollmentView">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,10">
      <Grid ColumnDefinitions="260,*" ColumnSpacing="12" infra:Adaptive.StackBelow="540">
        <StackPanel Spacing="4">
          <TextBlock Text="Année cible" Classes="fieldlabel" />
          <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Année cible de réinscription" ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{infra:Terms 'Cochez les apprenants : si leur promotion cible manque, elle sera créée automatiquement à la validation.'}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Reconduire" Binding="{Binding Selected}" Width="Auto" MinWidth="110" />
        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" IsReadOnly="True" Width="Auto" MinWidth="122" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="140" />
        <DataGridTextColumn Header="Promotion actuelle" Binding="{Binding FromPromotion}" IsReadOnly="True" Width="Auto" MinWidth="190" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Solde reporté" Binding="{Binding PreviousBalance}" IsReadOnly="True" Width="Auto" MinWidth="152" />
        <DataGridTemplateColumn Header="Promotion cible" Width="Auto" MinWidth="260">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox AutomationProperties.Name="Promotion cible" ItemsSource="{Binding Choices}" SelectedItem="{Binding Target}" HorizontalAlignment="Stretch" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <c:EmptyState Grid.Row="1" Icon="SchoolOutline" Title="{infra:Terms 'Aucun apprenant à reconduire'}" Hint="{Binding EmptyHint}" IsVisible="{Binding Items.Count, Converter={StaticResource IsEmpty}}" />
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Scolia.Bureau.Controls"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             x:Class="Scolia.Bureau.Views.EraseDataView">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Rechercher" Classes="fieldlabel" />
          <TextBox Width="260" Text="{Binding Search}" PlaceholderText="Nom ou matricule" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Apprenants concernés" Classes="fieldlabel" />
          <ComboBox Width="220" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Mot de passe" Classes="fieldlabel" />
          <TextBox Width="260" PasswordChar="•" Text="{Binding Password}" PlaceholderText="Mot de passe de votre compte" />
        </StackPanel>
      </WrapPanel>
    </Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" IsEnabled="{Binding IsSelectionScope}">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Choisir" Binding="{Binding Selected}" Width="Auto" MinWidth="80" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Matricule" Binding="{Binding Matricule}" IsReadOnly="True" Width="Auto" MinWidth="122" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Name}" IsReadOnly="True" Width="2*" MinWidth="280" />
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Classe" Binding="{Binding Promotion}" IsReadOnly="True" Width="Auto" MinWidth="99" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Statut" Binding="{Binding Status}" IsReadOnly="True" Width="Auto" MinWidth="110" />
        <DataGridTextColumn Header="Solde" Binding="{Binding Balance}" IsReadOnly="True" Width="Auto" MinWidth="130" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="2" Text="{Binding SelectionSummary}" Classes="muted" Margin="0,8,0,0" />
    <c:EmptyState Grid.Row="1" Icon="AccountOffOutline" Title="Aucun apprenant" Hint="Vérifiez l'orthographe ou effacez la recherche." IsVisible="{Binding Items.Count, Converter={StaticResource IsEmpty}}" />
  </Grid>
</UserControl>

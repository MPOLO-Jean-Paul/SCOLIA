<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scolia.Bureau.Views.ResultsView">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Promotion" VerticalAlignment="Center" Classes="muted" />
        <ComboBox Width="260" ItemsSource="{Binding Promotions}" SelectedItem="{Binding Promotion}" />
        <TextBlock Text="Période" VerticalAlignment="Center" Classes="muted" Margin="8,0,0,0" />
        <ComboBox Width="170" ItemsSource="{Binding Terms}" SelectedItem="{Binding Term}" />
      </StackPanel>
    </Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Rang" Binding="{Binding Rank}" Width="Auto" MinWidth="84" />
        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="Auto" MinWidth="122" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Name}" Width="2*" MinWidth="260" />
        <DataGridTextColumn Header="Moyenne" Binding="{Binding Average}" Width="Auto" MinWidth="107" />
        <DataGridTemplateColumn Header="Décision" Width="Auto" MinWidth="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Decision}" Foreground="{Binding DecisionBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Moyennes par cours" Binding="{Binding Courses}" Width="3*" MinWidth="480" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="1" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0"
               Text="Aucun résultat pour cette promotion : vérifiez que les notes sont saisies."
               IsVisible="{Binding Items.Count, Converter={StaticResource IsEmpty}}" />
  </Grid>
</UserControl>

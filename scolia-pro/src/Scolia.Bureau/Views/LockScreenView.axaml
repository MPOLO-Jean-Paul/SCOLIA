<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.LockScreenView">
  <!-- Mise en veille : tout l'écran est couvert ; la session attend derrière, intacte. -->
  <Grid Background="{DynamicResource BgBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="380" Margin="24,40" VerticalAlignment="Center" Spacing="14">
        <Border Width="88" Height="88" CornerRadius="44" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
          <mi:MaterialIcon Kind="LockOutline" Width="42" Height="42" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="SCOLIA est en veille" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{Binding School}" Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

        <!-- Le compte en veille -->
        <Border Background="{DynamicResource GroupBrush}" CornerRadius="20" Padding="14,10" HorizontalAlignment="Center" Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentBrush}">
              <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="240" />
              <TextBlock Text="{Binding UserName}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="240" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" FontSize="{DynamicResource FsSmall}" />

        <!-- Code -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox x:Name="LockCode" Text="{Binding Code}" PasswordChar="{Binding CodeMask}" PlaceholderText="Code PIN ou mot de passe"
                   TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True"
                   MinHeight="52" CornerRadius="14" FontSize="17" IsEnabled="{Binding NotBusy}" />
          <Button Grid.Column="1" Classes="quiet" Command="{Binding ToggleCode}" MinWidth="48" MinHeight="48" ToolTip.Tip="Afficher ou masquer le code">
            <mi:MaterialIcon Kind="{Binding EyeIcon}" Width="22" Height="22" />
          </Button>
        </Grid>
        <Border Background="{DynamicResource RedSoftBrush}" CornerRadius="14" Padding="14,10" IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>
        <Button x:Name="UnlockButton" Classes="primary" Command="{Binding Unlock}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                MinHeight="52" CornerRadius="26">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Loading" Classes="spin" Width="18" Height="18" IsVisible="{Binding Busy}" Foreground="{DynamicResource OnAccentBrush}" />
            <mi:MaterialIcon Kind="LockOpenVariantOutline" Width="18" Height="18" IsVisible="{Binding NotBusy}" />
            <TextBlock Text="Déverrouiller" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding UnlockWithBiometrics}" IsVisible="{Binding CanUseBiometrics}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="48">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Fingerprint" Width="22" Height="22" />
            <TextBlock Text="{Binding BiometricLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Classes="link" Content="Changer de compte" Command="{Binding SwitchAccount}" HorizontalAlignment="Center" Margin="0,6,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

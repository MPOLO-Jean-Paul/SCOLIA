<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.LockScreenView">
  <!-- Même identité visuelle que la connexion : fond bleu et halo, sans lourde carte ni
       horloge dominante. La reprise de session reste claire même sur un petit Android. -->
  <UserControl.Styles>
    <Style Selector="mi|MaterialIcon.inicon">
      <Setter Property="Width" Value="19" /><Setter Property="Height" Value="19" />
      <Setter Property="Margin" Value="14,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#D9FFFFFF" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="TextBox.w11.onbrand.codefield"><Setter Property="Padding" Value="42,0,86,0" /></Style>
  </UserControl.Styles>

  <Grid>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#2F7BEA" />
          <GradientStop Offset="0.5" Color="#1258D0" />
          <GradientStop Offset="1" Color="#0B2F6E" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" RadiusX="90%" RadiusY="70%">
          <GradientStop Offset="0" Color="#66FFFFFF" />
          <GradientStop Offset="0.45" Color="#1FFFFFFF" />
          <GradientStop Offset="1" Color="#00FFFFFF" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid RowDefinitions="Auto,Auto,Auto" VerticalAlignment="Center" Margin="0,24">
        <!-- En-tête identique au premier accès à l'établissement. -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Stretch" MaxWidth="420"
                    Margin="24,8,24,18" Spacing="8">
          <Border Width="96" Height="96" CornerRadius="48" Background="White"
                  HorizontalAlignment="Center" BoxShadow="0 8 24 0 #33000000">
            <Panel Width="72" Height="72">
              <Image Source="{DynamicResource ScoliaMark}" Width="62" Height="62" />
            </Panel>
          </Border>
          <TextBlock Text="{Binding School}" Foreground="White" FontSize="23" FontWeight="SemiBold"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <mi:MaterialIcon Kind="LockOutline" Width="16" Height="16" Foreground="#D9FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="Session protégée" Foreground="#E6FFFFFF" FontSize="13" FontWeight="Medium" />
          </StackPanel>
          <!-- Horloge secondaire : elle ne prend plus la place du formulaire. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="9" Margin="0,4,0,0">
            <TextBlock x:Name="LockTime" Text="{Binding Time}" Foreground="White" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Width="1" Height="19" Background="#66FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DateText}" Foreground="#D9FFFFFF" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- Les contrôles reprennent les mêmes marges et largeurs que LoginView. -->
        <StackPanel Grid.Row="1" MaxWidth="360" Margin="20,0" HorizontalAlignment="Stretch" Spacing="12">
          <Border CornerRadius="12" Background="#26FFFFFF" Padding="12,11">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Width="48" Height="48" CornerRadius="24" Background="White" VerticalAlignment="Center">
                <TextBlock Text="{Binding Initials}" FontSize="18" FontWeight="SemiBold" Foreground="#1258D0"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="17"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AccountLine}" Foreground="#E6FFFFFF" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LockedSince}" Foreground="#C8FFFFFF" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="{Binding Message}" Foreground="#E6FFFFFF" FontSize="13"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,3" />

          <!-- Le même champ verre, icône, œil et flèche que sur la page de connexion. -->
          <Panel IsVisible="{Binding RequireCode}">
            <TextBox x:Name="LockCode" Classes="w11 onbrand codefield"
                     Text="{Binding Code}" PasswordChar="•" RevealPassword="{Binding ShowCode}"
                     PlaceholderText="Code PIN ou mot de passe" MaxLength="128" MinHeight="52"
                     TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True"
                     IsEnabled="{Binding NotBusy}" />
            <mi:MaterialIcon Classes="inicon" Kind="LockOutline" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,0,5,0">
              <Button Classes="fieldicon" Command="{Binding ToggleCode}"
                      ToolTip.Tip="Afficher ou masquer le code" IsEnabled="{Binding NotBusy}">
                <mi:MaterialIcon Kind="{Binding EyeIcon}" Width="18" Height="18" Foreground="White" />
              </Button>
              <Button x:Name="UnlockButton" Classes="fieldicon go" Command="{Binding Unlock}"
                      IsEnabled="{Binding CanUnlockCode}" ToolTip.Tip="Déverrouiller (Entrée)">
                <Panel>
                  <mi:MaterialIcon Kind="Loading" Classes="spin" Width="18" Height="18" Foreground="White" IsVisible="{Binding Busy}" />
                  <mi:MaterialIcon Kind="ArrowRight" Width="20" Height="20" Foreground="White" IsVisible="{Binding NotBusy}" />
                </Panel>
              </Button>
            </StackPanel>
          </Panel>

          <!-- Poste invité : le serveur vérifie l'autorisation ; aucun mot de passe de
               l'administrateur n'est exposé à l'appareil lié. -->
          <Button Classes="glass" Command="{Binding UnlockWithDevice}" IsVisible="{Binding CanUsePairedDevice}"
                  IsEnabled="{Binding NotBusy}" MinHeight="52">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="9">
              <mi:MaterialIcon Kind="ShieldCheckOutline" Width="20" Height="20" />
              <TextBlock Text="{Binding PairedDeviceText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Button>

          <Button Classes="glass" Command="{Binding UnlockWithBiometrics}"
                  IsVisible="{Binding CanUseBiometrics}" IsEnabled="{Binding NotBusy}" MinHeight="48">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <mi:MaterialIcon Kind="Fingerprint" Width="20" Height="20" />
              <TextBlock Text="{Binding BiometricLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Button>

          <Border Background="#40E5484D" CornerRadius="8" Padding="12,10" IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="White"
                               VerticalAlignment="Top" Margin="0,1,0,0" />
              <TextBlock Grid.Column="1" Text="{Binding Error}" Foreground="White" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <Button Classes="glasslink" Command="{Binding ForgotCode}" IsEnabled="{Binding NotBusy}"
                  HorizontalAlignment="Center" MinHeight="44"
                  ToolTip.Tip="Retrouver votre compte sans déverrouiller la session">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <mi:MaterialIcon Kind="HelpCircleOutline" Width="18" Height="18" />
              <TextBlock Text="Code ou mot de passe oublié ?" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
          <Button x:Name="SwitchAccountButton" Classes="glasslink" Command="{Binding SwitchAccount}"
                  IsEnabled="{Binding NotBusy}" HorizontalAlignment="Center" MinHeight="44"
                  ToolTip.Tip="Garder cette session verrouillée et se connecter avec un autre compte">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <mi:MaterialIcon Kind="AccountSwitchOutline" Width="18" Height="18" />
              <TextBlock Text="Changer de compte" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Text="Votre session reste protégée si vous changez de compte."
                     Foreground="#B3FFFFFF" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding Footer}" Foreground="#B3FFFFFF"
                   FontSize="{DynamicResource FsSmall}" HorizontalAlignment="Stretch"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="16,22,16,8" />
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>

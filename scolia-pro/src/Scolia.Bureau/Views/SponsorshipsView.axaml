<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scolia.Bureau.Views.SponsorshipsView">
  <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
    <DataGrid.Columns>
      <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="Auto" MinWidth="122" />
      <DataGridTextColumn Header="Apprenant" Binding="{Binding Name}" Width="*" MinWidth="140" />
      <DataGridTextColumn Header="Promotion" Binding="{Binding Promotion}" Width="Auto" MinWidth="122" />
      <DataGridTextColumn Header="Garant ou organisme" Binding="{Binding Sponsor}" Width="Auto" MinWidth="198" />
      <DataGridTextColumn Header="Motif" Binding="{Binding Reason}" Width="Auto" MinWidth="170" />
      <DataGridTextColumn Header="Effet" Binding="{Binding Since}" Width="Auto" MinWidth="120" />
      <DataGridTextColumn Header="Couvert" Binding="{Binding Covered}" Width="Auto" MinWidth="130" />
      <DataGridTemplateColumn Header="État" Width="Auto" MinWidth="110">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <Panel Classes="pill">
                <Border CornerRadius="10" Background="{Binding StatusBrush}" Opacity="0.13" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="9,3,11,3">
                  <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" />
                </StackPanel>
              </Panel>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
    </DataGrid.Columns>
  </DataGrid>
</UserControl>

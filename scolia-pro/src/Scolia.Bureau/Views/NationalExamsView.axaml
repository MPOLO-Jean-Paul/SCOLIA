<UserControl xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Scolia.Bureau.Controls"
             x:Class="Scolia.Bureau.Views.NationalExamsView">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Examen" Classes="fieldlabel" />
          <ComboBox Width="260" ItemsSource="{Binding Exams}" SelectedItem="{Binding Exam}" />
        </StackPanel>
      </WrapPanel>
    </Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Classe" Binding="{Binding Dto.ClassName}" Width="Auto" MinWidth="140" />
        <DataGridTextColumn Header="Matricule" Binding="{Binding Dto.Matricule}" Width="Auto" MinWidth="110" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Dto.FullName}" Width="2*" MinWidth="240" />
        <DataGridTextColumn Header="Sexe" Binding="{Binding Dto.Gender}" Width="Auto" MinWidth="60" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Naissance" Binding="{Binding Birth}" Width="Auto" MinWidth="180" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="N° candidat" Binding="{Binding Dto.Reference}" Width="Auto" MinWidth="130" />
        <DataGridTemplateColumn Header="Résultat" Width="Auto" MinWidth="160">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Classes="status">
                <Ellipse Width="8" Height="8" Fill="{Binding ResultBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Result}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <c:EmptyState Grid.Row="1" Icon="ClipboardTextOutline" Title="Aucun candidat" Hint="Les candidats sont les élèves de 6e primaire (ENAFEP), de 8e (fin du CTEB) et de la dernière année des humanités (Examen d'État)." IsVisible="{Binding Items.Count, Converter={StaticResource IsEmpty}}" />
  </Grid>
</UserControl>

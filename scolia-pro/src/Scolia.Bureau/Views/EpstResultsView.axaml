<UserControl xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Scolia.Bureau.Controls"
             x:Class="Scolia.Bureau.Views.EpstResultsView">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Classe" Classes="fieldlabel" />
          <ComboBox Width="260" ItemsSource="{Binding Promotions}" SelectedItem="{Binding Promotion}" />
        </StackPanel>
      </WrapPanel>
    </Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Place" Binding="{Binding Rank}" Width="Auto" MinWidth="70" />
        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="Auto" MinWidth="110" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Name}" Width="2*" MinWidth="240" />
        <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="Auto" MinWidth="120" />
        <DataGridTextColumn Header="%" Binding="{Binding Percent}" Width="Auto" MinWidth="90" />
        <DataGridTextColumn Header="Échecs" Binding="{Binding Failed}" Width="Auto" MinWidth="80" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Non saisis" Binding="{Binding Missing}" Width="Auto" MinWidth="90" />
        <DataGridTemplateColumn Header="Décision" Width="Auto" MinWidth="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Classes="status">
                <Ellipse Width="8" Height="8" Fill="{Binding DecisionBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Decision}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Branches" Binding="{Binding Subjects}" Width="3*" MinWidth="420" />
      </DataGrid.Columns>
    </DataGrid>
    <c:EmptyState Grid.Row="1" Icon="CertificateOutline" Title="Aucun résultat à afficher" Hint="Validez le règlement pédagogique, définissez le maximum de chaque branche et saisissez les évaluations." IsVisible="{Binding Items.Count, Converter={StaticResource IsEmpty}}" />
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.DashboardView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="0,0,6,8">

      <!-- Rappel de sauvegarde : barre d'information de Windows, seulement s'il y a lieu -->
      <Border Background="{DynamicResource OrangeSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource RadiusSmall}" Padding="14,8" IsVisible="{Binding HasBackupLine}">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
          <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource ToneOrange}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding BackupLine}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button infra:Icons.Lead="ContentSaveOutline" Grid.Column="2" Content="Sauvegarder maintenant" Command="{Binding BackupNow}" Margin="12,0,0,0" VerticalAlignment="Center"
                  IsVisible="{Binding NotPhone}" />
          <!-- Téléphone : le bouton passe sous le message, qui garde toute la largeur. -->
          <Button infra:Icons.Lead="ContentSaveOutline" Grid.Row="1" Grid.Column="1" Content="Sauvegarder maintenant" Command="{Binding BackupNow}"
                  HorizontalAlignment="Left" Margin="0,8,0,2" IsVisible="{Binding Phone}" />
        </Grid>
      </Border>

      <!-- Journée en cours : quatre chiffres, puis les convocations et les anniversaires -->
      <Border Classes="card" Padding="0" IsVisible="{Binding HasToday}">
        <StackPanel>
          <TextBlock Text="{Binding TodayTitle}" Classes="heading" Margin="16,12,16,8" />
          <ItemsControl ItemsSource="{Binding TodayStats}" Margin="16,0,16,14">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1" infra:Adaptive.MinItemWidth="150" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="1" Margin="0,0,16,0">
                  <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
                  <TextBlock Classes="wrap2" Text="{Binding Value}" FontSize="{DynamicResource FsHeading}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip.Tip="{Binding Value}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Hint}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="{DynamicResource LineBrush}" IsVisible="{Binding HasPeople}" />
          <Grid ColumnDefinitions="*,*" Margin="16,10,16,12" IsVisible="{Binding HasPeople}" infra:Adaptive.StackBelow="560">
            <StackPanel Spacing="4" Margin="0,0,16,0">
              <TextBlock Text="Parents convoqués aujourd'hui" FontWeight="SemiBold" />
              <TextBlock Text="Aucun rendez-vous prévu." Classes="muted" IsVisible="{Binding !HasAppointments}" />
              <ItemsControl ItemsSource="{Binding Appointments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="listrow" Command="{Binding Open}" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Name}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="wrap2" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Name, Mode=OneWay}" />
                          <Run Text="{Binding Promotion, StringFormat=' · {0}', Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="muted" Margin="10,0,0,0" ToolTip.Tip="{Binding Detail}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Anniversaires" FontWeight="SemiBold" />
              <TextBlock Text="Aucun anniversaire aujourd'hui." Classes="muted" IsVisible="{Binding !HasBirthdays}" />
              <ItemsControl ItemsSource="{Binding Birthdays}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="listrow" Command="{Binding Open}" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Name}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="wrap2" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Name, Mode=OneWay}" />
                          <Run Text="{Binding Promotion, StringFormat=' · {0}', Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="muted" Margin="10,0,0,0" ToolTip.Tip="{Binding Detail}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Indicateurs de l'année -->
      <ItemsControl ItemsSource="{Binding Kpis}" ItemTemplate="{StaticResource KpiTile}" Margin="0,0,-12,-12">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><infra:AdaptiveTiles MinItemWidth="175" MaxColumns="3" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Grid ColumnDefinitions="3*,2*" infra:Adaptive.StackBelow="760">
        <!-- Encaissements par mois : l'attendu en gris, l'encaissé dans l'accent -->
        <Border Classes="card" Grid.Column="0" Margin="0,0,12,0">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" infra:Adaptive.StackBelow="430">
              <TextBlock Text="Encaissements par mois" Classes="heading" TextWrapping="Wrap" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Encaissé" Classes="muted" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.22" VerticalAlignment="Center" />
                  <TextBlock Text="Attendu" Classes="muted" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <!-- Colonnes : l'attendu en teinte claire de l'accent, l'encaissé en accent plein, posés sur une ligne de base -->
            <Grid RowDefinitions="*,Auto" IsVisible="{Binding NotPhone}">
              <Border Height="1" Background="{DynamicResource LineBrush}" VerticalAlignment="Bottom" Margin="0,0,0,22" />
              <ItemsControl ItemsSource="{Binding Months}" Height="200">
                <ItemsControl.ItemsPanel>
                  <!-- Un graphique reste sur une ligne : les mois se resserrent au lieu de passer à la ligne. -->
                  <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="5,0" ToolTip.Tip="{Binding Value}">
                      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" Classes="muted" HorizontalAlignment="Center" Margin="0,6,0,0" />
                      <Panel VerticalAlignment="Bottom" MaxWidth="34">
                        <Border Background="{DynamicResource AccentBrush}" Opacity="0.16" CornerRadius="4,4,0,0" Height="{Binding Track}" VerticalAlignment="Bottom" />
                        <StackPanel VerticalAlignment="Bottom" Spacing="3">
                          <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
                          <Border Background="{DynamicResource AccentBrush}" CornerRadius="4,4,0,0" Height="{Binding Height}" />
                        </StackPanel>
                      </Panel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
            <!-- Mobile : un mois par ligne, barre horizontale et montant lisible en entier -->
            <ItemsControl ItemsSource="{Binding Months}" IsVisible="{Binding Phone}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="52,*,Auto" Margin="0,5">
                    <TextBlock Text="{Binding Label}" Classes="muted" VerticalAlignment="Center" />
                    <Panel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                      <ProgressBar Classes="meter" Value="{Binding Track, Mode=OneWay}" Maximum="150" Opacity="0.3" />
                      <ProgressBar Classes="meter" Value="{Binding Height, Mode=OneWay}" Maximum="150" Background="Transparent" />
                    </Panel>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Retards par ancienneté et répartition -->
        <Border Classes="card" Grid.Column="1">
          <StackPanel Spacing="10">
            <TextBlock Text="Retards par ancienneté" Classes="heading" />
            <ItemsControl ItemsSource="{Binding Aging}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="4" Margin="0,4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar Classes="meter" Value="{Binding Height, Mode=OneWay}" Maximum="100" Foreground="{Binding Brush}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,6" />
            <TextBlock Text="{infra:Terms 'Répartition des apprenants'}" FontWeight="SemiBold" />
            <!-- Garçons en bleu sur une piste rose : les deux parts se lisent d'un coup d'œil -->
            <ProgressBar Classes="meter" Value="{Binding MaleShare, Mode=OneWay}" Maximum="100"
                         Foreground="{DynamicResource ToneBlue}" Background="{DynamicResource TonePink}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource ToneBlue}" VerticalAlignment="Center" />
              <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource TonePink}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding GenderText}" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="3*,2*" infra:Adaptive.StackBelow="760">
        <!-- Recouvrement par promotion -->
        <Border Classes="card" Grid.Column="0" Margin="0,0,12,0">
          <StackPanel Spacing="10">
            <TextBlock Text="Recouvrement par promotion" Classes="heading" />
            <!-- Une ligne par promotion : code et nom, jauge de recouvrement et taux ; les chiffres en dessous.
                 Aucune colonne à resserrer, rien ne déborde quelle que soit la largeur. -->
            <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Promotions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" MinWidth="64" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding Name}" />
                        <ProgressBar Grid.Column="1" Classes="meter" Value="{Binding RecoveryValue, Mode=OneWay}" Maximum="100"
                                     VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Recovery}" FontWeight="SemiBold" MinWidth="52"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Students, Mode=OneWay}" /><Run Text=" inscrits · " /><Run Text="{Binding Paying, Mode=OneWay}" /><Run Text=" payants · " /><Run Text="{Binding Sponsored, Mode=OneWay}" /><Run Text=" pris en charge · encaissé " /><Run Text="{Binding Collected, Mode=OneWay}" />
                        </TextBlock>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Derniers reçus -->
        <Border Classes="card" Grid.Column="1">
          <StackPanel Spacing="6">
            <TextBlock Text="Derniers reçus" Classes="heading" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Latest}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Number}" />
                        <TextBlock Text="{Binding Date}" Classes="muted" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Amount}" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
                        <TextBlock Text="{Binding Method}" Classes="muted" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scolia.Bureau.Views.DashboardView">
  <ScrollViewer>
    <StackPanel Spacing="16">

      <!-- Indicateurs -->
      <ItemsControl ItemsSource="{Binding Kpis}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="tile" Width="236" Margin="0,0,12,12">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" Classes="caption" />
                <TextBlock Text="{Binding Value}" Classes="kpi" Foreground="{Binding Accent}" />
                <TextBlock Text="{Binding Hint}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="3*,2*">
        <!-- Encaissements par mois : colonnes proportionnelles -->
        <Border Classes="card" Grid.Column="0" Margin="0,0,12,0">
          <StackPanel Spacing="12">
            <TextBlock Text="Encaissements par mois" Classes="heading" />
            <ItemsControl ItemsSource="{Binding Months}" Height="230">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="80" VerticalAlignment="Bottom" Spacing="4">
                    <TextBlock Text="{Binding Value}" Classes="caption" TextAlignment="Center" TextWrapping="Wrap" FontSize="10" />
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="8,8,3,3" Height="{Binding Height}" MinHeight="2" />
                    <TextBlock Text="{Binding Label}" Classes="muted" TextAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Retards par ancienneté -->
        <Border Classes="card" Grid.Column="1">
          <StackPanel Spacing="10">
            <TextBlock Text="Retards par ancienneté" Classes="heading" />
            <ItemsControl ItemsSource="{Binding Aging}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="110,*,Auto" Margin="0,4">
                    <TextBlock Text="{Binding Label}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Border Grid.Column="1" Height="10" CornerRadius="5" Background="{DynamicResource Surface2Brush}" Margin="8,0" HorizontalAlignment="Left" Width="150">
                      <Border Height="10" CornerRadius="5" Background="{DynamicResource ToneOrange}" HorizontalAlignment="Left" Width="{Binding Height}" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" FontSize="{DynamicResource FsSmall}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="3*,2*">
        <!-- Promotions : recouvrement par classe -->
        <Border Classes="card" Grid.Column="0" Margin="0,0,12,0">
          <StackPanel Spacing="10">
            <TextBlock Text="Recouvrement par promotion" Classes="heading" />
            <DataGrid ItemsSource="{Binding Promotions}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="320">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Promotion" Binding="{Binding Code}" Width="Auto" MinWidth="90" />
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Apprenants" Binding="{Binding Students}" Width="Auto" MinWidth="95" />
                <DataGridTextColumn Header="Attendu" Binding="{Binding Expected}" Width="Auto" MinWidth="130" />
                <DataGridTextColumn Header="Encaissé" Binding="{Binding Collected}" Width="Auto" MinWidth="130" />
                <DataGridTemplateColumn Header="Recouvrement" Width="Auto" MinWidth="170">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,56" Margin="0,0,10,0">
                        <ProgressBar Value="{Binding RecoveryValue}" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Recovery}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

        <!-- Derniers reçus et répartition par sexe -->
        <Border Classes="card" Grid.Column="1">
          <StackPanel Spacing="12">
            <TextBlock Text="Derniers reçus" Classes="heading" />
            <ItemsControl ItemsSource="{Binding Latest}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <StackPanel>
                      <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Date}" Classes="muted" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding Amount}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding Method}" Classes="muted" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Répartition des apprenants" Classes="heading" Margin="0,8,0,0" />
            <ProgressBar Value="{Binding MaleShare}" Maximum="100" Height="8" />
            <TextBlock Text="{Binding GenderText}" Classes="muted" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

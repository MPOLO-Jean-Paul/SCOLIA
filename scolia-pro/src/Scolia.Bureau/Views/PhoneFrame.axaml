<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.PhoneFrame">
  <UserControl.Resources>
    <!-- Rubrique de navigation : un métier et ses outils, chacun sur une ligne haute avec son icône de couleur -->
    <DataTemplate x:Key="NavGroup">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Classes="phonegrouptitle" IsVisible="{Binding HasTitle}" />
                  <Border Classes="phonegroup" Margin="0,0,0,0">
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Classes="phonerow" Classes.selected="{Binding IsSelected}" Command="{Binding Open}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Border Classes="appicon medium" Background="{Binding Brush}" Margin="0,0,12,0">
                                <mi:MaterialIcon Kind="{Binding Icon}" />
                              </Border>
                              <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource MutedBrush}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid ColumnDefinitions="Auto,*">
  <Border Grid.Column="0" Classes="phonerail" IsVisible="{Binding PhoneRail}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="RailPanel" Margin="12,14,12,20">
        <Grid ColumnDefinitions="Auto,*" Margin="2,0,0,6">
          <Panel Width="40" Height="40" Margin="0,0,10,0">
            <Image Source="{Binding SchoolLogo}" IsVisible="{Binding HasSchoolLogo}" />
            <Image Source="{DynamicResource ScoliaMark}" IsVisible="{Binding !HasSchoolLogo}" Width="32" Height="32" />
          </Panel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding SchoolTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SchoolYearLine}" Classes="muted" FontSize="{DynamicResource FsSmall}" />
          </StackPanel>
        </Grid>
        <Border Classes="phonegroup" Margin="0,8,0,0">
          <Button Classes="phonerow" Click="OnAccountClick">
            <Grid ColumnDefinitions="Auto,*">
              <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource ToneNeutral}" Margin="0,0,12,0">
                <TextBlock Text="{Binding UserInitials}" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Compte et réglages" Classes="muted" FontSize="{DynamicResource FsSmall}" />
              </StackPanel>
            </Grid>
          </Button>
        </Border>
        <ItemsControl ItemsSource="{Binding Navigation}" ItemTemplate="{StaticResource NavGroup}" />
        <Border Classes="phonegroup" Margin="0,18,0,0">
          <Button Classes="phonerow" Classes.selected="{Binding PhoneMenuOpen}" Click="OnMenuClick">
            <Grid ColumnDefinitions="Auto,*">
              <Border Classes="appicon medium" Background="{DynamicResource ToneNeutral}" Margin="0,0,12,0"><mi:MaterialIcon Kind="DotsGrid" /></Border>
              <TextBlock Grid.Column="1" Text="Commandes et réglages" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Border>

  <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
    <!-- Barre du haut -->
    <Border Grid.Row="0" Classes="phonebar">
      <StackPanel>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <Button Classes="phoneicon" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" ToolTip.Tip="Retour">
          <mi:MaterialIcon Kind="ChevronLeft" />
        </Button>
        <Panel Width="44" Height="44" IsVisible="{Binding !CanGoBack}">
          <Image Source="{Binding SchoolLogo}" IsVisible="{Binding HasSchoolLogo}" Width="30" Height="30" />
          <Image Source="{DynamicResource ScoliaMark}" IsVisible="{Binding !HasSchoolLogo}" Width="26" Height="26" />
        </Panel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
          <!-- Petit téléphone : un titre long passe sur deux lignes plutôt que d'être coupé -->
          <TextBlock Text="{Binding PhonePage.Heading}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" LineHeight="20" />
          <TextBlock Text="{Binding PhonePage.Subtitle}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2"
                     IsVisible="{Binding PhonePage.Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <!-- Présence : les autres postes connectés ; le point vert bat quand l'un d'eux enregistre quelque chose -->
        <Button Grid.Column="2" Classes="phoneicon" Command="{Binding NetworkCommand}" ToolTip.Tip="Réseau et activité">
          <Panel>
            <mi:MaterialIcon Kind="CloudOffOutline" Foreground="{DynamicResource ToneOrange}" IsVisible="{Binding Sync.Offline}" />
            <Panel IsVisible="{Binding Sync.Online}">
              <mi:MaterialIcon Kind="AccountMultipleOutline" />
              <Border Classes="livedot" Classes.pulse="{Binding Sync.Pulse}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" />
              <Border Classes="peercount" IsVisible="{Binding Sync.HasPeers}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-4">
                <TextBlock Text="{Binding Sync.PeersCount}" />
              </Border>
            </Panel>
          </Panel>
        </Button>
        <Button Grid.Column="3" Classes="phoneicon" Command="{Binding SearchCommand}" ToolTip.Tip="Rechercher">
          <mi:MaterialIcon Kind="Magnify" />
        </Button>
        <Button Grid.Column="4" Classes="phoneicon" Click="OnActionsClick" IsVisible="{Binding PhonePage.HasHeaderActions}" ToolTip.Tip="Actions de la page">
          <mi:MaterialIcon Kind="DotsHorizontalCircleOutline" />
        </Button>
      </Grid>
      <!-- Hors ligne : le travail continue, et l'utilisateur sait ce qui attend d'être envoyé -->
      <Button Classes="livestrip offline" Command="{Binding NetworkCommand}" IsVisible="{Binding Sync.Offline}">
        <Grid ColumnDefinitions="Auto,2*,3*" ColumnSpacing="8">
          <mi:MaterialIcon Kind="CloudOffOutline" Width="16" Height="16" />
          <TextBlock Grid.Column="1" Text="{Binding Sync.StatusText}" FontWeight="SemiBold" />
          <TextBlock Grid.Column="2" Text="· envoi au retour de l'ordinateur principal" />
        </Grid>
      </Button>
      <Button Classes="livestrip conflict" Command="{Binding NetworkCommand}" IsVisible="{Binding Sync.HasConflicts}">
        <Grid ColumnDefinitions="Auto,2*,3*" ColumnSpacing="8">
          <mi:MaterialIcon Kind="AlertCircleOutline" Width="16" Height="16" />
          <TextBlock Grid.Column="1" Text="{Binding Sync.Conflicts}" FontWeight="SemiBold" />
          <TextBlock Grid.Column="2" Text="opération(s) refusée(s) : touchez pour décider" />
        </Grid>
      </Button>
      </StackPanel>
    </Border>

    <!-- Page : elle défile en entier, jamais sur le côté -->
    <ScrollViewer x:Name="PhoneScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <TransitioningContentControl x:Name="PhoneHost" Content="{Binding PhonePage}" Margin="12,12,12,20" />
    </ScrollViewer>
    <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding PhonePage.Busy}" VerticalAlignment="Top" Height="2" MinHeight="2" />
    <!-- L'activité en arrière-plan est signalée par le point de présence dans l'en-tête. -->
    <!-- Des données ont changé ailleurs pendant une saisie : rien ne bouge tant qu'on ne le demande pas -->
    <Button Grid.Row="1" Classes="remotechip" Command="{Binding ApplyRemoteCommand}" IsVisible="{Binding RemoteWaiting}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <mi:MaterialIcon Kind="ArrowDownBoldCircleOutline" Width="16" Height="16" />
        <TextBlock Text="Nouvelles données · Afficher" />
      </StackPanel>
    </Button>

    <!-- Menu : tous les outils, le compte et la déconnexion -->
    <Border Grid.Row="0" Grid.RowSpan="2" Classes="phonemenu" Background="{DynamicResource BgBrush}" IsVisible="{Binding PhoneMenuOpen}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="MenuPanel" Margin="12,12,12,20">
          <Grid ColumnDefinitions="Auto,*" Margin="2,4,0,4">
            <Panel Width="44" Height="44" Margin="0,0,10,0">
              <Image Source="{Binding SchoolLogo}" IsVisible="{Binding HasSchoolLogo}" />
              <Image Source="{DynamicResource ScoliaMark}" IsVisible="{Binding !HasSchoolLogo}" Width="34" Height="34" />
            </Panel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding SchoolTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SchoolYearLine}" Classes="muted" />
            </StackPanel>
          </Grid>

          <Border Classes="phonegroup" Margin="0,12,0,0">
            <StackPanel>
              <Button Classes="phonerow" Click="OnAccountClick">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource ToneNeutral}" Margin="0,0,12,0">
                    <TextBlock Text="{Binding UserInitials}" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Compte, poste et réglages" Classes="muted" FontSize="{DynamicResource FsSmall}" />
                  </StackPanel>
                  <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Navigation}" ItemTemplate="{StaticResource NavGroup}" />

          <!-- Commandes qui ne sont pas des pages : créations, exports, sauvegardes, contrôles -->
          <ItemsControl ItemsSource="{Binding PhoneTools}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Classes="phonegrouptitle" />
                  <Border Classes="phonegroup">
                    <ItemsControl ItemsSource="{Binding Commands}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Classes="phonerow" Command="{Binding Command}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Border Classes="appicon medium" Background="{Binding Brush}" Margin="0,0,12,0">
                                <mi:MaterialIcon Kind="{Binding Icon}" />
                              </Border>
                              <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                              <mi:MaterialIcon Grid.Column="2" Kind="Check" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsOn}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="phonegroup" Margin="0,18,0,0">
            <StackPanel>
              <Button Classes="phonerow" Command="{Binding SearchCommand}">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Classes="appicon medium" Background="{DynamicResource ToneNeutral}" Margin="0,0,12,0"><mi:MaterialIcon Kind="Magnify" /></Border>
                  <TextBlock Grid.Column="1" Text="Rechercher" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Classes="phonerow" Click="OnLogoutClick">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Classes="appicon medium" Background="{DynamicResource ToneRed}" Margin="0,0,12,0"><mi:MaterialIcon Kind="Logout" /></Border>
                  <TextBlock Grid.Column="1" Text="Se déconnecter" VerticalAlignment="Center" Foreground="{DynamicResource ToneRed}" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding ServerLine}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Onglets du bas -->
    <Border Grid.Row="2" Classes="phonetabs" IsVisible="{Binding PhoneBottomTabs}">
      <Grid x:Name="TabGrid" ColumnDefinitions="*,Auto">
        <ItemsControl x:Name="Tabs" ItemsSource="{Binding PhoneTabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="phonetab" Classes.selected="{Binding IsSelected}" Command="{Binding Open}">
                <StackPanel Spacing="2">
                  <mi:MaterialIcon Kind="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding TabLabel}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Column="1" x:Name="MenuTab" Classes="phonetab" Classes.selected="{Binding PhoneMenuSelected}" Click="OnMenuClick" MinWidth="72">
          <StackPanel Spacing="2">
            <mi:MaterialIcon Kind="Menu" Width="24" Height="24" HorizontalAlignment="Center" />
            <TextBlock Text="Menu" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

  </Grid>

    <!-- Feuille d'actions : le voile referme la feuille -->
    <Grid Grid.ColumnSpan="2" Classes="sheethost" IsVisible="{Binding HasSheet}">
      <Border Background="{DynamicResource ScrimBrush}" PointerPressed="OnScrimPressed" />
      <Border x:Name="ActionSheet" Classes="phonesheet">
        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
        <Grid x:Name="SheetPanel" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="2">
          <Border Width="40" Height="5" CornerRadius="3" Background="{DynamicResource LineStrongBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
          <TextBlock Grid.Row="1" Text="{Binding Sheet.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="12,0,12,0" />
          <TextBlock Grid.Row="2" Text="{Binding Sheet.Subtitle}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" Margin="12,0,12,6" IsVisible="{Binding Sheet.HasSubtitle}" />
          <ScrollViewer Grid.Row="3" MaxHeight="440" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Sheet.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="sheetitem" Classes.danger="{Binding Danger}" Classes.emphasis="{Binding Emphasis}" Command="{Binding Command}" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <mi:MaterialIcon Kind="{Binding Icon}" Width="22" Height="22" Foreground="{Binding Brush}" Margin="0,0,14,0" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,6">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                      </StackPanel>
                      <mi:MaterialIcon Grid.Column="2" Kind="Check" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" IsVisible="{Binding IsChecked}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button x:Name="CancelSheetButton" Grid.Row="4" Classes="sheetitem" Click="OnSheetCancel" HorizontalContentAlignment="Center" Margin="0,6,0,0" Background="{DynamicResource GroupBrush}">
            <TextBlock Text="Annuler" FontWeight="SemiBold" />
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

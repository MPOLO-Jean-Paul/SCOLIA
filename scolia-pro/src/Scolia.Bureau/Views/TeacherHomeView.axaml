<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.TeacherHomeView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="0" Margin="0,0,6,8">

    <!-- Android : exactement les composants de l'accueil administrateur/secrétariat :
         phonegroup, groupcaps, settingsentry, appicon et les ressources du thème. -->
    <StackPanel Spacing="12" Margin="0,0,0,10" IsVisible="{Binding Phone}">

      <Border Classes="phonegroup">
        <StackPanel Spacing="0">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="14,14,14,12">
            <Border Classes="appicon large" Background="{DynamicResource TonePurple}">
              <mi:MaterialIcon Kind="AccountSchool" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{Binding Greeting}" FontSize="{DynamicResource FsHeading}" FontWeight="SemiBold"
                         TextWrapping="Wrap" MaxLines="3" />
              <TextBlock Text="{Binding Role}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="14,0,0,0" />
          <Button Classes="settingsentry" Command="{Binding EncodeByCode}" IsVisible="{Binding !IsBlocked}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Classes="appicon medium" Background="{DynamicResource ToneBlue}">
                <mi:MaterialIcon Kind="Pen" />
              </Border>
              <TextBlock Grid.Column="1" Text="Encoder mes cotes" FontWeight="SemiBold" VerticalAlignment="Center" />
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Width="18" Height="18" />
            </Grid>
          </Button>
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="54,0,0,0" />
          <Button Classes="settingsentry" Command="{Binding ChooseCode}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Classes="appicon medium" Background="{DynamicResource ToneIndigo}">
                <mi:MaterialIcon Kind="ShieldLockOutline" />
              </Border>
              <TextBlock Grid.Column="1" Text="Mon code d'accès" VerticalAlignment="Center" />
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Width="18" Height="18" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <!-- L'accès provisoire est traité comme les alertes du secrétariat. -->
      <Border Classes="phonegroup" IsVisible="{Binding IsBlocked}">
        <StackPanel Spacing="10" Margin="14,12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="appicon medium" Background="{DynamicResource ToneOrange}">
              <mi:MaterialIcon Kind="KeyChange" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Blocked}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
          <Button Classes="primary" Content="Choisir mon code" Command="{Binding ChooseCode}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="5" IsVisible="{Binding !IsBlocked}">
        <TextBlock Text="APERÇU DE MON ACTIVITÉ" Classes="groupcaps" />
        <Border Classes="phonegroup">
          <ItemsControl ItemsSource="{Binding Stats}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinHeight="58" Margin="12,7">
                    <Border Classes="appicon medium" Background="{Binding Brush}">
                      <mi:MaterialIcon Kind="{Binding Icon}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="{DynamicResource FsSmall}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextAlignment="Right" Margin="6,0,0,0" TextWrapping="Wrap" />
                  </Grid>
                  <Border Height="1" Background="{DynamicResource LineBrush}" Margin="54,0,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <StackPanel Spacing="5" IsVisible="{Binding !IsBlocked}">
        <TextBlock Text="MES COURS" Classes="groupcaps" />
        <Border Classes="phonegroup">
          <StackPanel Spacing="0">
            <TextBlock Classes="muted" TextWrapping="Wrap" Margin="14,16"
                       Text="Aucun cours ne vous est attribué cette année. Contactez le secrétariat."
                       IsVisible="{Binding NoCourses}" />
            <ItemsControl ItemsSource="{Binding Courses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <Button Classes="settingsentry" Command="{Binding Open}"
                            ToolTip.Tip="Ouvrir la feuille de ce cours">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                     VerticalAlignment="Center" />
                          <mi:MaterialIcon Grid.Column="1" Kind="ChevronRight"
                                           Width="18" Height="18" Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Promotion}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Details}" Classes="muted" FontSize="{DynamicResource FsSmall}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,3,0,0">
                          <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}"
                                     FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Progress}" Classes="muted"
                                     FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Classes="slim" Value="{Binding Percent}" Maximum="100" />
                      </StackPanel>
                    </Button>
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="12,0,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="5" IsVisible="{Binding !IsBlocked}">
        <TextBlock Text="ANNONCES" Classes="groupcaps" />
        <Border Classes="phonegroup">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="12,12"
                  IsVisible="{Binding !HasNotices}">
              <Border Classes="appicon medium" Background="{DynamicResource ToneOrange}">
                <mi:MaterialIcon Kind="BellOutline" />
              </Border>
              <TextBlock Grid.Column="1" Text="Aucune annonce récente." Classes="muted"
                         VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Notices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="3" Margin="14,10">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding When}" Classes="muted" FontSize="{DynamicResource FsSmall}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Text="RÈGLES DE L'ENCODAGE" Classes="groupcaps" />
        <Border Classes="phonegroup">
          <ItemsControl ItemsSource="{Binding RuleItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="12,10" MinHeight="40">
                    <Border Classes="appicon medium" Background="{Binding Brush}">
                      <mi:MaterialIcon Kind="{Binding Icon}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                  </Grid>
                  <Border Height="1" Background="{DynamicResource LineBrush}" Margin="54,0,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="16" MaxWidth="1180" IsVisible="{Binding NotPhone}">

      <!-- Accueil personnel : qui est connecté et à quel titre -->
      <Border Classes="card" Padding="20,16">
        <Grid ColumnDefinitions="Auto,*,Auto" infra:Adaptive.StackBelow="560">
          <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource PurpleSoftBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
            <mi:MaterialIcon Kind="AccountSchool" Width="26" Height="26" Foreground="{DynamicResource TonePurple}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding Greeting}" FontSize="{DynamicResource FsHeading}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Role}" Classes="muted" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="primary" infra:Icons.Lead="Pen" Content="Encoder mes cotes" Command="{Binding EncodeByCode}" />
            <Button infra:Icons.Lead="ShieldLockOutline" Content="Mon code d'accès" Command="{Binding ChooseCode}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Code provisoire : rien ne s'ouvre avant le choix de son propre code -->
      <Border Background="{DynamicResource OrangeSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusSmall}" Padding="16,12" IsVisible="{Binding IsBlocked}">
        <Grid ColumnDefinitions="Auto,*,Auto" infra:Adaptive.StackBelow="560">
          <mi:MaterialIcon Kind="KeyChange" Width="22" Height="22" Foreground="{DynamicResource ToneOrange}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Grid.Column="1" Text="{Binding Blocked}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="primary" infra:Icons.Lead="ShieldLockOutline" Content="Choisir mon code" Command="{Binding ChooseCode}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Où j'en suis : quatre chiffres -->
      <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource KpiTile}" Margin="0,0,-12,-12" IsVisible="{Binding !IsBlocked}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="4" infra:Adaptive.MinItemWidth="170" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Grid ColumnDefinitions="3*,2*" infra:Adaptive.StackBelow="820" IsVisible="{Binding !IsBlocked}">
        <!-- Mes cours : une carte par cours, ouverte d'un clic sur sa feuille -->
        <Border Classes="card" Grid.Column="0" Margin="0,0,12,12">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="BookOpenVariant" Width="20" Height="20" Foreground="{DynamicResource TonePurple}" VerticalAlignment="Center" />
              <TextBlock Text="Mes cours" Classes="heading" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding NoCourses}"
                       Text="Aucun cours ne vous est attribué cette année. Le secrétariat attribue les cours dans « Gestion des délibérations › Enseignants et cours »." />
            <ItemsControl ItemsSource="{Binding Courses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="listrow" Command="{Binding Open}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" ToolTip.Tip="Ouvrir la feuille de ce cours">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <Border Grid.Column="1" CornerRadius="10" Padding="10,2" BorderThickness="1" BorderBrush="{Binding StateBrush}" VerticalAlignment="Top" Margin="10,0,0,0">
                        <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" TextWrapping="Wrap">
                        <Run Text="{Binding Promotion, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Details, Mode=OneWay}" />
                      </TextBlock>
                      <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <ProgressBar Classes="slim" Value="{Binding Percent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Progress}" Classes="muted" Margin="10,0,0,0" VerticalAlignment="Center" />
                      </Grid>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Spacing="12">
          <!-- Annonces de la délibération -->
          <Border Classes="card">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="BellOutline" Width="20" Height="20" Foreground="{DynamicResource ToneOrange}" VerticalAlignment="Center" />
                <TextBlock Text="Annonces" Classes="heading" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="Aucune annonce récente." Classes="muted" IsVisible="{Binding !HasNotices}" />
              <ItemsControl ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="1" Margin="0,0,0,8">
                      <TextBlock>
                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding When, StringFormat=' · {0}', Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Text}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Règles de l'encodage décidées par le secrétariat -->
          <Border Classes="card">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="ShieldCheckOutline" Width="20" Height="20" Foreground="{DynamicResource ToneTeal}" VerticalAlignment="Center" />
                <TextBlock Text="Règles de l'encodage" Classes="heading" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Rules}" TextWrapping="Wrap" LineHeight="22" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Règles visibles même avec le code provisoire -->
      <Border Classes="card" IsVisible="{Binding IsBlocked}">
        <StackPanel Spacing="8">
          <TextBlock Text="Règles de l'encodage" Classes="heading" />
          <TextBlock Text="{Binding Rules}" TextWrapping="Wrap" LineHeight="22" />
        </StackPanel>
      </Border>
    </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

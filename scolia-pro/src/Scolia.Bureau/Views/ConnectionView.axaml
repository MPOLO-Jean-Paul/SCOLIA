<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:views="using:Scolia.Bureau.Views"
             x:Class="Scolia.Bureau.Views.ConnectionView">
  <Grid Background="{DynamicResource BgBrush}">
    <ScrollViewer>
    <StackPanel MaxWidth="540" Margin="20,24" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
      <!-- Retour : on ne reste jamais bloqué ici quand un établissement est déjà relié -->
      <Button x:Name="ChooserBack" Classes="ghost" Command="{Binding Back}" IsVisible="{Binding CanGoBack}" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
          <TextBlock Text="Retour" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Image Source="{DynamicResource ScoliaMark}" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,4" />
      <TextBlock Text="Rejoindre votre établissement" Classes="title" FontSize="{DynamicResource FsDisplay}" HorizontalAlignment="Center" TextAlignment="Center" />
      <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding Searching}" Width="220" Height="3" MinHeight="3" HorizontalAlignment="Center" />

      <!-- Code QR du serveur : la voie la plus simple, quel que soit le réseau -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <Border Classes="appicon large" Background="{DynamicResource ToneBlue}" Margin="0,0,14,0" VerticalAlignment="Top"><mi:MaterialIcon Kind="QrcodeScan" /></Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="Relier avec le code QR du serveur" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ScanHint}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}" />
          </StackPanel>
          <Button x:Name="ScanCodeButton" Grid.Row="1" Grid.ColumnSpan="2" Classes="primary" Command="{Binding ScanCode}" IsEnabled="{Binding NotSearching}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="QrcodeScan" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ScanLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Row="2" Grid.ColumnSpan="2" Command="{Binding ImportQrImage}" IsVisible="{Binding CanImportQrImage}"
                  IsEnabled="{Binding NotSearching}" Content="Choisir une photo du QR code" HorizontalAlignment="Stretch"
                  MinHeight="40" Margin="0,8,0,0" />
          <!-- Ordinateur sans appareil photo : le code copié sur le serveur se colle ici -->
          <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,0" IsVisible="{Binding CanPasteCode}">
            <TextBox Classes="w11" Text="{Binding Invitation}" PlaceholderText="Ou collez le code copié sur le serveur" />
            <Button Grid.Column="1" Content="Rejoindre" Command="{Binding JoinInternet}" IsEnabled="{Binding NotSearching}" />
          </Grid>
        </Grid>
      </Border>

      <!-- Serveurs trouvés : une ligne par établissement, façon réglages macOS -->
      <Border Classes="card" Padding="0" IsVisible="{Binding HasServers}">
        <ItemsControl ItemsSource="{Binding Servers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,14">
                <Border Classes="appicon medium" Background="{DynamicResource ToneBlue}" Margin="0,0,14,0"><mi:MaterialIcon Kind="{Binding Icon}" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding School}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Classes="primary" Content="Rejoindre" Command="{Binding Join}" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,6,0,0">
        <Button Content="Rechercher à nouveau" Command="{Binding Search}" IsEnabled="{Binding NotSearching}" />
        <Button Classes="ghost" Content="Utiliser cet ordinateur comme serveur" Command="{Binding UseThisComputer}" IsVisible="{Binding DesktopCanBeServer}" />
      </StackPanel>

      <!-- Téléphone : sans ordinateur dans l'établissement, il en devient le serveur -->
      <Border Classes="card" IsVisible="{Binding PhoneCanBeServer}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="appicon large" Background="{DynamicResource ToneGreen}" Margin="0,0,14,0" VerticalAlignment="Top"><mi:MaterialIcon Kind="CellphoneLink" /></Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Pas d'ordinateur ? Ce téléphone sera le serveur" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}"
                         Text="L'établissement se configure sur ce téléphone et ses données y sont gardées. Les autres téléphones et ordinateurs le trouvent sur le même Wi-Fi et s'y connectent." />
            </StackPanel>
          </Grid>
           <Button Classes="primary" Command="{Binding UseThisComputer}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="Configurer sur ce téléphone" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Appareils autorisés par Tailscale : aucune découverte UDP distante, jamais d'identifiants VPN dans SCOLIA. -->
      <Expander Header="Option avancée : Tailscale privé (facultatif)" IsExpanded="False">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="appicon medium" Background="{DynamicResource ToneTeal}"><mi:MaterialIcon Kind="ShieldLockOutline" /></Border>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="Réseau privé Tailscale" FontWeight="SemiBold" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Tailscale est facultatif. Si Render est activé sur le serveur principal, le QR officiel permet aussi la connexion sur des réseaux Internet différents, sans VPN." />
            </StackPanel>
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Sur le téléphone ou PC principal, laissez SCOLIA en mode serveur. Entrez ci-dessous son IP Tailscale ou son nom MagicDNS complet." />
          <TextBlock Text="{Binding Installer.NetworkSummary}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
          <Button Classes="ghost" Content="{Binding Installer.ActionText}" Command="{Binding PrepareTailnet}"
                  IsEnabled="{Binding NotSearching}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <TextBox Classes="w11" Text="{Binding TailscaleAddress}" PlaceholderText="100.110.22.33:5080 ou machine.tailnet.ts.net:5080" />
          <Button Classes="primary" Content="Rejoindre par Tailscale" Command="{Binding ConnectTailnet}"
                  IsEnabled="{Binding NotSearching}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap"
                     Text="Tailscale doit rester connecté sur les deux appareils. Le serveur du téléphone utilise une notification Android ; sa disponibilité permanente ne peut pas être garantie si Android arrête l’application." />
        </StackPanel>
      </Border>
      </Expander>

      <!-- Adresse saisie : quand le Wi-Fi empêche la recherche automatique -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding AddressTitle}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding AddressHint}" Classes="muted" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Classes="w11" Text="{Binding Address}" PlaceholderText="192.168.1.10" />
            <Button Grid.Column="1" Classes="primary" Content="Se connecter" Command="{Binding ConnectAddress}" IsEnabled="{Binding NotSearching}" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" FontSize="{DynamicResource FsSmall}" IsVisible="{Binding DesktopCanBeServer}"
                 Text="Sur l'ordinateur principal, SCOLIA doit être ouvert et partagé : il le propose à la première connexion, ou dans Fichier &gt; Poste et réseau." />
      <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" FontSize="{DynamicResource FsSmall}" IsVisible="{Binding IsPhone}"
                 Text="Le serveur de l'établissement, ordinateur ou téléphone, doit avoir SCOLIA ouvert et être joignable par Wi-Fi ou par la liaison Internet sécurisée." />
    </StackPanel>
    </ScrollViewer>
    <!-- Assistant Tailscale commun (téléchargement et installation depuis SCOLIA). -->
    <views:TailscaleWizardView />
  </Grid>
</UserControl>

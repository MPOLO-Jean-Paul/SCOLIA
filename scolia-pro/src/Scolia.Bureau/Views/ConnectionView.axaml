<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.ConnectionView">
  <UserControl.Styles>
    <!-- Les cartes restent lisibles et les actions se replient quand la largeur utile est réduite. -->
    <Style Selector="Grid.compact StackPanel.iosconnectbody"><Setter Property="Margin" Value="12,12,12,20" /><Setter Property="Spacing" Value="12" /></Style>
    <Style Selector="Grid.compact Border.iosconnectcard"><Setter Property="Padding" Value="13" /><Setter Property="CornerRadius" Value="17" /></Style>
    <Style Selector="Grid.compact TextBlock.iosconnecttitle"><Setter Property="FontSize" Value="22" /></Style>
    <Style Selector="Border.iosconnectcard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BoxShadow" Value="0 9 26 0 #120F2B6B" />
    </Style>
    <Style Selector="Button.iosconnectprimary">
      <Setter Property="Background" Value="#1769E6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="55" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.iosconnectsecondary">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="49" />
    </Style>
    <Style Selector="TextBox.iosconnectfield">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MinHeight" Value="52" />
    </Style>
  </UserControl.Styles>
  <Grid Background="{DynamicResource BgBrush}">
    <Grid x:Name="ClassicConnectionScreen">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !PairingInProgress}">
      <StackPanel MaxWidth="520" Margin="20,22,20,26" HorizontalAlignment="Center" Spacing="12">
        <Button infra:Icons.Lead="ArrowLeft" Classes="ghost" Command="{Binding Back}" IsVisible="{Binding CanGoBack}" HorizontalAlignment="Left"
                Content="Retour" />
        <Image Source="{DynamicResource ScoliaMark}" Width="52" Height="52" HorizontalAlignment="Center" />
        <TextBlock Text="Rejoindre votre établissement" Classes="title" FontSize="{DynamicResource FsDisplay}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="Un seul code pour se connecter ici ou à distance."
                   Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Message}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Searching}" Width="200" Height="3"
                     MinHeight="3" HorizontalAlignment="Center" />

        <!-- Le code du responsable autorise l'appareil : SCOLIA choisit le Wi-Fi ou Render. -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Classes="appicon large" Background="{DynamicResource ToneBlue}" VerticalAlignment="Top">
                <mi:MaterialIcon Kind="QrcodeScan" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="Relier avec le QR code" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ScanHint}" Classes="muted" TextWrapping="Wrap"
                           FontSize="{DynamicResource FsSmall}" />
              </StackPanel>
            </Grid>
            <Button Classes="primary" Command="{Binding ScanCode}" IsEnabled="{Binding NotSearching}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="46">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="QrcodeScan" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ScanLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ImportQrImage}" IsVisible="{Binding CanImportQrImage}"
                    IsEnabled="{Binding NotSearching}" Content="Choisir une image du code QR"
                    HorizontalAlignment="Stretch" MinHeight="40" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanPasteCode}">
              <TextBox Classes="w11" Text="{Binding Invitation}" PlaceholderText="Coller le code d'invitation" />
              <Button Grid.Column="1" Content="Valider" Command="{Binding JoinInternet}"
                      IsEnabled="{Binding NotSearching}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="0" IsVisible="{Binding HasServers}">
          <ItemsControl ItemsSource="{Binding Servers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,12" ColumnSpacing="10">
                  <Border Classes="appicon medium" Background="{DynamicResource ToneTeal}">
                    <mi:MaterialIcon Kind="{Binding Icon}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding School}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button infra:Icons.Lead="LoginVariant" Grid.Column="2" Classes="primary" Content="Rejoindre" Command="{Binding Join}"
                          VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Classes="appicon medium" Background="{DynamicResource ToneGreen}">
                <mi:MaterialIcon Kind="Wifi" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Connexion sur le réseau local" FontWeight="SemiBold" />
                <TextBlock Text="Pour les appareils sur le même Wi-Fi."
                           Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <Button infra:Icons.Lead="Magnify" Content="Rechercher un serveur proche" Command="{Binding Search}"
                    IsEnabled="{Binding NotSearching}" HorizontalAlignment="Stretch" />
            <Expander Header="Saisir une adresse locale" IsExpanded="False">
              <StackPanel Spacing="8" Margin="6,8">
                <TextBlock Text="{Binding AddressHint}" Classes="muted" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Classes="w11" Text="{Binding Address}" PlaceholderText="192.168.1.10" />
                  <Button infra:Icons.Lead="LoginVariant" Grid.Column="1" Classes="primary" Content="Rejoindre" Command="{Binding ConnectAddress}"
                          IsEnabled="{Binding NotSearching}" />
                </Grid>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Button infra:Icons.Lead="ServerOutline" Classes="ghost" Content="Configurer cet ordinateur comme serveur" Command="{Binding UseThisComputer}"
                IsVisible="{Binding DesktopCanBeServer}" HorizontalAlignment="Center" />
        <Button infra:Icons.Lead="ServerOutline" Classes="ghost" Content="Configurer cet appareil comme serveur" Command="{Binding UseThisComputer}"
                IsVisible="{Binding PhoneCanBeServer}" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="{DynamicResource FsSmall}"
                   Text="Le serveur principal doit rester allumé et connecté pour les opérations à distance." />
      </StackPanel>
    </ScrollViewer>

    <!-- Une fois le QR lu : état plein écran, sans formulaires ni boutons qui se chevauchent. -->
    <ScrollViewer IsVisible="{Binding PairingInProgress}" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid RowDefinitions="*,Auto,*" MinHeight="530" Margin="0,12">
        <Border Grid.Row="1" Classes="card" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                Margin="18,12" MaxWidth="420" HorizontalAlignment="Stretch" CornerRadius="20" Padding="20,26">
          <StackPanel Spacing="16">
            <Border Width="80" Height="80" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}"
                    HorizontalAlignment="Center">
              <mi:MaterialIcon Kind="Cellphone" Width="40" Height="40"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Vérification de l’appareil" FontSize="21" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="SCOLIA vérifie la liaison sécurisée avec votre établissement."
                       Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="14">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Message}" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Height="5" MinHeight="5" />
              </StackPanel>
            </Border>
            <TextBlock Text="L'accueil s'ouvrira automatiquement lorsque la connexion sera autorisée."
                       Classes="muted" FontSize="{DynamicResource FsSmall}"
                       TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    </Grid>
    <!-- Premier écran mobile iOS : une décision principale, des options secondaires discrètes. -->
    <ThemeVariantScope x:Name="IosConnectionThemeScope" RequestedThemeVariant="Light" IsVisible="False">
    <Grid x:Name="IosConnectionScreen" IsVisible="False" Background="#F5F7FB">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding !PairingInProgress}">
        <StackPanel Classes="iosconnectbody" MaxWidth="440" HorizontalAlignment="Stretch" Margin="20,24,20,32" Spacing="17">
          <Button Classes="iosconnectsecondary" Command="{Binding Back}" IsVisible="{Binding CanGoBack}"
                  HorizontalAlignment="Left" MinWidth="95">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <mi:MaterialIcon Kind="ChevronLeft" Width="18" Height="18" />
              <TextBlock Text="Retour" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Spacing="12">
            <Border Width="86" Height="86" CornerRadius="27" Background="White"
                    BorderBrush="#D7E3F3" BorderThickness="1"
                    BoxShadow="0 10 25 0 #160F468C" HorizontalAlignment="Center">
              <Image Source="{DynamicResource ScoliaMark}" Width="60" Height="60" />
            </Border>
            <TextBlock Classes="iosconnecttitle" Text="Bienvenue sur SCOLIA" FontSize="26" FontWeight="Bold"
                       TextAlignment="Center" Foreground="{DynamicResource TextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="Retrouvez votre établissement en toute sécurité."
                       Classes="muted" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <Border Classes="iosconnectcard">
            <StackPanel Spacing="13">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                <Border Width="49" Height="49" CornerRadius="16" Background="#DCEAFF" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="QrcodeScan" Width="25" Height="25" Foreground="#1769E6"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="Relier mon appareil" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Un QR code, un appareil reconnu. Aucun réglage réseau compliqué."
                             Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <Border Background="#E8F2FF" CornerRadius="13" Padding="12">
                <TextBlock Text="{Binding ScanHint}" Foreground="#365C8F"
                           FontSize="12" TextWrapping="Wrap" />
              </Border>
              <Button Classes="iosconnectprimary" Command="{Binding ScanCode}"
                      IsEnabled="{Binding NotSearching}" MinHeight="57">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <mi:MaterialIcon Kind="QrcodeScan" Width="21" Height="21" />
                  <TextBlock Text="{Binding ScanLabel}" FontSize="15"
                             FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Expander x:Name="IosQrOptions" Header="Autres méthodes de jumelage" IsExpanded="True">
                <StackPanel Spacing="9">
              <Button Classes="iosconnectsecondary" Command="{Binding ImportQrImage}"
                      IsVisible="{Binding CanImportQrImage}" IsEnabled="{Binding NotSearching}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="ImageSearchOutline" Width="20" Height="20" />
                  <TextBlock Text="Importer une image du QR code" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <StackPanel Spacing="8" IsVisible="{Binding CanPasteCode}">
                <TextBox Classes="iosconnectfield" Text="{Binding Invitation}"
                         PlaceholderText="Code d'invitation" MaxLength="2048"
                         AutomationProperties.Name="Invitation du serveur" />
                <Button Classes="iosconnectsecondary" Command="{Binding JoinInternet}"
                        IsEnabled="{Binding NotSearching}" Content="Valider l'invitation" />
              </StackPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <Expander x:Name="IosNearbyServers" Header="Établissements à proximité" IsExpanded="True" IsVisible="{Binding HasServers}">
            <StackPanel Spacing="8">
            <TextBlock Text="ÉTABLISSEMENTS À PROXIMITÉ" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}" FontSize="11" Margin="8,0,0,0" />
            <Border Classes="iosconnectcard" Padding="6">
              <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="iosconnectsecondary" Command="{Binding Join}" Margin="4,3" Padding="12,9">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                        <Border Width="40" Height="40" CornerRadius="13" Background="#DCEAFF">
                          <mi:MaterialIcon Kind="{Binding Icon}" Foreground="#1769E6"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding School}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12"
                                     TextWrapping="Wrap" MaxLines="2" />
                        </StackPanel>
                        <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18"
                                         Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            </StackPanel>
          </Expander>

          <Border Classes="iosconnectcard">
            <StackPanel Spacing="11">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                <Border Width="41" Height="41" CornerRadius="14" Background="#E1F4E7">
                  <mi:MaterialIcon Kind="Wifi" Width="22" Height="22" Foreground="#197C49"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="Réseau local" FontWeight="SemiBold" />
                  <TextBlock Text="Rechercher le serveur sur le Wi-Fi de l'établissement."
                             Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <Expander x:Name="IosWifiOptions" Header="Actions du réseau local" IsExpanded="True">
                <StackPanel Spacing="9">
              <Button Classes="iosconnectsecondary" Command="{Binding Search}"
                      IsEnabled="{Binding NotSearching}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="Magnify" Width="19" Height="19" />
                  <TextBlock Text="Rechercher un serveur proche" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Expander Header="Saisir une adresse réseau" IsExpanded="False">
                <StackPanel Margin="4,8" Spacing="9">
                  <TextBlock Text="{Binding AddressHint}" Classes="muted"
                             FontSize="12" TextWrapping="Wrap" />
                  <TextBox Classes="iosconnectfield" Text="{Binding Address}"
                           PlaceholderText="192.168.1.10" />
                  <Button Classes="iosconnectsecondary" Command="{Binding ConnectAddress}"
                          IsEnabled="{Binding NotSearching}" Content="Rejoindre cette adresse" />
                </StackPanel>
              </Expander>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <Border Background="#E8F2FF" CornerRadius="13" Padding="12"
                  IsVisible="{Binding Searching}">
            <StackPanel Spacing="8">
              <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" />
              <TextBlock Text="{Binding Message}" Foreground="#365C8F"
                         FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Message}" IsVisible="{Binding !Searching}"
                     Classes="muted" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" />

          <Button Classes="iosconnectsecondary" Command="{Binding UseThisComputer}"
                  IsVisible="{Binding PhoneCanBeServer}" MinHeight="50">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="ServerOutline" Width="20" Height="20" />
              <TextBlock Text="Configurer ce téléphone comme serveur" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Text="Une connexion au serveur principal est nécessaire pour valider les nouveaux accès."
                     Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </ScrollViewer>

      <!-- Vérification après lecture du QR : progression compréhensible, sans demander un mot de passe serveur. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding PairingInProgress}">
        <Grid RowDefinitions="*,Auto,*" MinHeight="540" Margin="20,24">
          <Border Grid.Row="1" Classes="iosconnectcard" MaxWidth="410"
                  HorizontalAlignment="Stretch" Padding="23">
            <StackPanel Spacing="15">
              <Border Width="78" Height="78" CornerRadius="26"
                      Background="#DCEAFF" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="ShieldCheckOutline" Width="39" Height="39"
                                 Foreground="#1769E6" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>
              <TextBlock Text="Vérification sécurisée" FontSize="23" FontWeight="Bold"
                         TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="Nous validons cet appareil et ses autorisations auprès de votre établissement."
                         Classes="muted" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />
              <Border Background="#E8F2FF" CornerRadius="14" Padding="14">
                <StackPanel Spacing="12">
                  <ProgressBar IsIndeterminate="True" Height="5" MinHeight="5"
                               Foreground="#1769E6" />
                  <TextBlock Text="{Binding Message}" Foreground="#284F85" FontWeight="SemiBold"
                             FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <TextBlock Text="La connexion sera ouverte automatiquement après validation."
                         Classes="muted" TextAlignment="Center" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
    </ThemeVariantScope>
  </Grid>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.ConnectionView">
  <Grid Background="{DynamicResource BgBrush}">
    <ScrollViewer>
    <StackPanel MaxWidth="540" Margin="20,24" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
      <Image Source="{DynamicResource ScoliaMark}" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,4" />
      <TextBlock Text="Rejoindre votre établissement" Classes="title" FontSize="{DynamicResource FsDisplay}" HorizontalAlignment="Center" TextAlignment="Center" />
      <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding Searching}" Width="220" Height="3" MinHeight="3" HorizontalAlignment="Center" />

      <!-- Serveurs trouvés : une ligne par établissement, façon réglages macOS -->
      <Border Classes="card" Padding="0" IsVisible="{Binding HasServers}">
        <ItemsControl ItemsSource="{Binding Servers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,14">
                <Border Classes="appicon medium" Background="{DynamicResource ToneBlue}" Margin="0,0,14,0"><mi:MaterialIcon Kind="{Binding Icon}" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding School}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Classes="primary" Content="Rejoindre" Command="{Binding Join}" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,6,0,0">
        <Button Content="Rechercher à nouveau" Command="{Binding Search}" IsEnabled="{Binding NotSearching}" />
        <Button Classes="ghost" Content="Utiliser cet ordinateur comme serveur" Command="{Binding UseThisComputer}" IsVisible="{Binding DesktopCanBeServer}" />
      </StackPanel>

      <!-- Téléphone : sans ordinateur dans l'établissement, il en devient le serveur -->
      <Border Classes="card" IsVisible="{Binding PhoneCanBeServer}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="appicon large" Background="{DynamicResource ToneGreen}" Margin="0,0,14,0" VerticalAlignment="Top"><mi:MaterialIcon Kind="CellphoneLink" /></Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Pas d'ordinateur ? Ce téléphone sera le serveur" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}"
                         Text="L'établissement se configure sur ce téléphone et ses données y sont gardées. Les autres téléphones et ordinateurs le trouvent sur le même Wi-Fi et s'y connectent." />
            </StackPanel>
          </Grid>
          <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap"
                     Text="Première préparation du partage distant (Internet requis) : installez le client Tailscale officiel, puis connectez l'appareil au réseau privé de l'école. Aucun VPN ne démarre sans votre autorisation." />
          <Button Classes="ghost" Content="Installer le relais privé Tailscale" Command="{Binding PrepareTailnet}"
                  IsEnabled="{Binding NotSearching}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="44" />
          <Button Classes="primary" Command="{Binding UseThisComputer}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="44">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="CogOutline" Width="18" Height="18" />
              <TextBlock Text="Configurer l'établissement sur ce téléphone" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Rejoindre à distance" FontWeight="SemiBold" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="Sur un autre Wi-Fi ou un réseau mobile, collez l'invitation privée créée par le secrétariat dans Réseau et activité. Vos comptes restent les mêmes." />
          <TextBox Text="{Binding Invitation}" PlaceholderText="Invitation privée SCOLIA" TextWrapping="Wrap" MaxHeight="104" />
          <Button Classes="primary" Content="Vérifier et rejoindre" Command="{Binding JoinInternet}" IsEnabled="{Binding NotSearching}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Appareils autorisés par Tailscale : aucune découverte UDP distante, jamais d'identifiants VPN dans SCOLIA. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="appicon medium" Background="{DynamicResource ToneTeal}"><mi:MaterialIcon Kind="ShieldLockOutline" /></Border>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="Réseau privé Tailscale" FontWeight="SemiBold" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Installez Tailscale sur chaque appareil, connectez-les au même réseau privé et faites approuver les appareils concernés. SCOLIA conserve ses comptes et ses permissions." />
            </StackPanel>
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Sur le téléphone ou PC principal, laissez SCOLIA en mode serveur. Entrez ci-dessous son IP Tailscale ou son nom MagicDNS complet." />
          <Button Classes="ghost" Content="Installer le relais privé Tailscale" Command="{Binding PrepareTailnet}"
                  IsEnabled="{Binding NotSearching}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <TextBox Text="{Binding TailscaleAddress}" PlaceholderText="100.110.22.33:5080 ou machine.tailnet.ts.net:5080" />
          <Button Classes="primary" Content="Rejoindre par Tailscale" Command="{Binding ConnectTailnet}"
                  IsEnabled="{Binding NotSearching}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap"
                     Text="Tailscale doit rester connecté sur les deux appareils. Le serveur du téléphone utilise une notification Android ; sa disponibilité permanente ne peut pas être garantie si Android arrête l’application." />
        </StackPanel>
      </Border>

      <!-- Adresse saisie : quand le Wi-Fi empêche la recherche automatique -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding AddressTitle}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding AddressHint}" Classes="muted" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding Address}" PlaceholderText="192.168.1.10" />
            <Button Grid.Column="1" Classes="primary" Content="Se connecter" Command="{Binding ConnectAddress}" IsEnabled="{Binding NotSearching}" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" FontSize="{DynamicResource FsSmall}" IsVisible="{Binding DesktopCanBeServer}"
                 Text="Sur l'ordinateur principal, SCOLIA doit être ouvert et partagé : il le propose à la première connexion, ou dans Fichier &gt; Poste et réseau." />
      <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" FontSize="{DynamicResource FsSmall}" IsVisible="{Binding IsPhone}"
                 Text="Le serveur de l'établissement, ordinateur ou téléphone, doit avoir SCOLIA ouvert et être joignable par Wi-Fi ou par la liaison Internet sécurisée." />
    </StackPanel>
    </ScrollViewer>
    <!-- Assistant SCOLIA : étapes vérifiées, sans pourcentage fictif de téléchargement Play Store. -->
    <Grid IsVisible="{Binding Installer.IsOpen}" Background="#CC091326">
      <Border Classes="card" MaxWidth="450" Margin="18" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource SurfaceBrush}" CornerRadius="18">
        <StackPanel Spacing="12">
          <Border Classes="appicon large" Background="{DynamicResource ToneTeal}" HorizontalAlignment="Center">
            <mi:MaterialIcon Kind="ShieldCheckOutline" />
          </Border>
          <TextBlock Text="Installation du réseau privé" FontSize="19" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Installer.Step}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
          <ProgressBar Minimum="0" Maximum="3" Value="{Binding Installer.StepProgress}" Height="7" MinHeight="7" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding Installer.IsWaiting}" Height="3" MinHeight="3" />
          <TextBlock Text="{Binding Installer.Status}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" TextAlignment="Center"
                     Text="Le téléchargement est réalisé par Google Play. Son pourcentage réel apparaît dans le Play Store ; SCOLIA affiche les étapes et vérifie l'installation au retour." />
          <Button Classes="ghost" Content="Ouvrir le magasin officiel" Command="{Binding Installer.OpenStore}" IsVisible="{Binding Installer.NeedsInstallation}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Content="Vérifier l'installation" Command="{Binding Installer.Verify}" IsVisible="{Binding Installer.NeedsInstallation}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Classes="ghost" Content="Configurer Tailscale (première connexion)" Command="{Binding Installer.Configure}" IsVisible="{Binding Installer.IsInstalled}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Classes="primary" Content="Fermer · Revenir au partage" Command="{Binding Installer.Close}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="44" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

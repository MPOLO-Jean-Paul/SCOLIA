<UserControl xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Scolia.Bureau.Controls"
             x:Class="Scolia.Bureau.Views.LmdResultsView">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Promotion" Classes="fieldlabel" />
          <ComboBox Width="260" ItemsSource="{Binding Promotions}" SelectedItem="{Binding Promotion}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Étape" Classes="fieldlabel" />
          <ComboBox Width="220" ItemsSource="{Binding Stages}" SelectedItem="{Binding Stage}" />
        </StackPanel>
      </WrapPanel>
    </Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Rang" Binding="{Binding Rank}" Width="Auto" MinWidth="80" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Matricule" Binding="{Binding Dto.Matricule}" Width="Auto" MinWidth="120" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Dto.FullName}" Width="2*" MinWidth="240" />
        <DataGridTextColumn Header="Semestre 1" Binding="{Binding S1}" Width="Auto" MinWidth="170" />
        <DataGridTextColumn Header="Moyenne" Binding="{Binding Year}" Width="Auto" MinWidth="110" />
        <DataGridTextColumn Header="Crédits" Binding="{Binding Credits}" Width="Auto" MinWidth="100" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Calcul" Binding="{Binding Computed}" Width="Auto" MinWidth="140" />
        <DataGridTemplateColumn Header="Décision" Width="Auto" MinWidth="170">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Classes="status">
                <Ellipse Width="8" Height="8" Fill="{Binding DecisionBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Decision}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn infra:GridPriority.Level="2" Header="UE non acquises" Binding="{Binding Missing}" Width="2*" MinWidth="200" />
      </DataGrid.Columns>
    </DataGrid>
    <c:EmptyState Grid.Row="1" Icon="Gavel" Title="Aucun résultat" Hint="Validez le règlement LMD, construisez la maquette (UE et EC) puis saisissez les notes des EC." IsVisible="{Binding Items.Count, Converter={StaticResource IsEmpty}}" />
  </Grid>
</UserControl>

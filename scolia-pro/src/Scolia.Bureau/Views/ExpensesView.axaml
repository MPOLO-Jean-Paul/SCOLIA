<UserControl xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Scolia.Bureau.Controls"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.ExpensesView">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel Classes="field pagesearch">
          <TextBlock Text="Rechercher" Classes="fieldlabel" />
          <TextBox Classes="search clearButton" Width="240" Text="{Binding Search}" PlaceholderText="Bénéficiaire, description, numéro" AutomationProperties.Name="Recherche" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Du" Classes="fieldlabel" />
          <CalendarDatePicker PlaceholderText="Début" SelectedDateFormat="Short" Width="160" SelectedDate="{Binding From}" AutomationProperties.Name="Date de début" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Au" Classes="fieldlabel" />
          <CalendarDatePicker PlaceholderText="Fin" SelectedDateFormat="Short" Width="160" SelectedDate="{Binding To}" AutomationProperties.Name="Date de fin" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="Catégorie" Classes="fieldlabel" />
          <ComboBox Width="260" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Catégorie de dépense" />
        </StackPanel>
      </WrapPanel>
    </Border>
    <DataGrid Grid.Row="1" AutomationProperties.Name="Journal des dépenses" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn infra:GridPriority.Level="2" Header="N°" Binding="{Binding Number}" Width="Auto" MinWidth="170" />
        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="Auto" MinWidth="120" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Catégorie" Binding="{Binding Category}" Width="Auto" MinWidth="190" />
        <DataGridTextColumn Header="Bénéficiaire" Binding="{Binding Beneficiary}" Width="Auto" MinWidth="220" />
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Description" Binding="{Binding Description}" Width="2*" MinWidth="280" />
        <DataGridTextColumn Header="Montant" Binding="{Binding Amount}" Width="Auto" MinWidth="130" />
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Mode" Binding="{Binding Method}" Width="Auto" MinWidth="120" />
        <DataGridTemplateColumn Header="Statut" Width="Auto" MinWidth="100">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Classes="status">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Enregistré par" Binding="{Binding RecordedBy}" Width="Auto" MinWidth="160" />
      </DataGrid.Columns>
    </DataGrid>
    <c:EmptyState Grid.Row="1" Icon="WalletOutline" Title="Aucune dépense sur ces critères" Hint="Changez la période ou la catégorie, ou ajoutez une nouvelle dépense." IsVisible="{Binding Items.Count, Converter={StaticResource IsEmpty}}" />
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,8,0,0" IsVisible="{Binding HasPages}">
      <TextBlock Text="{Binding PageText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button x:Name="ExpensesPrevious" Grid.Column="1" Classes="toolicon" Command="{Binding PreviousPage}" IsEnabled="{Binding CanPrevious}" AutomationProperties.Name="Page précédente des dépenses" ToolTip.Tip="Page précédente">
        <mi:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" />
      </Button>
      <Button x:Name="ExpensesNext" Grid.Column="2" Classes="toolicon" Command="{Binding NextPage}" IsEnabled="{Binding CanNext}" AutomationProperties.Name="Page suivante des dépenses" ToolTip.Tip="Page suivante">
        <mi:MaterialIcon Kind="ArrowRight" Width="20" Height="20" />
      </Button>
    </Grid>
  </Grid>
</UserControl>

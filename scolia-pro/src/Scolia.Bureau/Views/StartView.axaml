<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure" x:Class="Scolia.Bureau.Views.StartView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="14,16,14,24" MaxWidth="1180" HorizontalAlignment="Stretch">
      <Border x:Name="StartHero" Classes="card" Padding="22">
        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
          <Border Width="58" Height="58" CornerRadius="{DynamicResource RadiusCard}"
                  Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
            <Image Source="{DynamicResource ScoliaMark}" Width="34" Height="34"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="{Binding Greeting}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding School}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Year}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="StartPanels" ColumnDefinitions="3*,2*" ColumnSpacing="12" infra:Adaptive.StackBelow="800">
        <Border Classes="card" Padding="4" VerticalAlignment="Top" IsVisible="{Binding HasRecommended}">
          <StackPanel Spacing="3">
            <TextBlock Text="Outils recommandés" Classes="workspaceheading" />
            <Border Height="1" Background="{DynamicResource LineBrush}" />
            <ItemsControl ItemsSource="{Binding Recommended}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><infra:AdaptiveTiles MinItemWidth="226" MaxColumns="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="workspacerow" Command="{Binding Open}"
                          ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                      <Border Classes="workspaceglyph">
                        <PathIcon Data="{Binding Icon, Converter={x:Static infra:HomeGlyphs.Converter}}" Foreground="{Binding Brush}" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <PathIcon Grid.Column="2" Classes="workspacechevron" Data="{x:Static infra:HomeGlyphs.Chevron}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card" Padding="4" VerticalAlignment="Top">
          <StackPanel Spacing="3">
            <TextBlock Text="Consultés récemment" Classes="workspaceheading" />
            <Border Height="1" Background="{DynamicResource LineBrush}" />
            <TextBlock Text="Aucun outil consulté pendant cette session." Classes="muted"
                       Margin="12,13,12,15" TextWrapping="Wrap" IsVisible="{Binding !HasRecentTools}" />
            <ItemsControl ItemsSource="{Binding RecentTools}" IsVisible="{Binding HasRecentTools}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="workspacerow" Command="{Binding Open}"
                          ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                      <Border Classes="workspaceglyph">
                        <PathIcon Data="{Binding Icon, Converter={x:Static infra:HomeGlyphs.Converter}}" Foreground="{Binding Brush}" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <PathIcon Grid.Column="2" Classes="workspacechevron" Data="{x:Static infra:HomeGlyphs.Chevron}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mi="using:Material.Icons.Avalonia" x:Class="Scolia.Bureau.Views.StartView">
  <UserControl.Styles>
    <Style Selector="Button.launchcard">
      <Setter Property="Width" Value="208" />
      <Setter Property="Padding" Value="11" />
      <Setter Property="Margin" Value="0,0,12,5" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.launchcard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.launchcard:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.launchrecent">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.launchrecent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="28" Margin="18,22,12,26">
      <!-- Un accueil plat : la place est réservée aux outils et aux récents, pas à un grand bandeau. -->
      <Border x:Name="StartHero" Background="Transparent">
        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Greeting}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="9">
            <TextBlock Text="{Binding School}" Classes="muted" />
            <TextBlock Text="·" Classes="muted" />
            <TextBlock Text="{Binding Year}" Classes="muted" />
          </StackPanel>
          <TextBlock Text="Choisissez une opération dans le volet de gauche." Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Power BI : une rangée horizontale de cartes à vignettes, sans duplication des actions de création. -->
      <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="{Binding HasRecommended}">
        <Expander.Header>
          <TextBlock Text="Recommandé" FontSize="19" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
            <Button x:Name="PreviousRecommendation" Classes="toolicon" Click="OnPreviousRecommendation" ToolTip.Tip="Recommandations précédentes" AutomationProperties.Name="Recommandations précédentes" IsEnabled="False">
              <mi:MaterialIcon Kind="ChevronLeft" Width="19" Height="19" />
            </Button>
            <Button x:Name="NextRecommendation" Classes="toolicon" Click="OnNextRecommendation" ToolTip.Tip="Recommandations suivantes" AutomationProperties.Name="Recommandations suivantes" IsEnabled="False">
              <mi:MaterialIcon Kind="ChevronRight" Width="19" Height="19" />
            </Button>
          </StackPanel>
          <ScrollViewer x:Name="RecommendationScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                        ScrollChanged="OnRecommendationScrollChanged">
            <ItemsControl ItemsSource="{Binding Recommended}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="launchcard" Command="{Binding Open}" ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                      <TextBlock Text="Outil de gestion" Classes="muted" FontSize="12" />
                      <Grid Grid.Row="1" Height="112" ClipToBounds="True">
                        <Border Background="{DynamicResource GroupBrush}" />
                        <Border Background="{Binding Brush}" Opacity="0.12" />
                        <Ellipse Width="72" Height="72" Fill="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <mi:MaterialIcon Kind="{Binding Icon}" Width="36" Height="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Grid>
                      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <mi:MaterialIcon Grid.Column="1" Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" />
                      </Grid>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Expander>

      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="History" Width="19" Height="19" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Récents" FontSize="19" FontWeight="SemiBold" />
        </StackPanel>
        <Grid ColumnDefinitions="34,*,130" ColumnSpacing="8" Margin="10,0">
          <mi:MaterialIcon Kind="FileDocumentOutline" Width="17" Height="17" Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Grid.Column="1" Text="Nom" FontWeight="SemiBold" FontSize="12" />
          <TextBlock Grid.Column="2" Text="Emplacement" FontWeight="SemiBold" FontSize="12" />
        </Grid>
        <Border Background="{DynamicResource LineBrush}" Height="1" />
        <TextBlock Text="Les fonctionnalités consultées pendant cette session apparaîtront ici."
                   Classes="muted" Margin="10,8" TextWrapping="Wrap" IsVisible="{Binding !HasRecentTools}" />
        <ItemsControl ItemsSource="{Binding RecentTools}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Button Classes="launchrecent" Command="{Binding Open}" AutomationProperties.Name="{Binding Label}">
                  <Grid ColumnDefinitions="34,*,130" ColumnSpacing="8">
                    <mi:MaterialIcon Kind="{Binding Icon}" Foreground="{Binding Brush}" Width="21" Height="21" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="Espace de travail" Classes="muted" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border Background="{DynamicResource LineBrush}" Height="1" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

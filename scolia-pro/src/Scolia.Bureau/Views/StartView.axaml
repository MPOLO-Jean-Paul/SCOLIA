<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mi="using:Material.Icons.Avalonia" xmlns:infra="using:Scolia.Bureau.Infrastructure" x:Class="Scolia.Bureau.Views.StartView">
  <UserControl.Styles>
    <Style Selector="Button.starttile">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="MinHeight" Value="86" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.starttile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="22" Margin="8,12,8,24" MaxWidth="1100" HorizontalAlignment="Stretch">
      <StackPanel Spacing="6">
        <TextBlock Text="SCOLIA PRO" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Text="{Binding Greeting}" FontWeight="SemiBold" FontSize="26" TextWrapping="Wrap" />
        <TextBlock Text="{Binding School}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="Choisissez une opération pour commencer." Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="10" IsVisible="{Binding HasNewActions}">
        <TextBlock Text="Nouveau" FontSize="18" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding NewActions}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" infra:Adaptive.MinItemWidth="260" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Classes="starttile" Command="{Binding Open}" Margin="0,0,8,8">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <mi:MaterialIcon Kind="{Binding Icon}" Width="30" Height="30" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel Spacing="10">
        <TextBlock Text="Espace de travail" FontSize="18" FontWeight="SemiBold" />
        <Button Classes="starttile" Command="{Binding OpenHome}" x:Name="OpenHomeButton">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <mi:MaterialIcon Kind="HomeOutline" Width="30" Height="30" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
              <TextBlock Text="Accueil" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="Consulter les indicateurs, les encaissements récents et les outils." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" VerticalAlignment="Center" />
          </Grid>
        </Button>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

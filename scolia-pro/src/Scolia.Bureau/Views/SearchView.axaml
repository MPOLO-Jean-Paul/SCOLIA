<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.SearchView">
  <Border Classes="card" infra:Adaptive.FitDialog="True" Width="640" Padding="0" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BoxShadow="0 12 40 0 #33000000">
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" Margin="18,14,14,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding SearchTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Classes="closex" Command="{Binding Close}"><mi:MaterialIcon Kind="Close" /></Button>
      </Grid>
      <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="{Binding Placeholder}"
               Margin="16,10,16,8" Height="40" FontSize="{DynamicResource FsHeading}" CornerRadius="10" />
      <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" MaxHeight="380"
               Background="Transparent" BorderThickness="0" Margin="8,0" x:Name="ResultList">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <!-- Une ligne entière est un bouton : un seul clic sur Windows, un toucher sur Android/iOS. -->
            <Button Classes="ghost" Command="{Binding Open}" HorizontalContentAlignment="Stretch" MinHeight="60"
                    HorizontalAlignment="Stretch" Padding="8,5" ToolTip.Tip="Ouvrir ce résultat">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Border Classes="appicon medium" Background="{Binding Brush}" Margin="0,0,12,0" ToolTip.Tip="{Binding Type}">
                <mi:MaterialIcon Kind="{Binding Icon}" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Classes="muted"><Run Text="{Binding Type, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Subtitle, Mode=OneWay}" /></TextBlock>
              </StackPanel>
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{Binding Message}" Classes="muted" Margin="18,10,18,6" />
      <TextBlock Text="Touchez un résultat pour ouvrir directement la fiche ou le réglage."
                 Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" Margin="18,0,18,16" />
    </StackPanel>
  </Border>
</UserControl>

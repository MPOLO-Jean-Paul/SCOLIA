<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:views="using:Scolia.Bureau.Views"
             x:Class="Scolia.Bureau.Views.SearchView">
  <!-- Recherche de l'ordinateur : la recherche de l'accueil du téléphone, façon Google, dans une fenêtre.
       Même barre, mêmes récentes, mêmes accès rapides, mêmes lignes de résultats. Entrée ouvre le premier résultat. -->
  <Border Classes="dialogsurface" infra:Adaptive.FitDialog="True" Width="680">
    <Grid RowDefinitions="Auto,*">
      <!-- Barre : retour, saisie, effacer, micro -->
      <Border Classes="googlebar">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <Button Classes="baricon" Command="{Binding Close}" AutomationProperties.Name="Fermer la recherche" ToolTip.Tip="Fermer la recherche (Échap)">
            <PathIcon Data="{x:Static infra:AuthGlyphs.Back}" Width="20" Height="20" />
          </Button>
          <TextBox x:Name="QueryBox" AutomationProperties.Name="{Binding Placeholder}" Grid.Column="1" Classes="searchfield" Text="{Binding Query}" PlaceholderText="{Binding Placeholder}"
                   TextInputOptions.ReturnKeyType="Search" />
          <Button Grid.Column="2" Classes="baricon" Command="{Binding ClearQuery}" AutomationProperties.Name="Effacer la recherche" IsVisible="{Binding HasQuery}" ToolTip.Tip="Effacer">
            <PathIcon Data="{x:Static infra:HomeGlyphs.Dismiss}" Width="20" Height="20" />
          </Button>
          <Button x:Name="MicButton" Grid.Column="3" Classes="baricon mic" Classes.listening="{Binding Listening}" Command="{Binding Listen}"
                  IsVisible="{Binding VoiceAvailable}" Focusable="False" ToolTip.Tip="{Binding VoiceTip}">
            <Grid>
                  <mi:MaterialIcon Kind="MicrophoneOutline" IsVisible="{Binding !Listening}" />
                  <mi:MaterialIcon Kind="StopOutline" IsVisible="{Binding Listening}" />
                </Grid>
          </Button>
        </Grid>
      </Border>

      <views:SearchResultsView Grid.Row="1" />
    </Grid>
  </Border>
</UserControl>

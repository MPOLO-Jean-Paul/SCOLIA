<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scolia.Bureau.Views.SearchView">
  <Border Classes="card" Width="640" Padding="0" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BoxShadow="0 12 40 0 #33000000">
    <StackPanel>
      <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Rechercher un apprenant, un reçu, une page…"
               Margin="16,16,16,8" Height="46" FontSize="{DynamicResource FsHeading}" />
      <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" MaxHeight="380"
               Background="Transparent" BorderThickness="0" Margin="8,0" x:Name="ResultList">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*" Margin="4,6">
              <Border Classes="badge" Background="{DynamicResource NeutralSoftBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Type}" Classes="badge" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{Binding Message}" Classes="muted" Margin="18,10,18,16" />
    </StackPanel>
  </Border>
</UserControl>

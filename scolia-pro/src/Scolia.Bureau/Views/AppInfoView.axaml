<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.AppInfoView">
  <!-- Info sur l'application : catalogue du fonctionnement, module par module, avec une recherche. -->
  <UserControl.Styles>
    <Style Selector="Button.modulehead">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.modulehead /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.modulehead:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card" infra:Adaptive.FitDialog="True" Width="760" Padding="0" CornerRadius="16"
          Background="{DynamicResource BgBrush}" BoxShadow="0 12 40 0 #33000000">
    <Grid RowDefinitions="Auto,Auto,*">
      <!-- En-tête -->
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,16,14,8">
        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0">
          <mi:MaterialIcon Kind="BookOpenPageVariantOutline" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="2" Classes="closex" Command="{Binding Close}" VerticalAlignment="Top" ToolTip.Tip="Fermer">
          <mi:MaterialIcon Kind="Close" />
        </Button>
      </Grid>
      <!-- Recherche dans le catalogue -->
      <Border Grid.Row="1" Classes="googlebar pill" Margin="16,4,16,10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <mi:MaterialIcon Kind="Magnify" Width="22" Height="22" Margin="12,0,6,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
          <TextBox x:Name="CatalogQuery" Grid.Column="1" Classes="searchfield" Text="{Binding Query}" PlaceholderText="{Binding Placeholder}" />
          <Button Grid.Column="2" Classes="baricon" Command="{Binding ClearQuery}" IsVisible="{Binding HasQuery}" ToolTip.Tip="Effacer" Width="40" Height="40">
            <mi:MaterialIcon Kind="Close" />
          </Button>
          <Button Grid.Column="3" Classes="baricon mic" Classes.listening="{Binding Listening}" Command="{Binding Listen}"
                  IsVisible="{Binding VoiceAvailable}" ToolTip.Tip="{Binding VoiceTip}" Width="40" Height="40">
            <Grid>
                  <mi:MaterialIcon Kind="Microphone" IsVisible="{Binding !Listening}" />
                  <mi:MaterialIcon Kind="Stop" IsVisible="{Binding Listening}" />
                </Grid>
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" MaxHeight="620" x:Name="CatalogScroll">
        <StackPanel Margin="16,0,16,18" Spacing="10">
          <TextBlock Text="{Binding Totals}" Classes="muted" FontSize="{DynamicResource FsSmall}" Margin="4,0,0,0" />
          <TextBlock Text="Aucune fonction ne correspond à cette recherche." Classes="muted" IsVisible="{Binding IsEmpty}" Margin="4,10" />
          <ItemsControl ItemsSource="{Binding Modules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource GroupBrush}" CornerRadius="20" ClipToBounds="True" Margin="0,0,0,10">
                  <StackPanel>
                    <Button Classes="modulehead" Command="{Binding Toggle}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{Binding Brush}" Margin="0,0,14,0" VerticalAlignment="Top">
                          <mi:MaterialIcon Kind="{Binding Icon}" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <mi:MaterialIcon Grid.Column="2" Kind="{Binding Chevron}" Width="22" Height="22" Margin="8,0,0,0"
                                         Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Entries}" IsVisible="{Binding IsExpanded}" Margin="16,0,16,14">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel Spacing="3">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" Margin="4,4,4,0"
                     Text="Pour les coordonnées de l'éditeur et du développeur, ouvrez « À propos » dans Aide." />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>

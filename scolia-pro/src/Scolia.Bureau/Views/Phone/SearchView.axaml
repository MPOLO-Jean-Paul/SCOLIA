<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.Phone.SearchView">
  <!-- Recherche de l'accueil, façon Google et Play Store : tout l'écran, le champ en haut avec le clavier ouvert,
       le micro pour dicter, les recherches récentes et les accès rapides tant que rien n'est saisi, puis les résultats en lignes.
       C'est le modèle de toutes les recherches de SCOLIA. -->
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource BgBrush}">
    <!-- Barre : retour, saisie, effacer, micro -->
    <Border Classes="googlebar">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button Classes="baricon" Command="{Binding Close}" ToolTip.Tip="Retour">
          <mi:MaterialIcon Kind="ArrowLeft" />
        </Button>
        <TextBox x:Name="QueryBox" Grid.Column="1" Classes="searchfield" Text="{Binding Query}" PlaceholderText="{Binding Placeholder}"
                 TextInputOptions.ReturnKeyType="Search" />
        <Button Grid.Column="2" Classes="baricon" Command="{Binding ClearQuery}" IsVisible="{Binding HasQuery}" ToolTip.Tip="Effacer">
          <mi:MaterialIcon Kind="Close" />
        </Button>
        <Button x:Name="MicButton" Grid.Column="3" Classes="baricon mic" Classes.listening="{Binding Listening}" Command="{Binding Listen}"
                IsVisible="{Binding VoiceAvailable}" ToolTip.Tip="Rechercher à la voix">
          <mi:MaterialIcon Kind="Microphone" />
        </Button>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,0,24">
        <!-- Rien de saisi : recherches récentes et accès rapides -->
        <StackPanel IsVisible="{Binding IsIdle}">
          <StackPanel IsVisible="{Binding HasRecent}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Recherches récentes" Classes="searchsection" />
              <Button Grid.Column="1" Classes="ghost" Content="Effacer" Command="{Binding ClearRecent}" Margin="0,10,12,0" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="searchrow" Command="{Binding Use}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource GroupBrush}" Margin="0,0,18,0">
                        <mi:MaterialIcon Kind="History" Width="22" Height="22" Foreground="{DynamicResource MutedBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <mi:MaterialIcon Grid.Column="2" Kind="ArrowTopLeft" Width="22" Height="22" Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel IsVisible="{Binding HasShortcuts}">
            <TextBlock Text="Accès rapides" Classes="searchsection" />
            <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="12,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="searchtile" Command="{Binding Open}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"
                                 TextWrapping="WrapWithOverflow" MaxLines="2" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Width="38" Height="38" CornerRadius="12" Background="{Binding Brush}" Margin="6,0,0,0">
                        <mi:MaterialIcon Kind="{Binding Icon}" Width="22" Height="22" Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" Margin="20,18,20,0" />
        </StackPanel>

        <!-- Résultats : une ligne par apprenant, reçu ou fonctionnalité -->
        <StackPanel IsVisible="{Binding HasResults}">
          <TextBlock Text="{Binding Message}" Classes="muted" Margin="20,14,20,6" TextWrapping="Wrap" IsVisible="{Binding !IsEmptyResult}" />
          <ItemsControl ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="searchrow" Command="{Binding Open}" MinHeight="72">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="52" Height="52" CornerRadius="14" Background="{Binding Brush}" Margin="0,0,16,0">
                      <mi:MaterialIcon Kind="{Binding Icon}" Width="28" Height="28" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="typepill"><TextBlock Text="{Binding Type}" FontSize="12" FontWeight="Medium" /></Border>
                        <TextBlock Text="{Binding Subtitle}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Rien trouvé -->
          <StackPanel IsVisible="{Binding IsEmptyResult}" HorizontalAlignment="Center" Spacing="10" Margin="28,40,28,0">
            <mi:MaterialIcon Kind="Magnify" Width="40" Height="40" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Aucun résultat" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.Phone.SetupView">
  <UserControl.Styles>
    <!-- Même identité native que la connexion : sections plates, champs tactiles et boutons uniformes. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBox.w11">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="46" /><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="CheckBox TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Button.iossetupprimary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <!-- Réaction douce sans déplacement des contrôles ni animation des données. -->
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{x:Static infra:Motion.Smooth}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.iossetupprimary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" /></Style>
    <Style Selector="Button.iossetupsecondary">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <!-- Réaction douce sans déplacement des contrôles ni animation des données. -->
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{x:Static infra:Motion.Smooth}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.iossetupprimary TextBlock, Button.iossetupsecondary TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <!-- Petits téléphones : marges resserrées, sections intégrées à l’écran. -->
    <Style Selector="Grid.compact StackPanel.iossetupbody"><Setter Property="Margin" Value="10,12,10,10" /></Style>
    <Style Selector="Grid.compact Border.card"><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="0" /></Style>
    <Style Selector="Grid.compact Border.iossetupfooter"><Setter Property="Padding" Value="10,8" /></Style>
    <Style Selector="Border.iossetupbrand"><Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" /></Style>
    <Style Selector="Image.iossetupmark"><Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /></Style>
    <Style Selector="TextBlock.iossetuptitle"><Setter Property="FontSize" Value="19" /></Style>
    <Style Selector="Grid.tiny Border.iossetupfooter"><Setter Property="Padding" Value="8,7" /></Style>
    <Style Selector="Grid.tiny Grid.iossetupheader"><Setter Property="Margin" Value="10,11,10,9" /></Style>
    <Style Selector="Grid.micro Grid.iossetupheader"><Setter Property="Margin" Value="9,7,9,6" /></Style>
    <Style Selector="Grid.tiny Border.iossetupbrand"><Setter Property="Width" Value="38" /><Setter Property="Height" Value="38" /><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="Grid.tiny Image.iossetupmark"><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /></Style>
    <Style Selector="Grid.tiny TextBlock.iossetuptitle"><Setter Property="FontSize" Value="17" /></Style>
    <Style Selector="Grid.micro StackPanel.iossetupbody"><Setter Property="Margin" Value="9,8,9,8" /><Setter Property="Spacing" Value="9" /></Style>
    <Style Selector="StackPanel.field"><Setter Property="Spacing" Value="4" /></Style>
    <Style Selector="StackPanel.field > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
      <Setter Property="FontSize" Value="{DynamicResource FsSmall}" />
    </Style>
    <Style Selector="Button.profileChoice">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MinHeight" Value="76" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.profileChoice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Configuration sur le téléphone : il devient le serveur de l'établissement. Une colonne, au doigt, mêmes étapes que l'ordinateur. -->
  <Grid x:Name="SetupRoot" RowDefinitions="Auto,*,Auto">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#D9E7FF" />
        <GradientStop Offset="0.52" Color="#BAD2FA" />
        <GradientStop Offset="1" Color="#9CBDEE" />
      </LinearGradientBrush>
    </Grid.Background>
    <Border Background="#22FFFFFF" BorderThickness="0">
      <Grid Classes="iossetupheader" ColumnDefinitions="Auto,*" Margin="16,18,16,14">
        <Border Classes="iossetupbrand" CornerRadius="12" Background="Transparent" BorderThickness="0"
                VerticalAlignment="Center">
          <Image Classes="iossetupmark" Source="{DynamicResource ScoliaMark}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="13,0,0,0" Spacing="3">
          <TextBlock Text="{Binding StepLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="iossetuptitle" Text="{Binding StepTitle}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" TextWrapping="Wrap" />
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" MinHeight="5" Margin="0,7,0,0" Foreground="{DynamicResource AccentBrush}" CornerRadius="3" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Classes="iossetupbody" Margin="18,16,18,14" Spacing="16">
        <!-- Étape 1 : identité de l'établissement ; le réseau est configuré ensuite. -->
        <StackPanel IsVisible="{Binding IsChoosingInstitution}" Spacing="10">
          <TextBlock Text="Bienvenue dans SCOLIA Pro" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Choisissez le type de votre établissement. Si une école existe déjà sur un autre poste, rejoignez son serveur." TextWrapping="Wrap" Classes="muted" />
          <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="ItmIm" >
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="ITM / IEM" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Instituts techniques médicaux et d'enseignement médical" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
          <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="Maternelle" >
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="École maternelle" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Enseignement préscolaire" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
          <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="Primaire" >
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="École primaire" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Classes et suivi des élèves" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
          <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="Secondaire" >
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="École secondaire / technique" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Humanités, options et filières techniques" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
          <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="ComplexeScolaire" >
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Complexe scolaire" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Plusieurs cycles dans un même établissement" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
          <Button Classes="profileChoice" Command="{Binding SelectInstitution}" CommandParameter="SuperieurLmd" >
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <mi:MaterialIcon Kind="School" Width="25" Height="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Université / institut supérieur" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Enseignement supérieur et système LMD" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" /></StackPanel>
    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
  </Grid>
</Button>
          <Button Classes="iossetupsecondary" Command="{Binding JoinExisting}" HorizontalAlignment="Stretch"><TextBlock Text="Rejoindre un établissement existant" TextWrapping="Wrap" /></Button>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsStepOne}" Spacing="14">
          <Border Classes="card"><StackPanel Spacing="8">
            <TextBlock Text="{Binding ProfileLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ProfileHint}" Classes="muted" TextWrapping="Wrap" />
            <StackPanel Classes="field"><TextBlock Text="Régime de l'établissement" /><ComboBox ItemsSource="{Binding GovernanceTypes}" SelectedItem="{Binding Governance}" HorizontalAlignment="Stretch" /></StackPanel>
            <TextBlock Text="Public : aucun frais sans base réglementaire vérifiée." Classes="muted" TextWrapping="Wrap" />
          </StackPanel></Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*">
                <Button Command="{Binding PickLogo}" Width="76" Height="76" Padding="0" CornerRadius="14" Background="{DynamicResource Surface2Brush}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                  <Panel>
                    <Image Source="{Binding Logo}" IsVisible="{Binding HasLogo}" Width="64" Height="64" />
                    <mi:MaterialIcon Kind="ImagePlusOutline" Width="26" Height="26" IsVisible="{Binding !HasLogo}" Foreground="{DynamicResource AccentBrush}" />
                  </Panel>
                </Button>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Logo de l'établissement" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding LogoLine}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <StackPanel Classes="field"><TextBlock Text="Nom de l'établissement" /><TextBox Classes="w11" Text="{Binding SchoolName}" PlaceholderText="Nom officiel" /></StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10" infra:Adaptive.StackBelow="300">
                <StackPanel Classes="field"><TextBlock Text="Sigle" /><TextBox Classes="w11" Text="{Binding ShortName}" PlaceholderText="Sigle" /></StackPanel>
                <StackPanel Classes="field" Grid.Column="1"><TextBlock Text="Ville" /><TextBox Classes="w11" Text="{Binding City}" PlaceholderText="Kinshasa" /></StackPanel>
              </Grid>
              <StackPanel Classes="field"><TextBlock Text="Téléphone" /><TextBox Classes="w11" Text="{Binding Phone}" infra:PhoneInput.Digits="True" PlaceholderText="0812345678" /></StackPanel>
              <StackPanel Classes="field"><TextBlock Text="Devise (facultatif)" /><TextBox Classes="w11" Text="{Binding Motto}" PlaceholderText="Savoir, discipline, service" /></StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="Année scolaire et paiements" FontWeight="SemiBold" />
              <StackPanel Classes="field"><TextBlock Text="Dernier jour sans retard" TextWrapping="Wrap" /><ComboBox ItemsSource="{Binding PaymentDeadlineDays}" SelectedItem="{Binding LastOnTimeDay}" HorizontalAlignment="Stretch" /></StackPanel>
              <TextBlock Text="{Binding MonthRangeSummary}" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Classes="field"><TextBlock Text="Année" /><TextBox Classes="w11" Text="{Binding YearLabel}" PlaceholderText="2026-2027" /></StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10" infra:Adaptive.StackBelow="300">
                <StackPanel Classes="field"><TextBlock Text="Premier mois" /><ComboBox ItemsSource="{Binding StartMonths}" SelectedItem="{Binding StartMonth}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Classes="field" Grid.Column="1"><TextBlock Text="Dernier mois" /><ComboBox ItemsSource="{Binding EndMonths}" SelectedItem="{Binding EndMonth}" HorizontalAlignment="Stretch" /></StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding PromotionHeading}" FontWeight="SemiBold" />
                  <TextBlock Text="Le code identifie la classe ou la promotion." Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding AddPromotion}" VerticalAlignment="Center" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="Plus" Width="16" Height="16" /><TextBlock Text="Ajouter" /></StackPanel>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding Promotions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="10" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="90,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <TextBox Classes="w11" Text="{Binding Code}" PlaceholderText="INF1" MaxLength="4" />
                        <TextBox Classes="w11" Grid.Column="1" Text="{Binding Fee}" PlaceholderText="Montant" />
                        <Button Grid.Column="2" Classes="toolicon" Command="{Binding Remove}" VerticalAlignment="Center"><mi:MaterialIcon Kind="Close" Width="16" Height="16" /></Button>
                        <TextBox Classes="w11" Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Name}" PlaceholderText="Désignation" />
                        <!-- Désignations prédites d'après le code : un toucher remplit la ligne -->
                        <ItemsControl Grid.Row="2" Grid.ColumnSpan="3" ItemsSource="{Binding Suggestions}" IsVisible="{Binding HasSuggestions}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Classes="suggestion" Command="{Binding $parent[ItemsControl].DataContext.Pick}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <mi:MaterialIcon Kind="AutoFix" Width="14" Height="14" />
                                  <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox IsChecked="{Binding LoadDemo}" IsVisible="{Binding CanLoadDemo}"><TextBlock Text="Charger des données de démonstration fictives" TextWrapping="Wrap" /></CheckBox>
              <TextBlock Text="{Binding CurrencyLine}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Étape 2 -->
        <StackPanel IsVisible="{Binding IsStepTwo}" Spacing="14">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="appicon medium" Background="{DynamicResource ToneBlue}"><mi:MaterialIcon Kind="ShieldAccountOutline" /></Border>
                <TextBlock Text="Secrétariat" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" Text="Compte administrateur : tout le travail, le paramétrage, les utilisateurs et les sauvegardes." />
              <StackPanel Classes="field"><TextBlock Text="Identifiant" /><TextBox Classes="w11" Text="{Binding AdminUserName}" /></StackPanel>
              <StackPanel Classes="field"><TextBlock Text="Nom de la personne" /><TextBox Classes="w11" Text="{Binding AdminDisplayName}" /></StackPanel>
              <StackPanel Classes="field"><TextBlock Text="Mot de passe" /><TextBox Classes="w11" Text="{Binding AdminPassword}" PasswordChar="•" /></StackPanel>
              <StackPanel Classes="field"><TextBlock Text="Confirmer le mot de passe" /><TextBox Classes="w11" Text="{Binding AdminConfirm}" PasswordChar="•" /></StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="appicon medium" Background="{DynamicResource ToneGreen}"><mi:MaterialIcon Kind="CashRegister" /></Border>
                <TextBlock Grid.Column="1" Text="Comptabilité (facultatif)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding UseComptabilite}" OnContent="" OffContent="" />
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding UseComptabilite}">
                <StackPanel Classes="field"><TextBlock Text="Identifiant" /><TextBox Classes="w11" Text="{Binding ComptabiliteUserName}" /></StackPanel>
                <StackPanel Classes="field"><TextBlock Text="Nom de la personne" /><TextBox Classes="w11" Text="{Binding ComptabiliteDisplayName}" /></StackPanel>
                <StackPanel Classes="field"><TextBlock Text="Mot de passe" /><TextBox Classes="w11" Text="{Binding ComptabilitePassword}" PasswordChar="•" /></StackPanel>
                <StackPanel Classes="field"><TextBlock Text="Confirmer le mot de passe" /><TextBox Classes="w11" Text="{Binding ComptabiliteConfirm}" PasswordChar="•" /></StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ToneRed}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <!-- Boutons toujours visibles, en bas, au pouce : deux colonnes égales, aucun chevauchement sur petit écran. -->
    <Border Grid.Row="2" IsVisible="{Binding CanGoBack}" Classes="iossetupfooter" Background="#26FFFFFF" BorderThickness="0" Padding="16,10">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <Button Classes="iossetupsecondary" Command="{Binding Back}" IsVisible="{Binding CanGoBack}" IsEnabled="{Binding !Busy}">
          <DockPanel>
            <mi:MaterialIcon DockPanel.Dock="Left" Kind="ChevronLeft" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Retour" VerticalAlignment="Center" />
          </DockPanel>
        </Button>
        <Button Classes="iossetupsecondary" Command="{Binding JoinExisting}" IsVisible="{Binding IsChoosingInstitution}">
          <DockPanel>
            <mi:MaterialIcon DockPanel.Dock="Left" Kind="LanConnect" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Rejoindre un serveur" VerticalAlignment="Center" />
          </DockPanel>
        </Button>
        <Button Grid.Column="1" Classes="iossetupprimary" Command="{Binding Next}" IsVisible="{Binding IsStepOne}">
          <DockPanel>
            <mi:MaterialIcon DockPanel.Dock="Right" Kind="ArrowRight" Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="Suivant" VerticalAlignment="Center" />
          </DockPanel>
        </Button>
        <Button Grid.Column="1" Classes="iossetupprimary" Command="{Binding Finish}" IsVisible="{Binding IsStepTwo}" IsEnabled="{Binding !Busy}">
          <DockPanel>
            <mi:MaterialIcon DockPanel.Dock="Left" Kind="CheckCircleOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Terminer" VerticalAlignment="Center" />
          </DockPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>

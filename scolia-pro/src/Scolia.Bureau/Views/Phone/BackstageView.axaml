<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:views="using:Scolia.Bureau.Views"
             x:Class="Scolia.Bureau.Views.Phone.BackstageView">
  <!-- Compte sur le mobile, comme les Réglages : profil, rubriques en lignes, puis la déconnexion -->
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource BgBrush}">
    <Border Classes="phonebar">
      <Grid ColumnDefinitions="Auto,*">
        <Button Classes="phoneicon" Command="{Binding Close}" IsVisible="{Binding ShowList}" ToolTip.Tip="Retour">
          <mi:MaterialIcon Kind="ChevronLeft" />
        </Button>
        <Button Classes="phoneicon" Command="{Binding BackToList}" IsVisible="{Binding ShowDetail}" ToolTip.Tip="Retour">
          <mi:MaterialIcon Kind="ChevronLeft" />
        </Button>
        <TextBlock Grid.Column="1" Text="Mon compte" IsVisible="{Binding ShowList}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
        <TextBlock Grid.Column="1" Text="{Binding DetailTitle}" IsVisible="{Binding ShowDetail}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Panel Margin="12,14,12,24" MaxWidth="720">
        <StackPanel Spacing="14" IsVisible="{Binding ShowList}">
          <!-- Profil -->
          <Border Classes="card">
            <Grid ColumnDefinitions="Auto,*">
              <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0">
                <TextBlock Text="{Binding Initials}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding UserName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Role}" Classes="muted" />
                <TextBlock Text="{Binding School}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Rubriques -->
          <Border Classes="phonegroup">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="phonerow" Command="{Binding $parent[ItemsControl].DataContext.OpenItem}" CommandParameter="{Binding}" IsVisible="{Binding Value, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=infos}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="appicon medium" Background="{Binding Brush}" Margin="0,0,12,0"><mi:MaterialIcon Kind="{Binding Icon}" /></Border>
                      <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                      <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- Informations -->
          <TextBlock Text="Informations" Classes="phonegrouptitle" Margin="14,4,0,-6" />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <StackPanel Spacing="1"><TextBlock Text="Établissement" Classes="phonelabel" /><TextBlock Text="{Binding School}" TextWrapping="Wrap" /></StackPanel>
              <StackPanel Spacing="1"><TextBlock Text="Année courante" Classes="phonelabel" /><TextBlock Text="{Binding Year}" /></StackPanel>
              <StackPanel Spacing="1"><TextBlock Text="Serveur" Classes="phonelabel" /><TextBlock Text="{Binding Server}" TextWrapping="Wrap" /></StackPanel>
              <StackPanel Spacing="1"><TextBlock Text="Application" Classes="phonelabel" /><TextBlock Text="{Binding Version}" /></StackPanel>
              <Button Classes="phonerow" Command="{Binding CheckMobileUpdates}" IsVisible="{Binding CanCheckMobileUpdates}"
                      MinHeight="48" Margin="0,6,0,0" ToolTip.Tip="Contrôler immédiatement la dernière version officielle">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <mi:MaterialIcon Kind="Update" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding MobileUpdateActionLabel}" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>

          <Button Classes="destructive" Command="{Binding Logout}" HorizontalAlignment="Stretch" Height="48" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <mi:MaterialIcon Kind="Logout" Width="18" Height="18" />
              <TextBlock Text="Se déconnecter" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowDetail}">
          <!-- Sécurité du compte : la même page que sur l'ordinateur, façon réglages d'Android 16. -->
          <StackPanel IsVisible="{Binding IsPassword}" Spacing="14">
            <views:SecurityHubView />
          </StackPanel>
          <ContentControl IsVisible="{Binding IsPoste}" Content="{Binding PosteSection}" />
          <!-- Accessible sans être serveur : aucun réglage réseau ni compte administrateur n'est requis. -->
          <StackPanel IsVisible="{Binding IsUpdates}" Spacing="14">
            <Border Classes="phonegroup" Padding="16">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Border Classes="appicon medium" Background="{DynamicResource ToneBlue}">
                    <mi:MaterialIcon Kind="Update" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Mises à jour SCOLIA Pro" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Version}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="SCOLIA cherche automatiquement de nouvelles versions à l'ouverture et périodiquement. Une recherche manuelle vérifie immédiatement la dernière publication officielle, même lorsqu'un téléchargement précédent attend l'installation."
                           TextWrapping="Wrap" Classes="muted" />
                <TextBlock Text="{Binding MobileUpdateStatus}" TextWrapping="Wrap" Classes="muted" />
                <Button Classes="primary" Command="{Binding CheckMobileUpdates}"
                        Content="{Binding MobileUpdateActionLabel}"
                        IsEnabled="{Binding CanCheckMobileUpdates}"
                        MinHeight="50" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <TextBlock Text="Une mise à jour téléchargée est vérifiée puis Android propose son installation. Vos données scolaires sont conservées."
                           TextWrapping="Wrap" Classes="muted" FontSize="{DynamicResource FsSmall}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>

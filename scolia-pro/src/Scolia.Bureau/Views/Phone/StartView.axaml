<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure" x:Class="Scolia.Bureau.Views.Phone.StartView">
  <StackPanel Spacing="14" Margin="0,6,0,16">
    <Border Classes="card" Padding="16">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Width="46" Height="46" CornerRadius="{DynamicResource RadiusCard}"
                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
          <Image Source="{DynamicResource ScoliaMark}" Width="28" Height="28"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{Binding Greeting}" FontWeight="SemiBold" FontSize="23" TextWrapping="Wrap" />
          <TextBlock Text="{Binding School}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Year}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="card" Padding="4">
      <StackPanel Spacing="3">
        <Button Classes="workspacerow" Command="{Binding OpenHome}" x:Name="OpenHomeButton" AutomationProperties.Name="Accueil">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
            <Border Classes="workspaceglyph">
              <PathIcon Data="{x:Static infra:HomeGlyphs.Home}" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Accueil" FontWeight="SemiBold" />
              <TextBlock Text="Indicateurs, encaissements et outils" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <PathIcon Grid.Column="2" Classes="workspacechevron" Data="{x:Static infra:HomeGlyphs.Chevron}" />
          </Grid>
        </Button>
        <ItemsControl ItemsSource="{Binding NewActions}" IsVisible="{Binding HasNewActions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="workspacerow" Command="{Binding Open}" AutomationProperties.Name="{Binding Title}" ToolTip.Tip="{Binding Description}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                  <Border Classes="workspaceglyph">
                    <PathIcon Data="{Binding Icon, Converter={x:Static infra:HomeGlyphs.Converter}}" Foreground="{Binding Brush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <PathIcon Grid.Column="2" Classes="workspacechevron" Data="{x:Static infra:HomeGlyphs.Chevron}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Classes="card" Padding="14" IsVisible="{Binding !HasRecentTools}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border Classes="workspaceglyph" Background="{DynamicResource AccentSoftBrush}">
          <PathIcon Data="{x:Static infra:HomeGlyphs.Calendar}" Foreground="{DynamicResource AccentBrush}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Une session prête à démarrer" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Choisissez une action pour commencer." Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Padding="12,10" CornerRadius="8" Background="{DynamicResource GroupBrush}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
        <Image Source="{DynamicResource ScoliaMark}" Width="24" Height="24" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="SCOLIA Pro" FontWeight="SemiBold" />
          <TextBlock Text="Votre espace de travail" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Scolia.Bureau.Controls"
             x:Class="Scolia.Bureau.Views.Phone.HomeView">
  <!-- Accueil du téléphone, dans le langage de la Configuration (Réglages d'iOS) : un titre, une phrase, puis des
       groupes en capitales faits de lignes arrondies — tuile d'icône, libellé, valeur à droite, chevron. -->
  <UserControl.Styles>
    <!-- Carte d'accueil légèrement surélevée, comme la carte du compte sur iPhone -->
    <Style Selector="Border.welcomecard">
      <Setter Property="BoxShadow" Value="0 4 16 0 #14000000" />
      <Setter Property="Margin" Value="0,4,0,2" />
    </Style>
    <Style Selector="TextBlock.rowvalue">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <!-- Séparateur discret entre deux lignes d'un même groupe, aligné sur le texte comme sur iOS -->
    <Style Selector="Border.rowsep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource LineBrush}" />
      <Setter Property="Margin" Value="54,0,0,0" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ItemsControl.iosgroup ContentPresenter:nth-child(n+2) Border.rowsep">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <StackPanel x:Name="Sections" Spacing="12" Margin="0,0,0,8">
    <!-- Carte d'accueil, comme la carte du compte en tête des Réglages d'iPhone : avatar rond, salutation et
         contexte, puis l'état de la connexion et de la caisse en lignes de réglage dans la même carte. -->
    <Border x:Name="WelcomeCard" Classes="phonegroup welcomecard">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="16,16,16,14">
          <Border Width="58" Height="58" CornerRadius="29" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#3A86F0" />
                <GradientStop Offset="1" Color="#0B4FC4" />
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="21" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Greeting}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
            <TextBlock Text="{Binding AccountContextLine}" Classes="muted" FontSize="{DynamicResource FsSmall}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding DateLine}" Classes="muted" FontSize="{DynamicResource FsSmall}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="16,0,0,0" />
        <!-- Connexion, toujours visible : en ligne, hors ligne ou synchronisation ; un toucher ouvre Réseau. -->
        <Button Classes="settingsentry" Command="{Binding Network}" ToolTip.Tip="{Binding Sync.StatusDetail}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Classes="appicon medium" Background="{Binding Sync.StatusBrush}"><mi:MaterialIcon Kind="{Binding Sync.StatusIcon}" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding Sync.StatusText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Sync.StatusHint}" Classes="muted" FontSize="{DynamicResource FsSmall}"
                         TextWrapping="Wrap" MaxLines="2" />
            </StackPanel>
            <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </Grid>
        </Button>
        <StackPanel IsVisible="{Binding HasCashLine}">
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="54,0,0,0" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="12,10,14,10" MinHeight="32">
            <Border Classes="appicon medium" Background="{Binding CashBrush}"><mi:MaterialIcon Kind="CashRegister" /></Border>
            <TextBlock Grid.Column="1" Text="{Binding CashLine}" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Raccourcis : les outils du rôle, en lignes de réglage -->
    <StackPanel Spacing="5" IsVisible="{Binding !!PhoneTools.Count}">
      <TextBlock Text="RACCOURCIS" Classes="groupcaps" />
      <Border Classes="phonegroup">
        <ItemsControl Classes="iosgroup" ItemsSource="{Binding PhoneTools}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Border Classes="rowsep" />
                <Button Classes="settingsentry quick" Command="{Binding Open}" ToolTip.Tip="{Binding Description}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="appicon medium" Background="{Binding Brush}"><mi:MaterialIcon Kind="{Binding Icon}" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                  </Grid>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>

    <!-- Aperçu du jour : une ligne par indicateur, le chiffre à droite comme une valeur de réglage -->
    <StackPanel Spacing="5" IsVisible="{Binding HasKpis}">
      <TextBlock Text="APERÇU" Classes="groupcaps" />
      <Border Classes="phonegroup">
        <ItemsControl Classes="iosgroup" ItemsSource="{Binding Kpis}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Border Classes="rowsep" />
                <Button Classes="settingsentry" Command="{Binding Open}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <Border Classes="appicon medium" Background="{Binding Brush}"><mi:MaterialIcon Kind="{Binding Icon}" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" Classes="rowvalue" />
                    <mi:MaterialIcon Grid.Column="3" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                  </Grid>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>

    <!-- À faire aujourd'hui -->
    <StackPanel Spacing="5">
      <TextBlock Text="{Binding TasksTitle, Converter={x:Static infra:TextCase.Upper}}" Classes="groupcaps" />
      <Border Classes="phonegroup">
        <StackPanel>
          <ItemsControl Classes="iosgroup" ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Border Classes="rowsep" />
                  <Button Classes="settingsentry" Command="{Binding Open}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Classes="appicon medium" Background="{Binding Brush}"><mi:MaterialIcon Kind="{Binding Icon}" /></Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                      </StackPanel>
                      <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <c:EmptyState Icon="CheckCircleOutline" Title="Rien en attente" Hint="La caisse, l'appel et les rendez-vous du jour sont à jour." IsVisible="{Binding !HasTasks}" Margin="16" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Réseau de l'établissement : l'état, les autres postes, ce qui attend d'être envoyé -->
    <StackPanel Spacing="5">
      <TextBlock Text="RÉSEAU DE L'ÉTABLISSEMENT" Classes="groupcaps" />
      <Border Classes="phonegroup">
        <StackPanel>
          <Button Classes="settingsentry" Command="{Binding Network}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Classes="appicon medium" Background="{Binding Sync.StatusBrush}"><mi:MaterialIcon Kind="LanConnect" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding Sync.StatusText}" />
                <TextBlock Text="{Binding Sync.PeersText}" Classes="muted" FontSize="{DynamicResource FsSmall}" />
              </StackPanel>
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            </Grid>
          </Button>
          <ItemsControl ItemsSource="{Binding Sync.Peers}" IsVisible="{Binding Sync.HasPeers}" Margin="12,0,12,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                  <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Line}" FontSize="{DynamicResource FsSmall}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Doing}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Derniers reçus -->
    <StackPanel Spacing="5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="DERNIERS REÇUS" Classes="groupcaps" />
        <TextBlock Grid.Column="1" Text="{Binding TodayLine}" Classes="muted" FontSize="{DynamicResource FsCaption}" VerticalAlignment="Bottom"
                   Margin="0,0,12,4" IsVisible="{Binding HasTodayLine}" />
      </Grid>
      <Border Classes="phonegroup">
        <StackPanel>
          <ItemsControl Classes="iosgroup" ItemsSource="{Binding Receipts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Border Classes="rowsep" />
                  <Button Classes="settingsentry" Command="{Binding Open}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                      <Border Classes="appicon medium" Background="{DynamicResource TonePurple}"><mi:MaterialIcon Kind="ReceiptTextOutline" /></Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Student}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Date, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Amount}" Classes="rowvalue" />
                      <mi:MaterialIcon Grid.Column="3" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <c:EmptyState Icon="ReceiptTextOutline" Title="Aucun reçu récent" Hint="Les derniers encaissements apparaîtront ici." IsVisible="{Binding !Receipts.Count}" Margin="16" />
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>

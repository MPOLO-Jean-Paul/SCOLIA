<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:c="using:Scolia.Bureau.Controls"
             x:Class="Scolia.Bureau.Views.Phone.HomeView">
  <!-- Accueil Fluent : une surface de travail et non un menu de grandes illustrations.
       Le conteneur PhoneFrame garde l'unique défilement vertical. -->
  <UserControl.Styles>
    <Style Selector="Border.workpanel">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TextBlock.worksection">
      <Setter Property="FontSize" Value="{DynamicResource FsHeading}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.workaction">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,10" />
      <Setter Property="MinHeight" Value="116" />
      <Setter Property="Margin" Value="3,3" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.workrow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,9" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.workaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.workrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.workaction:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.workrow:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel x:Name="Sections" Spacing="16" Margin="0,0,0,12">
    <Border x:Name="WelcomeCard" Classes="workpanel">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="ESPACE DE TRAVAIL" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Greeting}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding HeaderSchoolLine}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DateLine}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
            <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
        <Border Height="1" Background="{DynamicResource LineBrush}" />
        <Button Classes="workrow" Command="{Binding Network}" ToolTip.Tip="{Binding Sync.StatusDetail}" AutomationProperties.Name="{Binding Sync.StatusText}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <mi:MaterialIcon Kind="{Binding Sync.StatusIcon}" Foreground="{Binding Sync.StatusBrush}" Width="21" Height="21" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding Sync.StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Sync.StatusHint}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
            </StackPanel>
            <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasCashLine}">
          <mi:MaterialIcon Kind="CashRegister" Width="20" Height="20" Foreground="{Binding CashBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding CashLine}" TextWrapping="Wrap" />
        </Grid>
      </StackPanel>
    </Border>
    <StackPanel Spacing="7" IsVisible="{Binding !!Tools.Count}">
      <TextBlock Text="Démarrer" Classes="worksection" />
      <ItemsControl x:Name="WelcomeQuickActions" ItemsSource="{Binding QuickActions}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><infra:AdaptiveTiles MaxColumns="2" MinItemWidth="150" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><Button Classes="workaction" Command="{Binding Open}" ToolTip.Tip="{Binding Description}" AutomationProperties.Name="{Binding ShortTitle}">
              <StackPanel Spacing="7">
                <Border Width="36" Height="36" CornerRadius="7" Background="{DynamicResource GroupBrush}" HorizontalAlignment="Left">
                  <mi:MaterialIcon Kind="{Binding Icon}" Width="24" Height="24" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding ShortTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
              </StackPanel>
            </Button></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <StackPanel Spacing="8" IsVisible="{Binding HasKpis}">
      <TextBlock Text="Indicateurs de l'établissement" Classes="worksection" />
      <ItemsControl ItemsSource="{Binding Kpis}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><infra:AdaptiveTiles MaxColumns="2" MinItemWidth="170" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Button Classes="workaction" Command="{Binding Open}" AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding Hint}">
            <StackPanel Spacing="6">
              <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" Foreground="{Binding Brush}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Label}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <Border Classes="workpanel" IsVisible="{Binding OverviewUnavailable}">
      <TextBlock Text="Les indicateurs ne sont pas disponibles pour le moment. Vos outils restent accessibles." Classes="muted" TextWrapping="Wrap" />
    </Border>
    <StackPanel Spacing="8">
      <TextBlock Text="Recommandé pour vous" Classes="worksection" />
      <Border Classes="workpanel" Padding="4">
        <StackPanel Spacing="3">
          <ItemsControl x:Name="FeatureCards" ItemsSource="{Binding MoreTools}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Classes="workrow" Command="{Binding Open}" ToolTip.Tip="{Binding Description}" AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <mi:MaterialIcon Kind="{Binding Icon}" Width="23" Height="23" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                  </StackPanel>
                  <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="workrow" Command="{Binding ShowAllTools}" AutomationProperties.Name="Afficher ou réduire les fonctionnalités">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <mi:MaterialIcon Kind="ViewDashboard" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding AllToolsLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
    <Border Classes="workpanel" IsVisible="{Binding AllToolsVisible}">
      <StackPanel Spacing="10">
        <TextBlock Text="Toutes les fonctionnalités" Classes="worksection" />
        <ItemsControl ItemsSource="{Binding AllToolGroups}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <StackPanel Spacing="4" Margin="0,4,0,8">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Classes="muted" />
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Classes="workrow" Command="{Binding Open}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <StackPanel Spacing="8" IsVisible="{Binding OverviewAvailable}">
      <TextBlock Text="{Binding TasksTitle}" Classes="worksection" />
      <Border Classes="workpanel" Padding="4">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Classes="workrow" Command="{Binding Open}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <mi:MaterialIcon Kind="{Binding Icon}" Width="22" Height="22" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                  </StackPanel>
                  <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <c:EmptyState Icon="CheckCircleOutline" Title="Aucune tâche affichée" Hint="Les tâches connues de la journée apparaissent ici." IsVisible="{Binding !HasTasks}" Margin="8" />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Spacing="8" IsVisible="{Binding OverviewAvailable}">
      <TextBlock Text="Encaissements récents" Classes="worksection" />
      <TextBlock Text="{Binding TodayLine}" IsVisible="{Binding HasTodayLine}" Classes="muted" TextWrapping="Wrap" />
      <Border Classes="workpanel" Padding="4">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Receipts}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Classes="workrow" Command="{Binding Open}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Student}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Number}" Classes="muted" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Date}" Classes="muted" FontSize="{DynamicResource FsCaption}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Amount}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip.Tip="{Binding Amount}" />
                  </StackPanel>
                  <mi:MaterialIcon Grid.Column="1" Kind="ChevronRight" Width="18" Height="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <c:EmptyState Icon="ReceiptTextOutline" Title="Aucun reçu récent" Hint="Les derniers encaissements apparaîtront ici." IsVisible="{Binding !Receipts.Count}" Margin="8" />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Spacing="6" IsVisible="{Binding Sync.HasPeers}">
      <TextBlock Text="Postes de l'établissement" Classes="worksection" />
      <Border Classes="workpanel">
        <ItemsControl ItemsSource="{Binding Sync.Peers}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Grid ColumnDefinitions="Auto,*" Margin="0,4">
              <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Line}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Doing}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.PairingView">
  <!-- Relier un autre appareil : le code QR en grand, blanc, au centre. Dessous, les voies qu'il contient. -->
  <Border Classes="card" infra:Adaptive.FitDialog="True" Width="460" Padding="0" CornerRadius="18" Background="{DynamicResource SurfaceBrush}"
          ClipToBounds="True" BoxShadow="0 12 40 0 #33000000">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,18,24,20" Spacing="14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="appicon medium" Background="{DynamicResource ToneBlue}" Margin="0,0,12,0" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="QrcodeScan" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding School}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Classes="closex" Command="{Binding Close}" VerticalAlignment="Top"><mi:MaterialIcon Kind="Close" /></Button>
        </Grid>

        <!-- Le code : toujours noir sur blanc, même en thème sombre, pour que tout lecteur le lise -->
        <Border Background="White" CornerRadius="16" Padding="14" HorizontalAlignment="Center" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
          <Image x:Name="CodeImage" Source="{Binding Image}" Width="248" Height="248" RenderOptions.BitmapInterpolationMode="None" />
        </Border>
        <TextBlock Text="{Binding Steps}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />

        <Border Background="{DynamicResource OrangeSoftBrush}" CornerRadius="10" Padding="12,10" IsVisible="{Binding NotShared}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <mi:MaterialIcon Kind="LanDisconnect" Width="18" Height="18" Foreground="{DynamicResource ToneOrange}" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                       Text="Le partage avec les autres ordinateurs est fermé. Ouvrez-le dans Poste et réseau pour que ce code fonctionne sur le Wi-Fi." />
          </Grid>
        </Border>

        <Border Classes="phonegroup" IsVisible="{Binding HasRoutes}" Padding="0">
          <ItemsControl ItemsSource="{Binding Routes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" Margin="14,9">
                  <mi:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <TextBlock Text="{Binding Footer}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" TextAlignment="Center" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <Button Grid.Column="1" Command="{Binding Copy}" ToolTip.Tip="Pour un ordinateur sans appareil photo : le code se colle dans « Changer d'ordinateur principal »">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
              <TextBlock Text="Copier le code" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="primary" Content="Terminé" Command="{Binding Close}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>

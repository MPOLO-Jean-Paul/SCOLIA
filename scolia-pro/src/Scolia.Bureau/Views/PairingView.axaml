<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.PairingView">
  <!-- Relier un autre appareil : le code QR en grand, blanc, au centre. Dessous, les voies qu'il contient. -->
  <Border Classes="card" infra:Adaptive.FitDialog="True" Width="460" Padding="0" CornerRadius="18" Background="{DynamicResource SurfaceBrush}"
          ClipToBounds="True" BoxShadow="0 12 40 0 #33000000">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,18,24,20" Spacing="14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="appicon medium" Background="{DynamicResource ToneBlue}" Margin="0,0,12,0" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="QrcodeScan" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding School}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Classes="closex" Command="{Binding Close}" VerticalAlignment="Top"><mi:MaterialIcon Kind="Close" /></Button>
        </Grid>

        <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" TextAlignment="Center" Classes="muted" IsVisible="{Binding Shared}" />
        <!-- Le code n'est affiché qu'une fois l'autorisation temporaire créée par le serveur. -->
        <Border Background="White" CornerRadius="16" Padding="14" HorizontalAlignment="Center" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                IsVisible="{Binding Ready}">
          <Image x:Name="CodeImage" Source="{Binding Image}" Width="314" Height="314" RenderOptions.BitmapInterpolationMode="None" />
        </Border>
        <!-- Compte à rebours : le code disparaît à l'expiration. -->
        <Border Background="{DynamicResource GroupBrush}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" IsVisible="{Binding HasRemaining}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="TimerSandComplete" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RemainingText}" FontWeight="SemiBold" FontSize="{DynamicResource FsSmall}" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Steps}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding Ready}" />

        <!-- Aucune voie ouverte : expliquer et mener directement au réglage, sans code inutilisable. -->
        <Border Background="{DynamicResource OrangeSoftBrush}" CornerRadius="12" Padding="14,12" IsVisible="{Binding NotShared}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <mi:MaterialIcon Kind="LanDisconnect" Width="20" Height="20" Foreground="{DynamicResource ToneOrange}" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Ce serveur n'est pas encore partagé" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}"
                           Text="Aucun autre appareil ne peut le joindre : ni le Wi-Fi de l'établissement ni l'accès par Internet ne sont ouverts. Ouvrez l'un des deux, puis revenez ici." />
              </StackPanel>
            </Grid>
            <Button infra:Icons.Lead="ShareVariantOutline" Classes="primary" Content="Ouvrir les réglages de partage" Command="{Binding OpenSharing}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </Border>

        <Border Classes="phonegroup" IsVisible="{Binding HasRoutes}" Padding="0">
          <ItemsControl ItemsSource="{Binding Routes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" Margin="14,9">
                  <mi:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <TextBlock Text="{Binding Footer}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding Shared}" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <Button infra:Icons.Lead="QrcodePlus" Grid.Column="0" Command="{Binding Renew}" Content="Nouveau code" IsEnabled="{Binding CanInvite}" IsVisible="{Binding Shared}"
                  Classes.primary="{Binding Expired}" />
          <Button Grid.Column="1" Command="{Binding Copy}" IsEnabled="{Binding Ready}" IsVisible="{Binding Shared}" ToolTip.Tip="Code confidentiel à usage unique, à transmettre seulement à l'appareil approuvé">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
              <TextBlock Text="Copier le code" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="primary" Content="Terminé" Command="{Binding Close}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.BackstageView">
  <Grid ColumnDefinitions="280,*" Background="{DynamicResource BgBrush}">
    <!-- Colonne de gauche : retour, rubriques, déconnexion -->
    <Border Grid.Column="0" Classes="sidebar" Padding="16,20">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="8">
          <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding Close}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
              <TextBlock Text="Retour à SCOLIA" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding School}" Classes="heading" Margin="8,16,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding UserName}" Classes="muted" Margin="8,0,0,8" />
        </StackPanel>
        <ListBox Grid.Row="1" Classes="side" ItemsSource="{Binding Items}" SelectedItem="{Binding Section}" Background="Transparent" BorderThickness="0" Margin="0,12,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,6">
                <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2" Classes="destructive" Command="{Binding Logout}" HorizontalAlignment="Stretch" Height="40" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <mi:MaterialIcon Kind="Logout" Width="18" Height="18" />
            <TextBlock Text="Se déconnecter" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Colonne de droite : contenu de la rubrique -->
    <ScrollViewer Grid.Column="1" Padding="40,32">
      <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
        <StackPanel IsVisible="{Binding IsInfos}" Spacing="10">
          <TextBlock Text="Informations" Classes="title" />
          <Border Classes="card">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Établissement" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding School}" /></Grid>
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Utilisateur" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding UserName}" /></Grid>
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Rôle" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Role}" /></Grid>
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Année courante" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Year}" /></Grid>
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Serveur" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Server}" /></Grid>
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Application" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Version}" /></Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <ContentControl IsVisible="{Binding IsPassword}" Content="{Binding PasswordForm}" HorizontalAlignment="Left" />
        <ContentControl IsVisible="{Binding IsPoste}" Content="{Binding PosteSection}" HorizontalAlignment="Stretch" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.BackstageView">
  <Grid ColumnDefinitions="280,*" Background="{DynamicResource BgBrush}" infra:Adaptive.StackBelow="760">
    <!-- Colonne de gauche : retour, rubriques, déconnexion -->
    <Border Grid.Column="0" Classes="sidebar" Padding="12,16" Margin="8">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="8">
          <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding Close}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
              <TextBlock Text="Retour à SCOLIA" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding School}" Classes="heading" Margin="8,16,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding UserName}" Classes="muted" Margin="8,0,0,8" />
        </StackPanel>
        <ListBox Grid.Row="1" Classes="side" ItemsSource="{Binding Items}" SelectedItem="{Binding Section}" Background="Transparent" BorderThickness="0" Margin="0,12,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,6">
                <Border Classes="appicon medium" Background="{Binding Brush}"><mi:MaterialIcon Kind="{Binding Icon}" /></Border>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2" Classes="destructive" Command="{Binding Logout}" HorizontalAlignment="Stretch" Height="40" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <mi:MaterialIcon Kind="Logout" Width="18" Height="18" />
            <TextBlock Text="Se déconnecter" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Colonne de droite : contenu de la rubrique -->
    <ScrollViewer Grid.Column="1" Padding="40,32">
      <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
        <StackPanel IsVisible="{Binding IsInfos}" Spacing="10">
          <TextBlock Text="Informations" Classes="title" />
          <Border Classes="card">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Établissement" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding School}" /></Grid>
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Utilisateur" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding UserName}" /></Grid>
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Rôle" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Role}" /></Grid>
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Année courante" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Year}" /></Grid>
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Serveur" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Server}" /></Grid>
              <Grid ColumnDefinitions="180,*"><TextBlock Text="Application" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Version}" /></Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsPassword}" Spacing="16" MaxWidth="640">
          <Border Classes="card" Padding="20,18">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Background="{DynamicResource AccentSoftBrush}" Width="48" Height="48" CornerRadius="14">
                  <mi:MaterialIcon Kind="ShieldCheckOutline" Width="26" Height="26"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="Sécurité du compte" Classes="heading" />
                  <TextBlock Text="Mot de passe et protection de cet appareil" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
              <TextBlock Text="Ces réglages protègent votre session. Toute activation ou désactivation biométrique exige une vérification."
                         Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="18,16">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <mi:MaterialIcon Kind="LockReset" Width="22" Height="22"
                                 Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="Changer le mot de passe" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
              <ContentControl Content="{Binding PasswordForm}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding ShowBiometricSecurity}" Padding="18,16">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <mi:MaterialIcon Kind="Fingerprint" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding BiometricTitle}" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
              <Border Background="{DynamicResource GroupBrush}" Padding="14,12" CornerRadius="12">
                <TextBlock Text="{Binding BiometricSecurityStatus}" TextWrapping="Wrap" />
              </Border>
              <TextBlock Text="Vérification de votre identité" FontWeight="SemiBold" />
              <TextBox Text="{Binding SecurityPassword}" PasswordChar="•" PlaceholderText="Mot de passe actuel" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding BiometricVerificationHelp}" />
              <Button Classes="primary" Command="{Binding ManageBiometrics}" Content="{Binding BiometricActionLabel}"
                      IsEnabled="{Binding BiometricSecurityAllowed}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" MinHeight="46" />
              <TextBlock Text="{Binding SecurityNotice}" Classes="muted" IsVisible="{Binding HasSecurityNotice}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Button Classes="ghost" Content="Fermer la sécurité" Command="{Binding CloseSecurity}" HorizontalAlignment="Left" />
        </StackPanel>
        <ContentControl IsVisible="{Binding IsPoste}" Content="{Binding PosteSection}" HorizontalAlignment="Stretch" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Scolia.Bureau.ViewModels"
             x:Class="Scolia.Bureau.Views.StudentsView"
             x:DataType="vm:StudentsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,16">
      <StackPanel Spacing="2">
        <TextBlock Text="Apprenants" FontSize="26" />
        <TextBlock Text="{Binding Summary}" Opacity="0.65" />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox PlaceholderText="Nom, post-nom, prénom, matricule ou téléphone…" Text="{Binding Search, Mode=TwoWay}" Height="40" />
        <Button Grid.Column="1" Content="Rechercher" Command="{Binding Reload}" Margin="10,0,0,0" Height="40" Classes="accent" />
      </Grid>
    </StackPanel>

    <!-- En-tête de colonnes puis lignes, sur la même grille -->
    <Border DockPanel.Dock="Top" Padding="12,10" Background="#F0F4F9" CornerRadius="8,8,0,0">
      <Grid ColumnDefinitions="110,*,70,150,120,120,140">
        <TextBlock Text="Matricule" FontWeight="Medium" Opacity="0.75" />
        <TextBlock Grid.Column="1" Text="Nom" FontWeight="Medium" Opacity="0.75" />
        <TextBlock Grid.Column="2" Text="Promo" FontWeight="Medium" Opacity="0.75" />
        <TextBlock Grid.Column="3" Text="Téléphone parent" FontWeight="Medium" Opacity="0.75" />
        <TextBlock Grid.Column="4" Text="Statut" FontWeight="Medium" Opacity="0.75" />
        <TextBlock Grid.Column="5" Text="Solde dû" FontWeight="Medium" Opacity="0.75" TextAlignment="Right" />
        <TextBlock Grid.Column="6" Text="Retard" FontWeight="Medium" Opacity="0.75" TextAlignment="Right" />
      </Grid>
    </Border>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StudentRow">
            <Border Padding="12,9" BorderBrush="#E3E3E3" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="110,*,70,150,120,120,140">
                <TextBlock Text="{Binding Matricule}" FontFamily="Cascadia Mono, Consolas, monospace" Foreground="#0842A0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                <TextBlock Grid.Column="2" Text="{Binding Promotion}" />
                <TextBlock Grid.Column="3" Text="{Binding Phone}" Opacity="0.75" />
                <TextBlock Grid.Column="4" Text="{Binding Status}" />
                <TextBlock Grid.Column="5" Text="{Binding Balance}" TextAlignment="Right" />
                <TextBlock Grid.Column="6" Text="{Binding Overdue}" TextAlignment="Right" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>

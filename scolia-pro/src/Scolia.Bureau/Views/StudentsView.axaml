<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scolia.Bureau.Views.StudentsView">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,10">
      <WrapPanel>
        <TextBox Width="300" Margin="0,0,10,6" Text="{Binding Search}" PlaceholderText="Rechercher un nom ou un matricule" />
        <ComboBox Width="230" Margin="0,0,10,6" ItemsSource="{Binding Promotions}" SelectedItem="{Binding Promotion}" />
        <ComboBox Width="190" Margin="0,0,10,6" ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding Status}" />
        <Button Margin="0,0,6,6" Command="{Binding PreviousPage}" IsEnabled="{Binding CanPrevious}" Content="Précédent" />
        <Button Margin="0,0,10,6" Command="{Binding NextPage}" IsEnabled="{Binding CanNext}" Content="Suivant" />
        <TextBlock Text="{Binding PageText}" Classes="muted" VerticalAlignment="Center" Margin="4,0,0,6" />
      </WrapPanel>
    </Border>
    <DataGrid Grid.Row="1" x:Name="StudentGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="Auto" MinWidth="130" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Sexe" Binding="{Binding Gender}" Width="Auto" MinWidth="110" />
        <DataGridTextColumn Header="Promotion" Binding="{Binding Promotion}" Width="Auto" MinWidth="130" />
        <DataGridTemplateColumn Header="Statut" Width="Auto" MinWidth="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Téléphone" Binding="{Binding Phone}" Width="Auto" MinWidth="160" />
        <DataGridTextColumn Header="Solde" Binding="{Binding Balance}" Width="Auto" MinWidth="150" />
        <DataGridTemplateColumn Header="Retard" Width="Auto" MinWidth="130">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Overdue}" Foreground="{Binding OverdueBrush}" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>

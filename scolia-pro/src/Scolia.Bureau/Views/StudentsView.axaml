<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Scolia.Bureau.Controls"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Scolia.Bureau.Views.StudentsView">
  <UserControl.Styles>
    <Style Selector="Button.studentcard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="88" />
      <Setter Property="Margin" Value="0,0,0,9" />
    </Style>
    <Style Selector="Button.studentcard:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.studentcard:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <!-- Barre de commande WinUI 3 : titre, filtres adaptatifs, navigation sur sa propre ligne.
         Evite que les boutons de pagination recouvrent les champs aux petites largeurs. -->
    <Border Grid.Row="0" Classes="band" Margin="0,0,0,12" Padding="14,12" CornerRadius="{DynamicResource RadiusCard}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" VerticalAlignment="Center">
          <mi:MaterialIcon Kind="AccountGroupOutline" Width="19" Height="19" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
        <WrapPanel IsVisible="{Binding NotPhone}">
          <StackPanel Classes="field pagesearch">
            <TextBlock Text="Rechercher" Classes="fieldlabel" />
            <TextBox Classes="search clearButton" Width="300" Text="{Binding Search}" PlaceholderText="Rechercher un nom ou un code anonyme" AutomationProperties.Name="Rechercher par nom ou code anonyme" />
          </StackPanel>
          <StackPanel Classes="field">
            <TextBlock Text="Promotion" Classes="fieldlabel" />
            <ComboBox Width="230" ItemsSource="{Binding Promotions}" SelectedItem="{Binding Promotion}" AutomationProperties.Name="Filtrer par promotion" />
          </StackPanel>
          <StackPanel Classes="field" IsVisible="{Binding HasSections}">
            <TextBlock Text="Section" Classes="fieldlabel" />
            <ComboBox Width="220" ItemsSource="{Binding Sections}" SelectedItem="{Binding SectionChoice}" AutomationProperties.Name="Filtrer par section" />
          </StackPanel>
          <StackPanel Classes="field">
            <TextBlock Text="Statut" Classes="fieldlabel" />
            <ComboBox Width="190" ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding Status}" AutomationProperties.Name="Filtrer par statut" />
          </StackPanel>
          <StackPanel Classes="field">
            <TextBlock Text="Sexe" Classes="fieldlabel" />
            <ComboBox Width="160" ItemsSource="{Binding GenderChoices}" SelectedItem="{Binding Gender}" AutomationProperties.Name="Filtrer par sexe" />
          </StackPanel>
          <!-- Paiement : en ordre, en retard, jamais payé ou pris en charge ; puis un mois précis si besoin -->
          <StackPanel Classes="field">
            <TextBlock Text="Paiement" Classes="fieldlabel" />
            <ComboBox Width="190" ItemsSource="{Binding PaymentChoices}" SelectedItem="{Binding Payment}" AutomationProperties.Name="Filtrer par paiement" />
          </StackPanel>
          <StackPanel Classes="field" IsVisible="{Binding HasMonthFilter}">
            <TextBlock Text="Mois" Classes="fieldlabel" />
            <ComboBox Width="170" ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" AutomationProperties.Name="Filtrer par mois" />
          </StackPanel>
          <Button Classes="ghost" Command="{Binding ClearFilters}" VerticalAlignment="Bottom" Margin="0,0,12,12"
                  ToolTip.Tip="{Binding ResetFiltersTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="FilterRemoveOutline" Width="18" Height="18" />
              <TextBlock Text="Effacer les filtres" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </WrapPanel>
        <Expander Header="Filtres de la liste" IsVisible="{Binding Phone}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
          <StackPanel Spacing="10" Margin="0,8,0,0">
              <StackPanel Spacing="4">
                <TextBlock Text="Promotion" Classes="fieldlabel" />
                <ComboBox Classes="w11" HorizontalAlignment="Stretch" ItemsSource="{Binding Promotions}" SelectedItem="{Binding Promotion}" AutomationProperties.Name="Filtrer par promotion" />
              </StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding HasSections}">
                <TextBlock Text="Section" Classes="fieldlabel" />
                <ComboBox Classes="w11" HorizontalAlignment="Stretch" ItemsSource="{Binding Sections}" SelectedItem="{Binding SectionChoice}" AutomationProperties.Name="Filtrer par section" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Statut" Classes="fieldlabel" />
                <ComboBox Classes="w11" HorizontalAlignment="Stretch" ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding Status}" AutomationProperties.Name="Filtrer par statut" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Sexe" Classes="fieldlabel" />
                <ComboBox Classes="w11" HorizontalAlignment="Stretch" ItemsSource="{Binding GenderChoices}" SelectedItem="{Binding Gender}" AutomationProperties.Name="Filtrer par sexe" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Paiement" Classes="fieldlabel" />
                <ComboBox Classes="w11" HorizontalAlignment="Stretch" ItemsSource="{Binding PaymentChoices}" SelectedItem="{Binding Payment}" AutomationProperties.Name="Filtrer par paiement" />
              </StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding HasMonthFilter}">
                <TextBlock Text="Mois" Classes="fieldlabel" />
                <ComboBox Classes="w11" HorizontalAlignment="Stretch" ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" AutomationProperties.Name="Filtrer par mois" />
              </StackPanel>
              <Button Classes="ghost" Command="{Binding ClearFilters}" HorizontalAlignment="Stretch" Content="Effacer les filtres" />
          </StackPanel>
        </Expander>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" VerticalAlignment="Center" Margin="0,0,0,2">
          <TextBlock Text="{Binding PageText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Grid.Column="1" Classes="toolicon" Command="{Binding PreviousPage}" IsEnabled="{Binding CanPrevious}" ToolTip.Tip="Page précédente">
            <mi:MaterialIcon Kind="ChevronLeft" Width="20" Height="20" />
          </Button>
          <Button Grid.Column="2" Classes="toolicon" Command="{Binding NextPage}" IsEnabled="{Binding CanNext}" ToolTip.Tip="Page suivante">
            <mi:MaterialIcon Kind="ChevronRight" Width="20" Height="20" />
          </Button>
        </Grid>
      </StackPanel>
    </Border>
    <!-- Android : cartes individuelles au lieu d'un tableau trop large pour un téléphone. -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" IsVisible="{Binding Phone}" Margin="0,0,4,16">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Classes="studentcard" AutomationProperties.Name="{Binding Name}"
                  Command="{Binding $parent[ItemsControl].DataContext.OpenStudentOnPhone}"
                  CommandParameter="{Binding}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="16" />
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Promotion}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Matricule}" Classes="muted" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status}" Classes="muted" FontSize="{DynamicResource FsSmall}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" infra:Adaptive.StackBelow="230">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Solde" Classes="caption" />
                    <TextBlock Text="{Binding Balance}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Retard" Classes="caption" />
                    <TextBlock Text="{Binding Overdue}" Foreground="{Binding OverdueBrush}"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </StackPanel>
              <mi:MaterialIcon Grid.Column="1" Kind="ChevronRight" Foreground="{DynamicResource AccentBrush}"
                               Width="22" Height="22" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <DataGrid Grid.Row="1" x:Name="StudentGrid" AutomationProperties.Name="{Binding Title}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False" IsReadOnly="True" infra:GridPriority.Adaptive="True" IsVisible="{Binding NotPhone}">
      <DataGrid.Columns>
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Matricule" Binding="{Binding Matricule}" Width="Auto" MinWidth="120" />
        <DataGridTextColumn Header="Nom complet" Binding="{Binding Name}" Width="*" MinWidth="210" />
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Sexe" Binding="{Binding Gender}" Width="Auto" MinWidth="100" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Promotion" Binding="{Binding Promotion}" Width="Auto" MinWidth="130" />
        <DataGridTemplateColumn infra:GridPriority.Level="1" Header="Statut" Width="Auto" MinWidth="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Classes="status">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn infra:GridPriority.Level="3" Header="Téléphone" Binding="{Binding Phone}" Width="Auto" MinWidth="160" />
        <DataGridTextColumn infra:GridPriority.Level="2" Header="Solde" Binding="{Binding Balance}" Width="Auto" MinWidth="150" />
        <DataGridTemplateColumn infra:GridPriority.Level="2" Header="Retard" Width="Auto" MinWidth="190">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Overdue}" Foreground="{Binding OverdueBrush}" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <c:EmptyState Grid.Row="1" Icon="AccountSearchOutline" Title="{Binding EmptyTitle}" Hint="{Binding EmptyHint}" IsVisible="{Binding Items.Count, Converter={StaticResource IsEmpty}}" />
  </Grid>
</UserControl>

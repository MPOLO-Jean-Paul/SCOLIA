<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:infra="using:Scolia.Bureau.Infrastructure"
             x:Class="Scolia.Bureau.Views.FormView">
  <UserControl.Styles>
    <Style Selector="Border.sheet"><Setter Property="MinWidth" Value="460" /></Style>
    <!-- Formulaire intégré à une page : largeur adaptative, ni ombre ni en-tête -->
    <Style Selector="Border.sheet.embedded">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
      <Setter Property="Background" Value="{DynamicResource GroupBrush}" />
      <Setter Property="MaxWidth" Value="720" />
    </Style>
    <!-- Sur Android : présentation des configurations, sans minimum desktop ni débordement horizontal. -->
    <Style Selector="LayoutTransformControl.phone Border.sheet">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="BoxShadow" Value="0 6 22 0 #16000000" />
    </Style>
    <Style Selector="LayoutTransformControl.phone Border.sheet Grid.formheader">
      <Setter Property="Margin" Value="16,16,12,0" />
    </Style>
    <Style Selector="LayoutTransformControl.phone Border.sheet ScrollViewer.formscroll">
      <Setter Property="Padding" Value="16,10,12,8" />
    </Style>
    <Style Selector="LayoutTransformControl.phone Border.sheet Panel.formfooter">
      <Setter Property="Margin" Value="16,12,16,16" />
    </Style>
    <Style Selector="LayoutTransformControl.phone Border.sheet Border.formerror">
      <Setter Property="Margin" Value="16,4,16,8" />
    </Style>
    <Style Selector="LayoutTransformControl.phone Border.sheet TextBox.w11, LayoutTransformControl.phone Border.sheet ComboBox.w11, LayoutTransformControl.phone Border.sheet CalendarDatePicker.w11">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="LayoutTransformControl.phone Border.sheet Button.formaction">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="LayoutTransformControl.phone Border.sheet StackPanel.formentry">
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="LayoutTransformControl.phone Border.sheet StackPanel.formgrouphead">
      <Setter Property="Margin" Value="0,14,0,8" />
    </Style>
  </UserControl.Styles>
  <!-- Feuille de dialogue macOS : titre gras, champs, boutons en capsule alignés à droite -->
  <Border Classes="card sheet" infra:Adaptive.FitDialog="True" Classes.embedded="{Binding Embedded}" MaxWidth="620" Padding="0" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True"
          BoxShadow="0 8 32 0 #3D000000">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
      <Grid Classes="formheader" ColumnDefinitions="Auto,*,Auto" Margin="24,22,18,0" IsVisible="{Binding !Embedded}">
        <Border Classes="appicon large" Background="{Binding HeaderBrush}" VerticalAlignment="Top" Margin="0,0,14,0">
          <mi:MaterialIcon Kind="{Binding HeaderIcon}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Subtitle}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasSubtitle}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="closex" Command="{Binding Cancel}" IsEnabled="{Binding !Busy}" Margin="12,0,0,0"><mi:MaterialIcon Kind="Close" /></Button>
      </Grid>

      <!-- Le message et les champs defilent ensemble, le bouton Importer reste fixe sur mobile. -->
      <ScrollViewer Classes="formscroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,12,10,8">
        <StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" Margin="0,0,14,12" />
      <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,14,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Classes="formentry" Spacing="4" Margin="0,0,0,8">
              <StackPanel Classes="formgrouphead" IsVisible="{Binding IsHeader}" Spacing="2" Margin="0,10,0,2">
                <TextBlock Text="{Binding Label}" Classes="heading" />
                <TextBlock Text="{Binding Hint}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Hint, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <CheckBox IsVisible="{Binding IsFlag}" IsChecked="{Binding Flag}" Content="{Binding Label}" />
              <StackPanel IsVisible="{Binding IsInput}" Spacing="4">
                <TextBlock Text="{Binding Caption}" Classes="fieldlabel" />
                <!-- L'aide s'écrit une seule fois, sous le champ : elle reste lisible pendant la saisie. -->
                <TextBox Classes="w11" IsVisible="{Binding IsText}" Text="{Binding Text}" />
                <!-- Propositions de saisie, comme la barre de suggestions du clavier : un toucher remplit le champ. -->
                <ItemsControl ItemsSource="{Binding Suggestions}" IsVisible="{Binding HasSuggestions}" Margin="0,2,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="suggestion" Command="{Binding $parent[ItemsControl].DataContext.PickSuggestion}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <mi:MaterialIcon Kind="AutoFix" Width="14" Height="14" />
                          <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Classes="w11" IsVisible="{Binding IsPhone}" Text="{Binding Text}" infra:PhoneInput.Digits="{Binding IsPhone}" />
                <Panel IsVisible="{Binding IsSecret}">
                  <TextBox Classes="w11" Text="{Binding Text}" PasswordChar="•" RevealPassword="{Binding ShowSecret}"
                           MinHeight="52" Padding="14,8,52,8"
                           TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True" />
                  <Button Classes="quiet" Command="{Binding ToggleSecret}" Width="46" MinHeight="44"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                          ToolTip.Tip="Afficher ou masquer ce champ sensible">
                    <mi:MaterialIcon Kind="{Binding SecretEyeIcon}" Width="20" Height="20"
                                     Foreground="{DynamicResource TextBrush}" />
                  </Button>
                </Panel>
                <TextBox Classes="w11" IsVisible="{Binding IsMultiline}" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" />
                <CalendarDatePicker Classes="w11" PlaceholderText="jj/mm/aaaa" SelectedDateFormat="Short" IsVisible="{Binding IsDay}" SelectedDate="{Binding Day}" HorizontalAlignment="Stretch" />
                <ComboBox Classes="w11" IsVisible="{Binding IsChoice}" ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="{DynamicResource FsSmall}" IsVisible="{Binding HasHint}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Border Classes="formerror" Grid.Row="2" Background="{DynamicResource RedSoftBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="12,8" Margin="24,4,24,8" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" />
      </Border>

      <!-- Actions : Annuler puis le bouton principal, alignés à droite -->
      <Panel Classes="formfooter" Grid.Row="3" Margin="20,12,20,16">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" IsVisible="{Binding CanSubmit}">
          <Button Classes="formaction" Content="{Binding CancelText}" Command="{Binding Cancel}" IsVisible="{Binding ShowCancel}" IsEnabled="{Binding !Busy}" MinWidth="96" />
          <Button Classes="formaction" Content="{Binding SubmitText}" Command="{Binding Submit}" IsEnabled="{Binding !Busy}" MinWidth="96"
                  Classes.primary="{Binding !Danger}" Classes.danger="{Binding Danger}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="{Binding !CanSubmit}">
          <Button Classes="primary formaction" Content="{Binding CancelText}" Command="{Binding Cancel}" MinWidth="96" />
        </StackPanel>
      </Panel>
    </Grid>
  </Border>
</UserControl>

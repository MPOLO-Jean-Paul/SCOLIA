<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scolia.Bureau.Views.FormView">
  <!-- Boîte de dialogue de Windows 11 : titre, champs défilants, bande grise du bas avec les boutons à droite -->
  <Border Classes="card" MinWidth="460" MaxWidth="620" Padding="0" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True"
          BoxShadow="0 8 32 0 #3D000000">
    <StackPanel>
      <StackPanel Spacing="3" Margin="24,20,24,14">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Subtitle}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasSubtitle}" />
      </StackPanel>

      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" Margin="24,16,24,0" />

      <!-- Champs : un contrôle par nature de champ, défilants si la fenêtre est basse -->
      <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" Padding="24,16,10,8">
      <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,14,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="4" Margin="0,0,0,8">
              <CheckBox IsVisible="{Binding IsFlag}" IsChecked="{Binding Flag}" Content="{Binding Label}" />
              <StackPanel IsVisible="{Binding !IsFlag}" Spacing="4">
                <TextBlock Text="{Binding Caption}" Classes="fieldlabel" />
                <TextBox IsVisible="{Binding IsText}" Text="{Binding Text}" PlaceholderText="{Binding Hint}" />
                <TextBox IsVisible="{Binding IsSecret}" Text="{Binding Text}" PasswordChar="•" PlaceholderText="{Binding Hint}" />
                <TextBox IsVisible="{Binding IsMultiline}" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" />
                <CalendarDatePicker PlaceholderText="jj/mm/aaaa" SelectedDateFormat="Short" IsVisible="{Binding IsDay}" SelectedDate="{Binding Day}" HorizontalAlignment="Stretch" />
                <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>

      <Border Background="{DynamicResource RedSoftBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="12,8" Margin="24,4,24,8" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" />
      </Border>

      <!-- Actions : bande grise du bas, bouton principal puis Annuler, comme les boîtes de dialogue de Windows -->
      <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="24,16">
      <Panel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" IsVisible="{Binding CanSubmit}">
        <Button Content="{Binding SubmitText}" Command="{Binding Submit}" IsEnabled="{Binding !Busy}" MinWidth="120"
                Classes.primary="{Binding !Danger}" Classes.danger="{Binding Danger}" />
        <Button Content="{Binding CancelText}" Command="{Binding Cancel}" IsVisible="{Binding ShowCancel}" MinWidth="120" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="{Binding !CanSubmit}">
        <Button Content="{Binding CancelText}" Command="{Binding Cancel}" Classes="primary" MinWidth="120" />
      </StackPanel>
      </Panel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>

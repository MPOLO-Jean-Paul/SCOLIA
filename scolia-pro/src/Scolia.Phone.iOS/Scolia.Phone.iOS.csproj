<Project Sdk="Microsoft.NET.Sdk">
  <!-- SCOLIA Phone : même interface Avalonia que Windows/Android ; iPhone client uniquement. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationTitle>SCOLIA Phone</ApplicationTitle>
    <ApplicationId>com.jpservices.scolia.ios</ApplicationId>
    <ApplicationVersion>145</ApplicationVersion>
    <ApplicationDisplayVersion>1.2.25</ApplicationDisplayVersion>
    <AssemblyName>SCOLIA</AssemblyName>
    <RootNamespace>Scolia.Phone.iOS</RootNamespace>
    <!-- La cible est donnée à chaque compilation : -r ios-arm64 (iPhone, iPad) ou -r iossimulator-arm64.
         Une liste fixe mêlant appareil et simulateur faisait lier la bibliothèque SQLite de l'iPhone dans une
         compilation de simulateur. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PublishTrimmed>true</PublishTrimmed>
    <MtouchLink>None</MtouchLink>
    <!-- Les échanges avec le serveur utilisent la sérialisation JSON par réflexion : elle doit rester active
         même quand la compilation iOS déclare le code « réduit » (PublishTrimmed). -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.iOS" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Svg.Skia" />
    <!-- Relier un appareil : le serveur affiche un code QR, l'autre appareil le lit. -->
    <PackageReference Include="QRCoder" />
    <PackageReference Include="ZXing.Net" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Scolia.Bureau/**/*.cs" Exclude="../Scolia.Bureau/bin/**;../Scolia.Bureau/obj/**;../Scolia.Bureau/Program.cs" Link="Bureau/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Scolia.Transport/*.cs" Link="Transport/%(Filename)%(Extension)" />
    <Compile Include="../Scolia.Infrastructure/Network/LanProtocol.cs" Link="Bureau/Infrastructure/LanProtocol.cs" />
    <AvaloniaXaml Include="../Scolia.Bureau/**/*.axaml" Exclude="../Scolia.Bureau/bin/**;../Scolia.Bureau/obj/**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="../Scolia.Bureau/Assets/**" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
